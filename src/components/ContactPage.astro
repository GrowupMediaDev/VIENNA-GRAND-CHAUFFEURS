---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import PageHero from './PageHero.astro';
import Schema from './Schema.astro';
import { CONTACT } from '../lib/site';
import { getLang, hrefFor, pick } from '../lib/i18n';

const lang = getLang(Astro.url);
const phoneHref = `tel:${CONTACT.phonePrimary.tel}`;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const L = pick(lang,
  {
    title: 'Kontakt – Vienna Grand Chauffeurs Wien buchen',
    desc: 'Kontakt zu Vienna Grand Chauffeurs in Wien: per Telefon, WhatsApp oder E-Mail. Für Buchungen, Firmenkonditionen und individuelle Anfragen rund um die Uhr.',
    eyebrow: 'Kontakt', heroTitle: 'Sprechen Sie mit uns.',
    heroSub: 'Ob Anfrage, Angebot oder spontane Buchung — wir sind rund um die Uhr für Sie erreichbar und antworten schnell und unkompliziert.',
    phone: 'Telefon', email: 'E-Mail', whatsapp: 'WhatsApp', whatsappValue: 'Direkt schreiben', location: 'Standort', locationValue: 'Daponetegasse 7/6, 1030 Wien',
    hoursSm: '365 Tage im Jahr für Sie im Einsatz',
    fName: 'Name', fPhone: 'Telefon', fEmail: 'E-Mail', fService: 'Leistung', fMessage: 'Nachricht',
    phName: 'Ihr Name', phEmail: 'ihre@email.at', phMessage: 'Datum, Uhrzeit, Abhol- und Zieladresse, Personenzahl …',
    consent1: 'Ich habe die', consent2: 'Datenschutzerklärung', consent3: 'gelesen und stimme der Verarbeitung meiner Daten zu.',
    submit: 'Anfrage senden',
    options: ['Allgemeine Anfrage', 'Flughafentransfer Wien', 'Chauffeurservice', 'Chauffeur pro Stunde', 'Limousinenservice Wien', 'Fahrdienst für Diplomaten', 'Privatchauffeur Wien', 'Shuttle-Service Wien', 'Langstreckenfahrten'],
  },
  {
    title: 'Contact – Vienna Grand Chauffeurs in Vienna',
    desc: 'Contact Vienna Grand Chauffeurs: by phone, WhatsApp or email. For bookings, corporate terms and individual requests, available around the clock.',
    eyebrow: 'Contact', heroTitle: 'Talk to us.',
    heroSub: 'Whether an enquiry, a quote or a spontaneous booking — we are available around the clock and respond quickly and easily.',
    phone: 'Phone', email: 'Email', whatsapp: 'WhatsApp', whatsappValue: 'Message us directly', location: 'Location', locationValue: 'Daponetegasse 7/6, 1030 Vienna, Austria',
    hoursSm: 'At your service 365 days a year',
    fName: 'Name', fPhone: 'Phone', fEmail: 'Email', fService: 'Service', fMessage: 'Message',
    phName: 'Your name', phEmail: 'you@email.com', phMessage: 'Date, time, pickup and destination address, number of passengers …',
    consent1: 'I have read the', consent2: 'Privacy Policy', consent3: 'and consent to the processing of my data.',
    submit: 'Send enquiry',
    options: ['General enquiry', 'Airport Transfer Vienna', 'Chauffeur Service', 'Chauffeur by the Hour', 'Limousine Service Vienna', 'Diplomatic Chauffeur Service', 'Private Chauffeur Vienna', 'Shuttle Service Vienna', 'Long-Distance Journeys'],
  });

const T = pick(lang,
  { sending: 'Wird gesendet …', ok: 'Vielen Dank! Wir haben Ihre Anfrage erhalten und melden uns umgehend.', err: 'Es ist ein Fehler aufgetreten. Bitte rufen Sie uns an oder schreiben Sie eine E-Mail.', mailtoOpened: 'Ihr E-Mail-Programm wurde geöffnet. Alternativ erreichen Sie uns telefonisch.', subject: 'Anfrage', general: 'Allgemein', lName: 'Name', lEmail: 'E-Mail', lPhone: 'Telefon', lService: 'Leistung' },
  { sending: 'Sending …', ok: 'Thank you! We have received your enquiry and will get back to you shortly.', err: 'An error occurred. Please call us or send us an email.', mailtoOpened: 'Your email application has opened. Alternatively you can reach us by phone.', subject: 'Enquiry', general: 'General', lName: 'Name', lEmail: 'Email', lPhone: 'Phone', lService: 'Service' });

const datenschutzHref = hrefFor('/datenschutz', lang);
const details = [
  { label: L.phone, value: CONTACT.phonePrimary.display, href: phoneHref, icon: 'M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z' },
  { label: L.email, value: CONTACT.email.display, href: CONTACT.email.mailto, icon: 'M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Zm0 2 8 5 8-5' },
  { label: L.whatsapp, value: L.whatsappValue, href: CONTACT.whatsapp.url, icon: 'M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3Zm0 2a7 7 0 1 1-3.7 12.9l-.3-.2-2.4.6.6-2.3-.2-.3A7 7 0 0 1 12 5Z' },
  { label: L.location, value: L.locationValue, href: null, icon: 'M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z' },
];
const optionValues = ['Allgemeine Anfrage', 'Flughafentransfer', 'Chauffeurservice', 'Chauffeur pro Stunde', 'Limousinenservice', 'Fahrdienst Diplomaten', 'Privatchauffeur', 'Shuttle-Service', 'Langstreckenfahrten'];
---
<Layout title={L.title} description={L.desc}>
  <Fragment slot="head">
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
    <Schema contactPage />
  </Fragment>
  <Nav />
  <main>
    <PageHero eyebrow={L.eyebrow} title={L.heroTitle} sub={L.heroSub} />
    <section class="kontakt">
      <div class="container-x">
        <div class="kontakt__grid">
          <aside class="kontakt__info" data-reveal>
            <ul class="kontakt__list">
              {details.map((d) => (
                <li class="kontakt__item">
                  <span class="kontakt__ic" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={d.icon} /></svg>
                  </span>
                  <span class="kontakt__meta">
                    <span class="kontakt__label">{d.label}</span>
                    {d.href
                      ? <a class="kontakt__value" href={d.href}>{d.value}</a>
                      : <span class="kontakt__value">{d.value}</span>}
                  </span>
                </li>
              ))}
            </ul>
            <div class="kontakt__hours">
              <span class="kontakt__hours-big">24 / 7</span>
              <span class="kontakt__hours-sm">{L.hoursSm}</span>
            </div>
          </aside>

          <div class="kontakt__form" data-reveal style="--reveal-delay:0.1s">
            <form class="kform" data-contact-form action="/api/contact" method="POST" novalidate>
              <div class="kform__grid">
                <label class="kform__field">
                  <span class="kform__label">{L.fName} <em>*</em></span>
                  <input type="text" name="name" required autocomplete="name" placeholder={L.phName} />
                </label>
                <label class="kform__field">
                  <span class="kform__label">{L.fPhone}</span>
                  <input type="tel" name="telefon" autocomplete="tel" placeholder="+43 …" />
                </label>
                <label class="kform__field">
                  <span class="kform__label">{L.fEmail} <em>*</em></span>
                  <input type="email" name="email" required autocomplete="email" placeholder={L.phEmail} />
                </label>
                <label class="kform__field">
                  <span class="kform__label">{L.fService}</span>
                  <select name="leistung">
                    {L.options.map((label, i) => <option value={optionValues[i]}>{label}</option>)}
                  </select>
                </label>
              </div>
              <label class="kform__field">
                <span class="kform__label">{L.fMessage} <em>*</em></span>
                <textarea name="nachricht" required rows="5" placeholder={L.phMessage}></textarea>
              </label>
              <label class="kform__check">
                <input type="checkbox" name="datenschutz" required />
                <span>{L.consent1} <a href={datenschutzHref}>{L.consent2}</a> {L.consent3}</span>
              </label>
              <!-- Honeypot — hidden from users, bots that fill it are silently dropped. -->
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
              <input type="hidden" name="lang" value={lang} />
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>
              <button type="submit" class="kform__submit">{L.submit}</button>
              <p class="kform__status" data-form-status role="status" aria-live="polite"></p>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script define:vars={{ T }}>
  // Submits to the Cloudflare Pages Function at /api/contact (Resend + Turnstile).
  const form = document.querySelector('[data-contact-form]');
  const status = form?.querySelector('[data-form-status]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const btn = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    status.className = 'kform__status';
    status.textContent = T.sending;
    try {
      const res = await fetch('/api/contact', { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.ok) {
        form.reset();
        window.turnstile && window.turnstile.reset();
        status.className = 'kform__status is-ok';
        status.textContent = T.ok;
      } else {
        window.turnstile && window.turnstile.reset();
        status.className = 'kform__status is-err';
        status.textContent = T.err;
      }
    } catch {
      window.turnstile && window.turnstile.reset();
      status.className = 'kform__status is-err';
      status.textContent = T.err;
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .kontakt { background: var(--color-cream); color: #0c0a08; padding-block: clamp(2.5rem, 5vw, 4rem) var(--section-py); }
  .kontakt__head { max-inline-size: 52ch; }
  .kontakt__eyebrow { display: flex; align-items: center; gap: 15px; margin-block-end: 22px; }
  .kontakt__eyebrow span:not(.kontakt__line) { font-family: var(--font-display); font-weight: 600; font-size: 24px; letter-spacing: -1px; text-transform: uppercase; color: #c46a2d; }
  .kontakt__line { inline-size: 60px; block-size: 1.429px; background: #c46a2d; opacity: 0.6; flex: none; }
  .kontakt__title { font-family: var(--font-display); font-weight: 700; font-size: clamp(2.6rem, 6.5vw, 4.75rem); line-height: 0.98; letter-spacing: -0.03em; color: #0c0a08; }
  .kontakt__sub { margin: clamp(1.2rem, 2.5vw, 1.75rem) 0 0; font-size: clamp(1rem, 1.3vw, 1.15rem); line-height: 1.7; color: #0c0a089e; }

  .kontakt__grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(1.5rem, 3.5vw, 3.5rem); align-items: start; }

  .kontakt__info { display: flex; flex-direction: column; gap: clamp(1.5rem, 3vw, 2.25rem); }
  .kontakt__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .kontakt__item { display: flex; align-items: center; gap: 18px; padding-block: 20px; border-block-start: 1px solid rgba(20, 15, 10, 0.12); }
  .kontakt__item:last-child { border-block-end: 1px solid rgba(20, 15, 10, 0.12); }
  .kontakt__ic { flex: none; inline-size: 46px; block-size: 46px; border-radius: 999px; background: rgba(196, 106, 45, 0.1); border: 1px solid rgba(196, 106, 45, 0.28); color: #c46a2d; display: grid; place-items: center; }
  .kontakt__ic svg { inline-size: 20px; block-size: 20px; }
  .kontakt__meta { display: flex; flex-direction: column; gap: 3px; min-inline-size: 0; }
  .kontakt__label { font-size: 12.5px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(12, 10, 8, 0.5); }
  .kontakt__value { font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; color: #0c0a08; text-decoration: none; transition: color 0.3s ease; }
  a.kontakt__value:hover { color: #c46a2d; }

  .kontakt__hours { border-radius: 16px; background: #14100b; color: #fff; padding: clamp(1.4rem, 2.5vw, 1.9rem); display: flex; flex-direction: column; gap: 6px; }
  .kontakt__hours-big { font-family: var(--font-oswald); font-size: clamp(2.2rem, 4vw, 3rem); font-weight: 500; line-height: 1; color: #e9b79a; }
  .kontakt__hours-sm { font-size: 14px; color: rgba(255, 255, 255, 0.72); }

  .kontakt__form { min-inline-size: 0; }
  .kform { background: #fff; border: 1px solid rgba(20, 15, 10, 0.12); border-radius: 20px; padding: clamp(1.5rem, 3vw, 2.5rem); display: flex; flex-direction: column; gap: 18px; box-shadow: 0 24px 60px -40px rgba(0, 0, 0, 0.35); }
  .kform__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .kform__field { display: flex; flex-direction: column; gap: 7px; min-inline-size: 0; }
  .kform__field:has(textarea), .kform__field:has(select) { grid-column: auto; }
  .kform__label { font-size: 12.5px; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(12, 10, 8, 0.6); font-weight: 500; }
  .kform__label em { color: #c46a2d; font-style: normal; }
  .kform input, .kform select, .kform textarea {
    inline-size: 100%; font-family: var(--font-body); font-size: 15px; color: #0c0a08;
    background: var(--color-cream); border: 1px solid rgba(20, 15, 10, 0.16); border-radius: 12px;
    padding: 13px 15px; transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .kform textarea { resize: vertical; min-block-size: 120px; }
  .kform input::placeholder, .kform textarea::placeholder { color: rgba(12, 10, 8, 0.4); }
  .kform input:focus, .kform select:focus, .kform textarea:focus { outline: none; border-color: #c46a2d; box-shadow: 0 0 0 3px rgba(196, 106, 45, 0.14); }
  .kform input:user-invalid, .kform textarea:user-invalid { border-color: #c0492d; }
  .kform__check { display: flex; align-items: flex-start; gap: 11px; font-size: 14px; line-height: 1.5; color: #0c0a08c9; }
  .kform__check input { inline-size: 18px; block-size: 18px; flex: none; margin-block-start: 1px; accent-color: #c46a2d; padding: 0; }
  .kform__check a { color: #c46a2d; text-decoration: underline; text-underline-offset: 2px; }
  .kform__submit { margin-block-start: 4px; align-self: flex-start; padding: 15px 38px; border: 0; border-radius: 999px; background: linear-gradient(90deg, #c46a2d 0%, #e9b79a 100%); color: #1a0e04; font-family: var(--font-body); font-weight: 600; font-size: 15.5px; cursor: pointer; transition: filter 0.3s ease, transform 0.25s ease; }
  .kform__submit:hover { filter: brightness(1.05); transform: translateY(-2px); }
  .kform__submit:disabled { opacity: 0.6; cursor: default; transform: none; }
  .kform__status { margin: 0; font-size: 14.5px; line-height: 1.5; min-block-size: 1px; }
  .kform__status.is-ok { color: #2f7d4f; }
  .kform__status.is-err { color: #c0492d; }

  @media (max-width: 860px) {
    .kontakt__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .kontakt__eyebrow span:not(.kontakt__line) { font-size: 1.05rem; }
    .kontakt__title { font-size: clamp(2.2rem, 11vw, 3rem); }
    .kform__grid { grid-template-columns: 1fr; }
  }
</style>

<style is:global>
  body { background: var(--color-cream); }
</style>
