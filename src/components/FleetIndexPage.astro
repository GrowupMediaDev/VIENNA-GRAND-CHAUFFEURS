---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import CtaBand from './CtaBand.astro';
import Faq from './Faq.astro';
import PageHero from './PageHero.astro';
import { getVehicles } from '../lib/vehicles-data';
import { getLang, hrefFor, pick } from '../lib/i18n';

const lang = getLang(Astro.url);
const vehicles = getVehicles(lang);
const L = pick(lang,
  {
    title: 'Fahrzeuge – Mercedes-Flotte mit Chauffeur Wien', desc: 'Unsere Fahrzeuge in Wien: Mercedes von E-Klasse bis Maybach, V-Klasse, VIP Minibus und 20-Sitzer Sprinter. Für jede Fahrt das passende Modell mit Fahrer.', eyebrow: 'Fahrzeuge', heroTitle: 'Unsere Fahrzeuge', heroSub: 'Von der Business-Limousine bis zum 20-Sitzer Sprinter. Unsere gepflegte Mercedes-Flotte mit persönlichem Chauffeur für jeden Anlass in Wien.', gridAria: 'Alle Fahrzeuge', ourFleet: 'Unsere Flotte', count: `${vehicles.length} Fahrzeuge`,
    seo: {
      eyebrow: 'Fahrzeuge mit Chauffeur',
      title: 'Unsere Mercedes-Flotte mit Chauffeur für Wien und Umgebung',
      paragraphs: [
        'Ein gutes Fahrzeug macht den Unterschied zwischen einer Fahrt und einem Erlebnis. Unsere Fahrzeuge Chauffeur Wien sind ausschließlich gepflegte Mercedes-Modelle, die wir regelmäßig warten und pflegen. Für den Geschäftstermin bringt Sie die E-Klasse oder die repräsentative S-Klasse stilvoll ans Ziel.',
        'Wer das Besondere sucht, wählt den Maybach oder die vollelektrische EQE. Als Mercedes mit Chauffeur Wien bieten wir für Familien und kleinere Gruppen die V-Klasse, für größere Gruppen stehen VIP Minibus und der 20-Sitzer Sprinter bereit. In jedem Wagen steht Wasser bereit, auf Wunsch ein Kindersitz.',
        'Welches Modell auch immer Sie wählen, es kommt mit einem erfahrenen, diskreten Chauffeur, der Wien kennt und vorausschauend fährt.',
        'Unsere Limousine Flotte Wien sehen Sie bei der Buchung mit Fixpreis für Ihr Wunschfahrzeug, gebucht wird direkt über unser Online Buchungssystem, bezahlt bequem per Kreditkarte, Apple Pay oder Google Pay. Für Gruppen, Events oder regelmäßige Fahrten stellen wir Ihnen gern ein individuelles Angebot zusammen, erreichbar per WhatsApp oder E-Mail.',
        'Für Gruppen, Events oder regelmäßige Fahrten stellen wir Ihnen gern ein individuelles Angebot zusammen, erreichbar per WhatsApp oder E-Mail.',
        'So finden Sie schnell das Fahrzeug, das zu Ihrer Fahrt passt, vom einzelnen Gast bis zur großen Gruppe, und buchen es mit wenigen Klicks zum Fixpreis.',
      ],
    },
    faqs: [
      { q: 'Welche Fahrzeuge haben Sie im Angebot?', a: 'Eine Mercedes-Flotte von E-Klasse und S-Klasse über Maybach und EQE bis V-Klasse, Vito, VIP Minibus und 20-Sitzer Sprinter.' },
      { q: 'Wie viele Personen passen maximal in ein Fahrzeug?', a: 'Bis zu 20 Personen im Sprinter. Für kleinere Gruppen bieten V-Klasse und VIP Minibus komfortable Alternativen.' },
      { q: 'Sind alle Fahrzeuge mit Chauffeur?', a: 'Ja. Jedes Fahrzeug kommt mit einem erfahrenen, diskreten Chauffeur. Eine Vermietung ohne Fahrer bieten wir nicht an.' },
      { q: 'Kann ich ein bestimmtes Modell wählen?', a: 'Ja. Bei der Buchung wählen Sie Ihr Wunschfahrzeug und sehen den passenden Fixpreis sofort.' },
      { q: 'Gibt es Kindersitze?', a: 'Ja, auf Wunsch stellen wir Kindersitze bereit. Geben Sie den Wunsch einfach bei der Buchung oder per WhatsApp an.' },
      { q: 'Sind Elektrofahrzeuge verfügbar?', a: 'Ja. Mit der vollelektrischen Mercedes EQE bieten wir eine komfortable und emissionsfreie Option für Ihre Fahrten in Wien.' },
    ],
  },
  {
    title: 'Vehicles – Mercedes Fleet with Chauffeur Vienna', desc: 'Our vehicles in Vienna: Mercedes from E-Class to Maybach, V-Class, VIP minibus and 20-seater Sprinter. The right model with chauffeur for every ride.', eyebrow: 'Fleet', heroTitle: 'Our Vehicles', heroSub: 'From the business limousine to the 20-seater Sprinter. Our well-kept Mercedes fleet with a personal chauffeur for every occasion in Vienna.', gridAria: 'All vehicles', ourFleet: 'Our fleet', count: `${vehicles.length} vehicles`,
    seo: {
      eyebrow: 'Vehicles with Chauffeur',
      title: 'Our Mercedes fleet with chauffeur for Vienna and beyond',
      paragraphs: [
        'A good vehicle makes the difference between a ride and an experience. That is why we rely only on well-kept Mercedes models that we service and clean regularly. For the business meeting the E-Class or the representative S-Class takes you there in style.',
        'Those looking for something special choose the Maybach or the all-electric EQE. For families and smaller groups the V-Class offers plenty of room, and for larger groups the VIP minibus and the 20-seater Sprinter are ready. In every car water is on board for you, and a child seat is available on request.',
        'Whichever model you choose, it comes with an experienced, discreet chauffeur who knows Vienna and drives with foresight. When booking you see the fixed price for your chosen vehicle and book directly through our online booking system, paying conveniently by credit card, Apple Pay or Google Pay.',
        'For groups, events or regular rides we are glad to put together an individual quote, reachable by WhatsApp or email. On the following pages we present each model in detail, with seats, equipment and the occasions it suits best.',
        'For groups, events or regular rides we are glad to put together an individual quote, reachable by WhatsApp or email.',
        'That way you quickly find the vehicle that fits your ride, from a single guest to a large group, and book it in just a few clicks at a fixed price.',
      ],
    },
    faqs: [
      { q: 'Which vehicles do you offer?', a: 'A Mercedes fleet from E-Class and S-Class through Maybach and EQE to V-Class, Vito, VIP minibus and the 20-seater Sprinter.' },
      { q: 'How many people fit in a vehicle at most?', a: 'Up to 20 people in the Sprinter. For smaller groups the V-Class and VIP minibus offer comfortable alternatives.' },
      { q: 'Do all vehicles come with a chauffeur?', a: 'Yes. Every vehicle comes with an experienced, discreet chauffeur. We do not offer rental without a driver.' },
      { q: 'Can I choose a specific model?', a: 'Yes. When booking you select your preferred vehicle and see the matching fixed price at once.' },
      { q: 'Are child seats available?', a: 'Yes, on request we provide child seats. Simply state the wish when booking or by WhatsApp.' },
      { q: 'Are electric vehicles available?', a: 'Yes. With the all-electric Mercedes EQE we offer a comfortable, emission-free option for your rides in Vienna.' },
    ],
  });

// Long-form SEO copy: split the paragraphs into two stacked columns.
const seoParas = L.seo.paragraphs;
const seoHalf = Math.ceil(seoParas.length / 2);
const seoLeft = seoParas.slice(0, seoHalf);
const seoRight = seoParas.slice(seoHalf);
---
<Layout title={L.title} description={L.desc}>
  <Nav />
  <main>
    <PageHero eyebrow={L.eyebrow} title={L.heroTitle} sub={L.heroSub} />

    <!-- ============ FLEET GRID ============ -->
    <section class="flist" aria-label={L.gridAria}>
      <div class="container-x">
        <div class="flist__head" data-reveal>
          <div class="flist__eyebrow"><span class="flist__line" aria-hidden="true"></span><span>{L.ourFleet}</span></div>
          <span class="flist__count">{L.count}</span>
        </div>
        <div class="flist__grid">
          {vehicles.map((v) => (
            <a class="vcard" href={hrefFor(`/fahrzeuge/${v.slug}`, lang)} data-reveal>
              <img class="vcard__img" src={v.img.card} alt={v.heroTitle} loading="lazy" />
              <span class="vcard__badge">{v.cardKlass}</span>
              <div class="vcard__body">
                <h2 class="vcard__name">{v.name}</h2>
                <div class="vcard__foot">
                  <span class="vcard__specs">{v.cardSpecs}</span>
                  <span class="vcard__arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ SEO TEXT ============ -->
    <section class="sseo" aria-labelledby="sseo-title">
      <div class="container-x">
        <div class="sseo__head" data-reveal>
          <div class="sseo__eyebrow"><span class="sseo__line" aria-hidden="true"></span><span>{L.seo.eyebrow}</span></div>
          <h2 class="sseo__title" id="sseo-title">{L.seo.title}</h2>
        </div>
        <div class="sseo__cols" data-reveal style="--reveal-delay:0.08s">
          <div class="sseo__col">{seoLeft.map((p) => <p>{p}</p>)}</div>
          <div class="sseo__col">{seoRight.map((p) => <p>{p}</p>)}</div>
        </div>
      </div>
    </section>

    <Faq faqs={L.faqs} />
    <CtaBand />
  </main>
  <Footer />
</Layout>

<style>
  .flist { background: var(--color-cream); color: #0c0a08; padding-block: clamp(2.5rem, 5vw, 4rem) var(--section-py); }
  .flist__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; margin-block-end: clamp(1.75rem, 3vw, 2.5rem); }
  .flist__eyebrow { display: flex; align-items: center; gap: 15px; }
  .flist__eyebrow span:not(.flist__line) { font-family: var(--font-display); font-weight: 600; font-size: 24px; letter-spacing: -1px; text-transform: uppercase; color: #c46a2d; }
  .flist__line { inline-size: 60px; block-size: 1.429px; background: #c46a2d; opacity: 0.6; flex: none; }
  .flist__count { font-family: var(--font-oswald); font-size: 14px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(12, 10, 8, 0.5); }
  .flist__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: clamp(1rem, 1.6vw, 1.5rem); }

  /* Vehicle card */
  .vcard {
    position: relative; isolation: isolate; display: block; overflow: hidden;
    aspect-ratio: 4 / 5; border-radius: 18px; text-decoration: none;
    background: #14100b; box-shadow: 0 20px 50px -34px rgba(0, 0, 0, 0.55);
  }
  .vcard__img { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
  .vcard:hover .vcard__img { transform: scale(1.06); }
  .vcard::after { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(0, 0, 0, 0.28) 0%, rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0.15) 55%, rgba(13, 7, 3, 0.9) 100%); }

  .vcard__badge {
    position: absolute; z-index: 2; inset-block-start: clamp(1rem, 2vw, 1.35rem); inset-inline-start: clamp(1rem, 2vw, 1.35rem);
    display: inline-flex; align-items: center; padding: 8px 15px; border-radius: 999px;
    background: rgba(20, 15, 10, 0.42); border: 1px solid rgba(255, 255, 255, 0.24);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    font-family: var(--font-oswald); font-size: 11.5px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: #f6e4d6;
  }

  .vcard__body { position: absolute; inset-inline: 0; inset-block-end: 0; z-index: 2; padding: clamp(1.4rem, 2.5vw, 2rem); color: #fff; }
  .vcard__name { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.7rem, 2.8vw, 2.35rem); line-height: 1.02; letter-spacing: -0.02em; color: #fff; }
  .vcard__foot { display: flex; align-items: flex-end; justify-content: space-between; gap: 14px; margin-block-start: 10px; }
  .vcard__specs { font-size: 13px; line-height: 1.45; color: rgba(255, 255, 255, 0.74); max-inline-size: 26ch; }
  .vcard__arrow { flex: none; inline-size: 42px; block-size: 42px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.35); display: grid; place-items: center; color: #fff; transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease; }
  .vcard__arrow svg { inline-size: 18px; block-size: 18px; }
  .vcard:hover .vcard__arrow { background: var(--color-terracotta); border-color: var(--color-terracotta); transform: translate(2px, -2px); }

  @media (max-width: 640px) {
    .flist__eyebrow span:not(.flist__line) { font-size: 1.05rem; }
    .vcard { aspect-ratio: 5 / 5; }
  }

  /* ============ SEO TEXT ============ */
  .sseo { background: var(--color-cream); color: #0c0a08; padding-block: 0 var(--section-py); }
  .sseo__head { max-inline-size: 55%; }
  .sseo__eyebrow { display: flex; align-items: center; gap: 15px; margin-block-end: 20px; }
  .sseo__eyebrow span:not(.sseo__line) { font-family: var(--font-display); font-weight: 600; font-size: 24px; letter-spacing: -1px; text-transform: uppercase; color: #c46a2d; }
  .sseo__line { inline-size: 60px; block-size: 1.429px; background: #c46a2d; opacity: 0.6; flex: none; }
  .sseo__title { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.9rem, 3.2vw, 2.9rem); line-height: 1.12; letter-spacing: -0.02em; color: #0c0a08; }
  .sseo__cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 4vw, 65px); margin-block-start: clamp(2rem, 3.5vw, 3.5rem); padding-block-start: clamp(2rem, 3vw, 3.5rem); border-block-start: 1px solid rgba(0, 0, 0, 0.12); }
  .sseo__col { display: flex; flex-direction: column; gap: clamp(1rem, 1.5vw, 1.4rem); }
  .sseo__col p { margin: 0; font-size: 16px; line-height: 1.75; color: #0c0a089e; }

  @media (max-width: 900px) {
    .sseo__head { max-inline-size: 100%; }
    .sseo__cols { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  @media (max-width: 640px) {
    .sseo__eyebrow span:not(.sseo__line) { font-size: 1.05rem; }
    .sseo__title { font-size: 2rem; }
  }
</style>

<style is:global>
  body { background: var(--color-cream); }
</style>
