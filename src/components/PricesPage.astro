---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import CtaBand from './CtaBand.astro';
import Faq from './Faq.astro';
import PageHero from './PageHero.astro';
import { getVehicles } from '../lib/vehicles-data';
import { getLang, hrefFor, pick } from '../lib/i18n';

const lang = getLang(Astro.url);
const vehicles = getVehicles(lang);
const bookHref = hrefFor('/online-buchung', lang);
const L = pick(lang,
  { title: 'Preise Chauffeur Wien – Fixpreise transparent', desc: 'Preise für Chauffeur und Limousine in Wien: transparente Fixpreise, vorab sichtbar, ohne versteckte Kosten. Online buchen und sofort bezahlen.', eyebrow: 'Preise', heroTitle: 'Preise', heroSub: 'Transparente Fixpreise für Chauffeur und Limousine in Wien. Den Preis sehen Sie schon vor der Buchung, ganz ohne versteckte Kosten oder Zuschläge.', aria: 'Preisübersicht', view: 'Fahrzeug ansehen', note: 'Alle Preise verstehen sich als Richtwerte für Fahrten in Wien und Umgebung. Für Langstrecken, Sonderwünsche und individuelle Angebote kontaktieren Sie uns gerne — Sie erhalten umgehend einen verbindlichen Fixpreis.', included: ['Wartezeit inklusive', 'Maut & Parkgebühren inklusive', 'Fixpreis bei Buchung garantiert', 'Alle Preise inkl. USt.'], hourlyNote: 'Inkl. max. 20 km pro Stunde.', longDistance: 'Für Langstrecken einfach Strecke im Buchungssystem eingeben und den Preis sofort sehen.', book: 'Jetzt buchen',
    seo: {
      eyebrow: 'Preise Chauffeur Wien',
      title: 'Transparente Preise für Ihren Chauffeur und Ihre Limousine in Wien',
      paragraphs: [
        'Gute Mobilität sollte planbar sein, auch beim Preis. Deshalb sind unsere Preise Chauffeur Wien klar und fix statt Taxameter oder Zuschläge im Kleingedruckten.',
        'Sie wählen Ihr Fahrzeug und Ihre Strecke oder Dauer und sehen sofort, was die Fahrt kostet. Dieser Preis gilt als Festpreis Chauffeur Wien, inklusive Fahrer, Fahrzeug und aller Nebenkosten. Ob Flughafentransfer zum Festpreis, Limousine für einen Anlass, Chauffeur pro Stunde oder Langstreckenfahrt ins Ausland: Sie kennen die Zahl, bevor Sie buchen, und müssen am Ende nichts nachrechnen.',
        'Booking und Bezahlung sind ebenso einfach. Auch unsere Limousine Preise Wien sehen Sie vorab: Sie buchen direkt über unser Online Buchungssystem, sehen den Fixpreis und zahlen bequem per Kreditkarte, Apple Pay oder Google Pay.',
        'Die Bestätigung kommt sofort, ganz ohne Warten auf ein Angebot. Für Unternehmen mit regelmäßigem Bedarf richten wir feste Firmenkonditionen ein, die Abrechnung und Planung erleichtern.',
        'Geschäftskunden profitieren zusätzlich von planbaren Abläufen und einer klaren, nachvollziehbaren Abrechnung.',
        'So bleibt der Preis das, was er sein sollte: klar, fair und von Anfang an nachvollziehbar, ganz ohne Kleingedrucktes.',
      ],
    },
    faqs: [
      { q: 'Wie setzen sich die Preise zusammen?', a: 'Der Fixpreis richtet sich nach Fahrzeugklasse, Strecke oder Dauer. Fahrer, Fahrzeug und alle Nebenkosten sind bereits enthalten.' },
      { q: 'Gibt es versteckte Kosten oder Zuschläge?', a: 'Nein. Der Preis, den Sie vor der Buchung sehen, ist der Preis, den Sie zahlen. Keine Wartekosten und keine Überraschungen.' },
      { q: 'Wie kann ich bezahlen?', a: 'Bequem online per Kreditkarte, Apple Pay oder Google Pay. Die Bestätigung Ihrer Buchung erhalten Sie sofort.' },
      { q: 'Gibt es Konditionen für Firmen?', a: 'Ja. Für Geschäftskunden mit regelmäßigem Bedarf richten wir feste Firmenkonditionen mit vereinfachter Abrechnung ein.' },
      { q: 'Wie bekomme ich einen Preis für eine Sonderfahrt?', a: 'Für individuelle Routen, mehrere Stopps oder Gruppen erstellen wir ein persönliches Angebot. Erreichen Sie uns per WhatsApp oder E-Mail.' },
      { q: 'Ist der Preis pro Fahrt oder pro Person?', a: 'Der Fixpreis gilt für das gebuchte Fahrzeug, nicht pro Person. So teilen sich mehrere Fahrgäste einen transparenten Gesamtpreis.' },
    ],
  },
  { title: 'Prices Chauffeur Vienna – Transparent Fixed Rates', desc: 'Prices for chauffeur and limousine in Vienna: transparent fixed rates, shown before booking, with no hidden costs. Book online and pay right away.', eyebrow: 'Rates', heroTitle: 'Prices', heroSub: 'Transparent fixed prices for chauffeur and limousine in Vienna. You see the price before booking, with no hidden costs and no surcharges.', aria: 'Price overview', view: 'View vehicle', note: 'All prices are guide values for journeys in Vienna and the surrounding area. For long-distance travel, special requests and individual offers, please contact us — you will receive a binding fixed price straight away.', included: ['Waiting time included', 'Tolls & parking included', 'Fixed price guaranteed at booking', 'All prices incl. VAT'], hourlyNote: 'Incl. max. 20 km per hour.', longDistance: 'For long-distance journeys, simply enter your route in our booking system and see the price right away.', book: 'Book now',
    seo: {
      eyebrow: 'Prices Chauffeur',
      title: 'Transparent prices for your chauffeur and limousine in Vienna',
      paragraphs: [
        'Good mobility should be predictable, including the price. That is why we work with clear fixed prices instead of a taxi meter or surcharges hidden in the small print.',
        'This price is a fixed price chauffeur Vienna clients can count on, including driver, vehicle and all extras. Our limousine prices Vienna wide follow the same clear logic, whether an airport transfer, an event or a long-distance drive.',
        'Booking and payment are just as simple. You book directly through our online booking system, see the fixed price and pay conveniently by credit card, Apple Pay or Google Pay. Confirmation is immediate, with no waiting for a quote. For companies with regular needs we set up fixed corporate terms that make billing and planning easier.',
        'If you have a special wish, such as several stops, an unusual route or a group transfer, we prepare an individual quote for you, reachable by WhatsApp or email.',
        'Business clients also benefit from predictable processes and clear, easy billing.',
        'That way the price stays what it should be: clear, fair and easy to follow from the very start, with no hidden costs.',
      ],
    },
    faqs: [
      { q: 'How are the prices calculated?', a: 'The fixed price depends on vehicle class, route or duration. Driver, vehicle and all extras are already included.' },
      { q: 'Are there hidden costs or surcharges?', a: 'No. The price you see before booking is the price you pay. No waiting costs and no surprises.' },
      { q: 'How can I pay?', a: 'Conveniently online by credit card, Apple Pay or Google Pay. Your confirmation arrives immediately.' },
      { q: 'Are there terms for companies?', a: 'Yes. For business clients with regular needs we set up fixed corporate terms with simplified billing.' },
      { q: 'How do I get a price for a special ride?', a: 'For individual routes, several stops or groups we prepare a personal quote. Reach us by WhatsApp or email.' },
      { q: 'Is the price per ride or per person?', a: 'The fixed price applies to the booked vehicle, not per person. Several passengers share one transparent total price.' },
    ],
  });

const seoParas = L.seo.paragraphs;
const seoHalf = Math.ceil(seoParas.length / 2);
const seoLeft = seoParas.slice(0, seoHalf);
const seoRight = seoParas.slice(seoHalf);
---
<Layout title={L.title} description={L.desc}>
  <Nav />
  <main>
    <PageHero eyebrow={L.eyebrow} title={L.heroTitle} sub={L.heroSub} />

    <!-- ============ PRICE OVERVIEW ============ -->
    <section class="prices" aria-label={L.aria}>
      <div class="container-x">
        <ul class="prices__incl" data-reveal>
          {L.included.map((i) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
              <span>{i}</span>
            </li>
          ))}
        </ul>

        <div class="prices__grid">
          {vehicles.map((v) => (
            <article class="pcard" data-reveal>
              <div class="pcard__media">
                <img src={v.img.card} alt={v.heroTitle} loading="lazy" />
                <span class="pcard__klass">{v.cardKlass}</span>
                <h2 class="pcard__name">{v.name}</h2>
              </div>
              <div class="pcard__body">
                <ul class="pcard__rows">
                  {v.vprice.cards.map((c) => (
                    <li class="pcard__row">
                      <span class="pcard__type">
                        {c.title}
                        {(c.unit === '/ Stunde' || c.unit === '/ hour') && <span class="pcard__hint">{L.hourlyNote}</span>}
                      </span>
                      <span class="pcard__price"><strong>{c.price}</strong> <span class="pcard__unit">{c.unit}</span></span>
                    </li>
                  ))}
                </ul>
                <a class="pcard__link" href={hrefFor(`/fahrzeuge/${v.slug}`, lang)}>
                  {L.view}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>

        <p class="prices__note" data-reveal>{L.note}</p>

        <div class="prices__long" data-reveal>
          <p class="prices__long-text">{L.longDistance}</p>
          <a class="prices__long-cta" href={bookHref}>{L.book}</a>
        </div>
      </div>
    </section>

    <!-- ============ SEO TEXT ============ -->
    <section class="sseo" aria-labelledby="sseo-title">
      <div class="container-x">
        <div class="sseo__head" data-reveal>
          <div class="sseo__eyebrow"><span class="sseo__line" aria-hidden="true"></span><span>{L.seo.eyebrow}</span></div>
          <h2 class="sseo__title" id="sseo-title">{L.seo.title}</h2>
        </div>
        <div class="sseo__cols" data-reveal style="--reveal-delay:0.08s">
          <div class="sseo__col">{seoLeft.map((p) => <p>{p}</p>)}</div>
          <div class="sseo__col">{seoRight.map((p) => <p>{p}</p>)}</div>
        </div>
      </div>
    </section>

    <Faq faqs={L.faqs} />
    <CtaBand />
  </main>
  <Footer />
</Layout>

<style>
  .prices { background: var(--color-cream); color: #0c0a08; padding-block: clamp(2.5rem, 5vw, 4rem) var(--section-py); }

  .prices__incl { list-style: none; margin: 0 0 clamp(2rem, 4vw, 3rem); padding: 0; display: flex; flex-wrap: wrap; gap: 12px 28px; }
  .prices__incl li { display: inline-flex; align-items: center; gap: 9px; font-size: 15px; font-weight: 500; color: #0c0a08; }
  .prices__incl svg { inline-size: 18px; block-size: 18px; flex: none; color: #c46a2d; }

  .prices__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 1.6vw, 1.5rem); align-items: stretch; }

  .pcard { display: flex; flex-direction: column; background: #fff; border: 1px solid rgba(20, 15, 10, 0.1); border-radius: 20px; overflow: hidden; box-shadow: 0 22px 50px -38px rgba(0, 0, 0, 0.4); transition: transform 0.35s ease, box-shadow 0.35s ease; }
  .pcard:hover { transform: translateY(-6px); box-shadow: 0 34px 66px -34px rgba(0, 0, 0, 0.45); }
  .pcard__media { position: relative; isolation: isolate; aspect-ratio: 16 / 10; overflow: hidden; }
  .pcard__media img { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
  .pcard:hover .pcard__media img { transform: scale(1.06); }
  .pcard__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0, 0, 0, 0.22) 0%, transparent 30%, rgba(13, 7, 3, 0.9) 100%); }
  .pcard__klass { position: absolute; z-index: 1; inset-block-start: 14px; inset-inline-start: 14px; padding: 6px 13px; border-radius: 999px; background: rgba(20, 15, 10, 0.42); border: 1px solid rgba(255, 255, 255, 0.24); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); font-family: var(--font-oswald); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #f6e4d6; }
  .pcard__name { position: absolute; z-index: 1; inset-block-end: 16px; inset-inline: 20px; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.6rem, 2.4vw, 2.1rem); letter-spacing: -0.02em; color: #fff; }
  .pcard__body { display: flex; flex-direction: column; flex: 1; padding: clamp(1.5rem, 2.5vw, 2rem); }
  .pcard__rows { list-style: none; margin: 0 0 clamp(1.3rem, 2.2vw, 1.75rem); padding: 0; display: flex; flex-direction: column; }
  .pcard__row { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; padding-block: 14px; border-block-start: 1px solid rgba(20, 15, 10, 0.09); }
  .pcard__row:first-child { border-block-start: 0; padding-block-start: 0; }
  .pcard__type { font-size: 15px; color: #0c0a08c9; }
  .pcard__hint { display: block; font-size: 12px; color: rgba(12, 10, 8, 0.5); margin-block-start: 2px; }
  .pcard__price { white-space: nowrap; display: flex; align-items: baseline; gap: 5px; }
  .pcard__price strong { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; color: #0c0a08; letter-spacing: -0.01em; }
  .pcard__unit { font-size: 12.5px; color: rgba(12, 10, 8, 0.5); }
  /* Emphasise the headline transfer price. */
  .pcard__row:first-child .pcard__price strong { font-size: 1.85rem; color: #c46a2d; }
  .pcard__link { margin-block-start: auto; display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 14px 24px; border-radius: 999px; background: #14100b; color: #fff; font-weight: 600; font-size: 14.5px; text-decoration: none; transition: background 0.3s ease, transform 0.25s ease; }
  .pcard__link:hover { background: #c46a2d; transform: translateY(-1px); }
  .pcard__link svg { inline-size: 16px; block-size: 16px; }

  @media (max-width: 960px) { .prices__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .prices__grid { grid-template-columns: 1fr; } }

  .prices__note { margin: clamp(2.5rem, 5vw, 3.5rem) 0 0; font-size: 15px; line-height: 1.7; color: #0c0a089e; max-inline-size: 70ch; }

  .prices__long { margin: clamp(1.5rem, 3vw, 2rem) 0 0; padding-block-start: clamp(1.5rem, 3vw, 2rem); border-block-start: 1px solid rgba(12, 10, 8, 0.1); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; }
  .prices__long-text { margin: 0; font-size: 15px; line-height: 1.6; color: #0c0a08c9; max-inline-size: 46ch; }
  .prices__long-cta { flex: none; display: inline-flex; align-items: center; justify-content: center; padding: 13px 28px; border-radius: 999px; background: linear-gradient(90deg, #c46a2d 0%, #e9b79a 100%); color: #1a0e04; font-weight: 600; font-size: 14.5px; text-decoration: none; white-space: nowrap; transition: filter 0.3s ease, transform 0.25s ease; }
  .prices__long-cta:hover { filter: brightness(1.05); transform: translateY(-1px); }

  @media (max-width: 640px) {
    .prices__incl { gap: 10px 20px; }
    .prices__incl li { font-size: 14px; }
  }

  /* ============ SEO TEXT ============ */
  .sseo { background: var(--color-cream); color: #0c0a08; padding-block: 0 var(--section-py); }
  .sseo__head { max-inline-size: 55%; }
  .sseo__eyebrow { display: flex; align-items: center; gap: 15px; margin-block-end: 20px; }
  .sseo__eyebrow span:not(.sseo__line) { font-family: var(--font-display); font-weight: 600; font-size: 24px; letter-spacing: -1px; text-transform: uppercase; color: #c46a2d; }
  .sseo__line { inline-size: 60px; block-size: 1.429px; background: #c46a2d; opacity: 0.6; flex: none; }
  .sseo__title { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.9rem, 3.2vw, 2.9rem); line-height: 1.12; letter-spacing: -0.02em; color: #0c0a08; }
  .sseo__cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 4vw, 65px); margin-block-start: clamp(2rem, 3.5vw, 3.5rem); padding-block-start: clamp(2rem, 3vw, 3.5rem); border-block-start: 1px solid rgba(0, 0, 0, 0.12); }
  .sseo__col { display: flex; flex-direction: column; gap: clamp(1rem, 1.5vw, 1.4rem); }
  .sseo__col p { margin: 0; font-size: 16px; line-height: 1.75; color: #0c0a089e; }

  @media (max-width: 900px) {
    .sseo__head { max-inline-size: 100%; }
    .sseo__cols { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  @media (max-width: 640px) {
    .sseo__eyebrow span:not(.sseo__line) { font-size: 1.05rem; }
    .sseo__title { font-size: 2rem; }
  }
</style>

<style is:global>
  body { background: var(--color-cream); }
</style>
