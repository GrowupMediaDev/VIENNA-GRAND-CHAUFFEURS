---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { CONTACT } from '../lib/site';
import { getLang, hrefFor, pick } from '../lib/i18n';

const lang = getLang(Astro.url);
const phoneHref = `tel:${CONTACT.phonePrimary.tel}`;
const homeHref = hrefFor('/', lang);
const L = pick(lang,
  {
    title: 'Vielen Dank — Vienna Grand Chauffeurs', desc: 'Vielen Dank für Ihre Buchung bei Vienna Grand Chauffeurs. Wir haben Ihre Anfrage erhalten und melden uns umgehend.',
    eyebrow: 'Buchung abgeschlossen', heading: 'Vielen Dank für Ihre Buchung.',
    sub: 'Wir haben Ihre Anfrage erhalten und kümmern uns umgehend darum. Eine Bestätigung mit allen Details erreicht Sie in Kürze.',
    toHome: 'Zur Startseite',
    lblNumber: 'Buchungsnummer', lblVehicle: 'Fahrzeug', lblFrom: 'Von', lblTo: 'Nach', lblWhen: 'Datum & Uhrzeit', lblPrice: 'Preis', lblPay: 'Zahlung', lblReturn: 'inkl. Rückfahrt',
    payPaid: 'Bezahlt', payOnsite: 'Zahlung vor Ort', payProcessing: 'Zahlung in Bearbeitung',
    next: [
      { title: 'Bestätigung per E-Mail', text: 'Sie erhalten in Kürze eine Bestätigung mit allen Details Ihrer Fahrt.' },
      { title: 'Wir melden uns', text: 'Bei Rückfragen kontaktiert Sie unser Team persönlich und unkompliziert.' },
      { title: 'Entspannt ankommen', text: 'Ihr Chauffeur ist pünktlich zur Stelle — Sie müssen sich um nichts kümmern.' },
    ],
  },
  {
    title: 'Thank You — Vienna Grand Chauffeurs', desc: 'Thank you for your booking with Vienna Grand Chauffeurs. We have received your enquiry and will get back to you shortly.',
    eyebrow: 'Booking complete', heading: 'Thank you for your booking.',
    sub: 'We have received your enquiry and will take care of it right away. A confirmation with all the details will reach you shortly.',
    toHome: 'To the homepage',
    lblNumber: 'Booking number', lblVehicle: 'Vehicle', lblFrom: 'From', lblTo: 'To', lblWhen: 'Date & time', lblPrice: 'Price', lblPay: 'Payment', lblReturn: 'incl. return',
    payPaid: 'Paid', payOnsite: 'Payment on site', payProcessing: 'Payment processing',
    next: [
      { title: 'Confirmation by email', text: 'You will shortly receive a confirmation with all the details of your journey.' },
      { title: 'We will be in touch', text: 'If we have any questions, our team will contact you personally and without fuss.' },
      { title: 'Arrive relaxed', text: 'Your chauffeur will be there on time — you need not worry about a thing.' },
    ],
  });
---
<Layout title={L.title} description={L.desc}>
  <Nav />
  <main>
    <section class="abschluss">
      <div class="abschluss__bg" aria-hidden="true"></div>
      <div class="container-x abschluss__inner">
        <span class="abschluss__check" data-reveal aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg>
        </span>
        <div class="abschluss__eyebrow" data-reveal><span class="abschluss__line" aria-hidden="true"></span><span>{L.eyebrow}</span></div>
        <h1 class="abschluss__title" data-reveal style="--reveal-delay:0.06s">{L.heading}</h1>
        <p class="abschluss__sub" data-reveal style="--reveal-delay:0.12s">{L.sub}</p>

        <div class="abschluss__summary" id="booking-summary" hidden data-reveal style="--reveal-delay:0.16s">
          <div class="abschluss__sum-head">
            <span class="abschluss__sum-label">{L.lblNumber}</span>
            <strong class="abschluss__sum-num" id="bs-num"></strong>
          </div>
          <dl class="abschluss__sum-rows">
            <div class="abschluss__sum-row" id="bs-veh-row"><dt>{L.lblVehicle}</dt><dd id="bs-veh"></dd></div>
            <div class="abschluss__sum-row" id="bs-from-row"><dt>{L.lblFrom}</dt><dd id="bs-from"></dd></div>
            <div class="abschluss__sum-row" id="bs-to-row"><dt>{L.lblTo}</dt><dd id="bs-to"></dd></div>
            <div class="abschluss__sum-row" id="bs-dt-row"><dt>{L.lblWhen}</dt><dd id="bs-dt"></dd></div>
            <div class="abschluss__sum-row" id="bs-price-row"><dt>{L.lblPrice}</dt><dd id="bs-price"></dd></div>
            <div class="abschluss__sum-row" id="bs-pay-row"><dt>{L.lblPay}</dt><dd id="bs-pay"></dd></div>
          </dl>
        </div>

        <script is:inline define:vars={{ payPaid: L.payPaid, payOnsite: L.payOnsite, payProcessing: L.payProcessing, returnTxt: L.lblReturn }}>
          (function () {
            var params = new URLSearchParams(window.location.search);
            var KEY = 'vgc_booking_done';
            var KEYS = ['bn', 'veh', 'from', 'to', 'dt', 'price', 'pay', 'rt'];
            var p;
            if (params.get('bn')) {
              // Frisch von der Widget-Weiterleitung: Werte merken, damit ein
              // Sprachwechsel (der die Query-Parameter verliert, weil der
              // Umschalter nur den Pfad wechselt) die Zusammenfassung nicht
              // verschwinden laesst.
              var data = {};
              KEYS.forEach(function (k) { var v = params.get(k); if (v) data[k] = v; });
              try { sessionStorage.setItem(KEY, JSON.stringify(data)); } catch (e) {}
              p = params;
            } else {
              // Kein Parameter (z.B. nach Sprachwechsel) -> aus sessionStorage.
              var stored = null;
              try { stored = JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch (e) {}
              p = { get: function (k) { return (stored && stored[k]) || null; } };
            }
            var bn = p.get('bn');
            if (!bn) return;
            function fill(id, rowId, val) {
              var el = document.getElementById(id);
              if (val) { if (el) el.textContent = val; }
              else { var r = document.getElementById(rowId); if (r) r.hidden = true; }
            }
            document.getElementById('bs-num').textContent = bn;
            fill('bs-veh', 'bs-veh-row', p.get('veh'));
            fill('bs-from', 'bs-from-row', p.get('from'));
            fill('bs-to', 'bs-to-row', p.get('to'));
            fill('bs-dt', 'bs-dt-row', p.get('dt'));
            var price = p.get('price');
            if (price) {
              document.getElementById('bs-price').textContent = '€ ' + price + (p.get('rt') === '1' ? ' · ' + returnTxt : '');
            } else {
              document.getElementById('bs-price-row').hidden = true;
            }
            var payMap = { paid: payPaid, onsite: payOnsite, processing: payProcessing };
            document.getElementById('bs-pay').textContent = payMap[p.get('pay')] || payOnsite;
            document.getElementById('booking-summary').hidden = false;
          })();
        </script>

        <ul class="abschluss__next" data-reveal style="--reveal-delay:0.18s">
          {L.next.map((n) => (
            <li class="abschluss__step">
              <h2 class="abschluss__step-title">{n.title}</h2>
              <p class="abschluss__step-text">{n.text}</p>
            </li>
          ))}
        </ul>

        <div class="abschluss__cta" data-reveal style="--reveal-delay:0.24s">
          <a class="abschluss__btn" href={homeHref}>{L.toHome}</a>
          <a class="abschluss__phone" href={phoneHref}>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z"/></svg>
            <span>{CONTACT.phonePrimary.display}</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .abschluss { position: relative; isolation: isolate; overflow: hidden; background: #0d0703; color: #fff; }
  .abschluss__bg {
    position: absolute; inset: 0; z-index: 0;
    background: radial-gradient(120% 80% at 50% 0%, rgba(196, 106, 45, 0.22), transparent 60%), #0d0703;
  }
  .abschluss__inner {
    position: relative; z-index: 1;
    min-block-size: 100svh; display: flex; flex-direction: column; align-items: center; text-align: center;
    padding-block: clamp(8rem, 20vh, 13rem) clamp(4rem, 8vh, 6rem);
  }
  .abschluss__check {
    inline-size: clamp(72px, 11vw, 96px); block-size: clamp(72px, 11vw, 96px); border-radius: 999px;
    display: grid; place-items: center; color: #1a0e04;
    background: linear-gradient(135deg, #c46a2d 0%, #e9b79a 100%);
    box-shadow: 0 20px 50px -18px rgba(196, 106, 45, 0.7);
    margin-block-end: clamp(1.75rem, 3.5vw, 2.5rem);
  }
  .abschluss__check svg { inline-size: 46%; block-size: 46%; }
  .abschluss__eyebrow { display: flex; align-items: center; gap: 15px; margin-block-end: 18px; }
  .abschluss__eyebrow span:not(.abschluss__line) { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.05rem, 2vw, 1.4rem); letter-spacing: -0.5px; text-transform: uppercase; color: #e9b79a; }
  .abschluss__line { inline-size: 48px; block-size: 1.429px; background: #c46a2d; opacity: 0.7; flex: none; }
  .abschluss__title { font-family: var(--font-display); font-weight: 700; font-size: clamp(2.4rem, 6vw, 4.5rem); line-height: 1; letter-spacing: -0.03em; max-inline-size: 16ch; }
  .abschluss__sub { margin: clamp(1.2rem, 2.5vw, 1.75rem) 0 0; font-size: clamp(1rem, 1.3vw, 1.19rem); line-height: 1.7; color: rgba(255, 255, 255, 0.78); max-inline-size: 56ch; }

  .abschluss__summary { inline-size: min(100%, 560px); margin: clamp(2rem, 4vw, 3rem) 0 0; text-align: left; border-radius: 20px; background: rgba(255, 255, 255, 0.045); border: 1px solid rgba(233, 183, 154, 0.28); box-shadow: 0 24px 60px -34px rgba(0, 0, 0, 0.7); overflow: hidden; }
  .abschluss__sum-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: clamp(1.1rem, 2.2vw, 1.5rem) clamp(1.3rem, 2.5vw, 1.8rem); background: linear-gradient(90deg, rgba(196, 106, 45, 0.22), rgba(196, 106, 45, 0.05)); border-block-end: 1px solid rgba(233, 183, 154, 0.2); }
  .abschluss__sum-label { font-family: var(--font-display); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: #e9b79a; }
  .abschluss__sum-num { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.15rem, 2.4vw, 1.5rem); color: #fff; letter-spacing: 0.02em; }
  .abschluss__sum-rows { margin: 0; padding: clamp(0.4rem, 1vw, 0.6rem) clamp(1.3rem, 2.5vw, 1.8rem) clamp(0.9rem, 1.8vw, 1.2rem); }
  .abschluss__sum-row { display: flex; align-items: baseline; justify-content: space-between; gap: 18px; padding-block: clamp(0.6rem, 1.2vw, 0.8rem); border-block-end: 1px solid rgba(255, 255, 255, 0.07); }
  .abschluss__sum-row:last-child { border-block-end: none; }
  .abschluss__sum-row dt { margin: 0; font-size: 13px; letter-spacing: 0.02em; color: rgba(255, 255, 255, 0.55); flex: none; }
  .abschluss__sum-row dd { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 15px; color: #fff; text-align: right; }
  #bs-price { color: #e9b79a; }

  .abschluss__next { list-style: none; margin: clamp(2.5rem, 5vw, 4rem) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: clamp(1rem, 2vw, 1.75rem); inline-size: min(100%, 900px); text-align: left; }
  .abschluss__step { padding: clamp(1.4rem, 2.5vw, 1.9rem); border-radius: 16px; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1); }
  .abschluss__step-title { font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; color: #fff; margin-block-end: 0.4rem; }
  .abschluss__step-text { margin: 0; font-size: 14.5px; line-height: 1.6; color: rgba(255, 255, 255, 0.62); }

  .abschluss__cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin-block-start: clamp(2.5rem, 5vw, 3.5rem); }
  .abschluss__btn { display: inline-flex; align-items: center; padding: 16px 38px; border-radius: 999px; background: linear-gradient(90deg, #c46a2d 0%, #e9b79a 100%); color: #1a0e04; font-weight: 600; font-size: 16px; text-decoration: none; transition: filter 0.3s ease, transform 0.25s ease; }
  .abschluss__btn:hover { filter: brightness(1.05); transform: translateY(-2px); }
  .abschluss__phone { display: inline-flex; align-items: center; gap: 10px; padding: 16px 34px; border-radius: 999px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.28); color: #fff; font-weight: 500; font-size: 16px; text-decoration: none; transition: background 0.3s ease; }
  .abschluss__phone:hover { background: rgba(255, 255, 255, 0.12); }
  .abschluss__phone svg { inline-size: 18px; block-size: 18px; }

  @media (max-width: 640px) {
    .abschluss__cta { flex-wrap: nowrap; }
    .abschluss__btn, .abschluss__phone { padding: 0.85rem 1.4rem; font-size: 0.9rem; }
  }
</style>
