---
// Fixed contact rail — vertically centered on the right edge, present on
// every page via Layout.astro. WhatsApp, email, landline and mobile, always reachable.
import { CONTACT } from '../lib/site';
import { getLang, pick } from '../lib/i18n';

const lang = getLang(Astro.url);
const phoneHref = `tel:${CONTACT.phonePrimary.tel}`;
const mobileHref = `tel:${CONTACT.phoneSecondary.tel}`;

const L = pick(lang,
  { whatsapp: 'WhatsApp', email: 'E-Mail schreiben', phone: 'Anrufen', mobile: 'Mobil anrufen', open: 'Kontakt anzeigen' },
  { whatsapp: 'WhatsApp', email: 'Send email', phone: 'Call us', mobile: 'Call mobile', open: 'Show contact options' });
---
<div class="crail" aria-label="Kontakt">
  <a class="crail__btn crail__btn--wa" href={CONTACT.whatsapp.url} target="_blank" rel="noopener" aria-label={L.whatsapp} title={L.whatsapp}>
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.4 15.17L2 22l4.95-1.3A9.9 9.9 0 1 0 12.04 2Zm0 1.8a8.1 8.1 0 1 1-4.13 15.06l-.3-.18-2.94.77.78-2.86-.2-.3A8.1 8.1 0 0 1 12.04 3.8Zm-2.6 4.02c-.15-.36-.3-.35-.45-.36h-.38c-.13 0-.35.05-.53.26-.18.2-.7.68-.7 1.66 0 .98.71 1.92.81 2.05.1.13 1.4 2.24 3.5 3.05 1.74.67 2.1.53 2.48.5.38-.04 1.22-.5 1.4-.98.17-.48.17-.9.12-.98-.05-.09-.18-.13-.38-.23-.2-.1-1.22-.6-1.4-.67-.19-.07-.33-.1-.47.1-.13.2-.53.66-.65.8-.12.13-.24.15-.44.05-.2-.1-.86-.32-1.63-1.01-.6-.54-1.01-1.2-1.13-1.4-.12-.2-.01-.31.09-.41.09-.09.2-.24.3-.36.1-.12.13-.2.2-.34.06-.13.03-.25-.02-.35-.05-.1-.44-1.12-.62-1.53Z"/></svg>
  </a>
  <a class="crail__btn crail__btn--mail" href={CONTACT.email.mailto} aria-label={L.email} title={L.email}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>
  </a>
  <a class="crail__btn crail__btn--tel" href={phoneHref} aria-label={L.phone} title={L.phone}>
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z"/></svg>
  </a>
  <a class="crail__btn crail__btn--mobile" href={mobileHref} aria-label={L.mobile} title={L.mobile}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M10.5 18.5h3"/></svg>
  </a>
  <button type="button" class="crail__toggle" aria-expanded="false" aria-label={L.open} title={L.open}>
    <svg class="crail__ico-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8.5 8.5 0 0 1-12.4 7.55L3.5 21l1.45-5.1A8.5 8.5 0 1 1 21 12Z"/></svg>
    <svg class="crail__ico-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
  </button>
</div>

<script>
  // iPhone auf Seiten mit Buchungs-Widget: Leiste ist zu einem Kontakt-Knopf
  // zusammengeklappt (CSS unten); Tippen klappt sie auf, Tippen daneben/Esc zu.
  const rail = document.querySelector('.crail');
  const toggle = rail?.querySelector('.crail__toggle');
  if (rail && toggle) {
    const set = (open) => { rail.classList.toggle('is-open', open); toggle.setAttribute('aria-expanded', String(open)); };
    toggle.addEventListener('click', () => set(!rail.classList.contains('is-open')));
    document.addEventListener('click', (e) => { if (!rail.contains(e.target as Node)) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  }
</script>

<style>
  .crail {
    position: fixed; z-index: 90;
    inset-block-start: 50%; inset-inline-end: clamp(14px, 2.4vw, 28px);
    transform: translateY(-50%);
    display: flex; flex-direction: column; gap: 14px;
  }
  .crail__btn {
    inline-size: 54px; block-size: 54px; border-radius: 999px;
    display: grid; place-items: center; color: #fff;
    box-shadow: 0 10px 26px -10px rgba(0, 0, 0, 0.5);
    transition: transform 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94), filter 0.3s ease, box-shadow 0.3s ease;
  }
  .crail__btn svg { inline-size: 24px; block-size: 24px; }
  .crail__btn:hover, .crail__btn:focus-visible { transform: scale(1.08); filter: brightness(1.06); }
  .crail__btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  .crail__toggle { display: none; }

  .crail__btn--wa { background: #25d366; }
  .crail__btn--mail { background: #2563eb; }
  .crail__btn--tel,
  .crail__btn--mobile { background: linear-gradient(135deg, #c46a2d 0%, #e9b79a 100%); }

  @media (max-width: 640px) {
    .crail {
      gap: 10px; inset-inline-end: 14px;
      inset-block-start: auto; inset-block-end: 18px;
      transform: none;
    }
    .crail__btn { inline-size: 44px; block-size: 44px; }
    .crail__btn svg { inline-size: 20px; block-size: 20px; }
    /* Cookie banner (#vgc-cookie-consent, full-width bottom bar) is open:
       move the rail up below the nav so the icons stay tappable. The banner
       sets display:none inline once dismissed, the rail then returns down. */
    :global(body:has(> #vgc-cookie-consent:not([style*="none"]))) .crail {
      inset-block-start: 108px; inset-block-end: auto;
    }
    /* Solange die Leiste oben steht (Banner offen), lag sie ueber dem rechten
       Ende des Seitentitels: Titel rechts um die Knopfbreite freihalten. */
    :global(body:has(> #vgc-cookie-consent:not([style*="none"])):not(:has(#vt-booking)) h1) {
      padding-inline-end: 44px;
    }

    /* Seiten mit Buchungs-Widget (#vt-booking): vier Buttons lagen ueber
       Feldern und Werten des Formulars. Zusammengeklappt bleibt nur ein
       Kontakt-Knopf; aufgeklappt erscheinen die vier Buttons darueber. */
    :global(body:has(#vt-booking)) .crail { inset-block-end: calc(18px + env(safe-area-inset-bottom, 0px)); }
    :global(body:has(#vt-booking)) .crail__toggle {
      display: grid; place-items: center;
      inline-size: 44px; block-size: 44px; border-radius: 999px; border: 0; padding: 0;
      color: #fff; background: linear-gradient(135deg, #c46a2d 0%, #e9b79a 100%);
      box-shadow: 0 10px 26px -10px rgba(0, 0, 0, 0.5); cursor: pointer;
      transition: transform 0.2s ease;
    }
    :global(body:has(#vt-booking)) .crail__toggle:active { transform: scale(0.94); }
    :global(body:has(#vt-booking)) .crail__toggle:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
    .crail__toggle svg { inline-size: 20px; block-size: 20px; grid-area: 1 / 1; transition: opacity 0.2s ease, transform 0.25s ease; }
    .crail__ico-close { opacity: 0; transform: rotate(-90deg); }
    .crail.is-open .crail__ico-open { opacity: 0; transform: rotate(90deg); }
    .crail.is-open .crail__ico-close { opacity: 1; transform: none; }
    :global(body:has(#vt-booking)) .crail:not(.is-open) .crail__btn {
      opacity: 0; visibility: hidden; pointer-events: none; transform: translateY(14px) scale(0.85);
    }
    :global(body:has(#vt-booking)) .crail__btn {
      transition: opacity 0.22s ease-out, transform 0.26s cubic-bezier(0.25, 0.46, 0.45, 0.94), visibility 0.26s;
    }
  }
  @media (max-width: 640px) and (prefers-reduced-motion: reduce) {
    .crail__btn, .crail__toggle svg { transition: none; }
  }
</style>
