---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Faq from './Faq.astro';
import CtaBand from './CtaBand.astro';
import FleetShowcase from './FleetShowcase.astro';
import ServicesCarousel from './ServicesCarousel.astro';
import Button from './Button.astro';
import Schema from './Schema.astro';
import { CONTACT } from '../lib/site';
import { getLang, hrefFor, pick } from '../lib/i18n';

const lang = getLang(Astro.url);
const phoneHref = `tel:${CONTACT.phonePrimary.tel}`;
const bookHref = hrefFor('/online-buchung', lang);
const kontaktHref = hrefFor('/kontakt', lang);

// Hero background slider — first slide is preloaded/eager, the rest lazy.
// Add or reorder entries here; the slider adapts automatically.
const heroSlides = [
  '/images/hero-home.jpg',
  '/images/hero-slide-2.jpg',
  '/images/hero-slide-3.jpg',
];

// Hero H1 markers. The headline breaks before heroTitleTail ("Der Nr. 1
// Chauffeur" / "Service in Wien") and highlights heroTitleAccent in the
// accent colour. Both live here rather than in the text itself, because
// L.heroTitle below is generated from content.json and would lose any markup
// on the next content update. Markers that do not match are skipped, so the
// title always renders complete.
const heroTitleTail = pick(lang, 'Service in Wien', 'Service in Vienna');
const heroTitleAccent = pick(lang, 'Nr. 1', 'No. 1');

const L = pick(lang,
  {
    metaTitle: 'Chauffeur Service Wien – Limousine & Transfer | Vienna Grand Chauffeurs',
    metaDesc: 'Chauffeur Service Wien: Flughafentransfer, Limousinen und Langstreckenfahrten zum Fixpreis. Diskret, pünktlich, rund um die Uhr. Jetzt online buchen.',
    heroTitle: 'Der Nr. 1 Chauffeur Service in Wien',
    heroSub: 'Exklusive Fahrzeuge, ausgebildete Chauffeure und absolute Diskretion bei jeder Fahrt. Wir sorgen dafür, dass Sie entspannt und sicher ankommen.',
    book: 'Jetzt buchen', discover: 'Unsere Fahrzeuge entdecken', scrollAria: 'Nach unten scrollen',
    hbookAria: 'Online buchen', hbookEyebrow: 'In 30 Sekunden zum Fixpreis',
    hbookFrom: 'Von', hbookTo: 'Nach', hbookDate: 'Datum', hbookTime: 'Uhrzeit', hbookStop: 'Zwischenstopp', hbookFlight: 'Flugnummer',
    hbookFromV: 'Abholadresse', hbookToV: 'Zieladresse', hbookStopV: 'Adresse Zwischenstopp', hbookFlightV: 'z. B. OS 052', hbookCta: 'Preis berechnen', hbookAddStop: 'Zwischenstopp hinzufügen', hbookRemoveStop: 'Zwischenstopp entfernen', hbookFlightReq: 'Bitte Flugnummer angeben (Flughafen-Abholung).',
    hbookAcList: 'Adressvorschläge', hbookAcSearching: 'Suche …', hbookAcEmpty: 'Kein Treffer bei Google.', hbookAcHint: 'Tipp: Straße + Hausnummer + Ort, oder der Name des Hotels/Flughafens. Adressen im Ausland sind möglich.', hbookAcRequest: 'Ort nicht dabei? Anfrage senden',
    hbookDatePh: 'TT.MM.JJJJ', hbookTimePh: 'HH:MM',
    calPrev: 'Vorheriger Monat', calNext: 'Nächster Monat',
    calMonths: ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'],
    calDows: ['Mo','Di','Mi','Do','Fr','Sa','So'],
    hbookLeadNotice: 'Für Buchungen mit weniger als 2 Stunden Vorlaufzeit kontaktieren Sie uns bitte direkt telefonisch oder per WhatsApp — wir finden gerne kurzfristig die passende Lösung für Sie.',
    aboutEyebrow: 'Über uns',
    aboutTitle: 'Unser Chauffeurservice verbindet Wiener Diskretion mit modernem Komfort',
    aboutBody: 'Professionelle Chauffeure, eine gepflegte Premiumflotte und ein durchdachter Ablauf sorgen dafür, dass Sie sich auf jeder Fahrt einfach zurücklehnen können, ob Flughafentransfer, Geschäftstermin oder Langstrecke in ganz Österreich. Pünktlichkeit, Diskretion und persönliche Betreuung begleiten Sie dabei vom ersten Kontakt bis zur Ankunft.',
    features: [
      { n: '01', label: 'Erfahrene Chauffeure', text: 'Diskret, professionell und stets zuvorkommend.', img: '/images/card-1.jpg', w: 1792, h: 2400 },
      { n: '02', label: 'Premiumflotte', text: 'Gepflegte Oberklasse-Fahrzeuge für höchsten Komfort.', img: '/images/card-2.jpg', w: 2400, h: 1792 },
      { n: '03', label: 'Pünktlich & Zuverlässig', text: 'Auf die Minute pünktlich, bei jeder Fahrt.', img: '/images/card-3.jpg', w: 1792, h: 2400 },
    ],
    benefitsAria: 'Warum Vienna Grand', benefitsEyebrow: 'Warum Vienna Grand',
    benefitsTitle: 'Ihr Chauffeur in Wien, auf den Sie zählen',
    benefitsIntro: 'Bei uns fahren Sie mit einem festen Team geschulter Chauffeure. Wir kennen Wien, planen Ihre Route voraus und sind pünktlich zur Stelle. So bleibt Ihr Kopf frei fürs Wesentliche.',
    benefits: [
      { icon: '/images/why-1.svg', title: 'Erfahrene & diskrete Chauffeure', text: 'Geschult auf Diskretion, Sicherheit und Etikette, vom ersten Gruß bis zur Ankunft.' },
      { icon: '/images/why-2.svg', title: 'Gepflegte Premiumflotte', text: 'Eine durchweg schwarze Mercedes-Benz Oberklasse, makellos gepflegt und klimatisiert.' },
      { icon: '/images/why-3.svg', title: 'Pünktlich & rund um die Uhr', text: '365 Tage im Jahr verfügbar und auf die Minute pünktlich inklusive Flugüberwachung.' },
      { icon: '/images/why-4.svg', title: 'Transparente Fixpreise', text: 'Endpreis schon bei der Buchung, inklusive Maut, Wartezeit und MwSt., ohne Überraschungen.' },
    ],
    benefitsCta: 'Jetzt anfragen', benefitsAlt: 'Chauffeur öffnet die Fahrzeugtür einer schwarzen Mercedes-Limousine',
    htextTitle: 'Vom Flughafentransfer bis zur Langstrecke, alles inklusive',
    htextCol1: [
      'Ob Abholung am Flughafen Wien, Termin in der Stadt oder längere Fahrt: Unser Chauffeurservice Wien bringt Sie sicher und pünktlich ans Ziel. Unsere Fahrzeuge reichen von der Business-Limousine bis zum 20-Sitzer Sprinter für größere Gruppen.',
      'Für jede Fahrt wählen Sie das passende Fahrzeug und buchen es direkt online.',
      'Ihr Chauffeur Wien wartet zur vereinbarten Zeit, kennt die Route und bringt Sie ruhig ans Ziel. Auf Wunsch steht Ihnen derselbe Fahrer bei jeder Fahrt zur Verfügung, das schafft Vertrauen und macht jede Fahrt vertraut.',
    ],
    htextCol2: [
      'Die Bezahlung ist einfach, per Kreditkarte, Apple Pay oder Google Pay. Den Fixpreis sehen Sie vorab, ohne versteckte Kosten. Wer einen Chauffeur für einige Stunden braucht, bucht ihn einfach stundenweise.',
      'Unser Limousinenservice Wien reicht von der eleganten Limousine bis zum geräumigen Van, sodass für jeden Anlass das richtige Fahrzeug bereitsteht. Für Events oder Delegationen schicken Sie eine Gruppenanfrage und erhalten innerhalb weniger Stunden ein Angebot.',
      'So unkompliziert ist Ihr Chauffeurservice Wien. Vom ersten Kontakt bis zur Ankunft kümmern wir uns um jedes Detail Ihrer Fahrt, damit Sie sich zurücklehnen und die Zeit für sich nutzen',
    ],
    faqs: [
      { q: 'Was kostet ein Chauffeur Service in Wien?', a: 'Der Preis richtet sich nach Fahrzeug, Dauer und Strecke. Sie sehen den Fixpreis vor der Buchung, inklusive Fahrer, Fahrzeug und allen Nebenkosten.' },
      { q: 'Kann ich online buchen und bezahlen?', a: 'Ja. Sie wählen Ihr Fahrzeug, sehen den Preis und zahlen per Kreditkarte, Apple Pay oder Google Pay. Die Bestätigung kommt sofort.' },
      { q: 'Sind Sie rund um die Uhr erreichbar?', a: 'Ja, unser Chauffeur Service in Wien ist 24 Stunden am Tag verfügbar, auch an Wochenenden und Feiertagen. Wir empfehlen eine Buchung im Voraus.' },
      { q: 'Bieten Sie auch Fahrten für Gruppen an?', a: 'Ja. Vom Van bis zum Sprinter mit bis zu 20 Sitzen bringen wir auch größere Gruppen zuverlässig ans Ziel. Stellen Sie einfach eine Anfrage.' },
      { q: 'Fahren Sie auch außerhalb von Wien?', a: 'Ja, wir übernehmen Langstreckenfahrten in ganz Österreich und ins benachbarte Ausland, etwa nach Bratislava, Prag oder Budapest.' },
      { q: 'Wie weit im Voraus sollte ich buchen?', a: 'Für Flughafentransfers genügen oft wenige Stunden. Für Gruppen, Events oder mehrtägige Fahrten empfehlen wir eine frühzeitige Reservierung.' },
    ],
  },
  {
    metaTitle: 'Chauffeur Service Vienna – Limousine & Transfer | Vienna Grand Chauffeurs',
    metaDesc: 'Chauffeur service in Vienna: airport transfers, limousines and long-distance rides at a fixed price. Discreet, punctual, around the clock. Book online now.',
    heroTitle: 'The No. 1 Chauffeur Service in Vienna',
    heroSub: 'Discreet, punctual and reliable across Vienna and beyond.',
    book: 'Book now', discover: 'Discover our vehicles', scrollAria: 'Scroll down',
    hbookAria: 'Book online', hbookEyebrow: 'Your fixed price in 30 seconds',
    hbookFrom: 'From', hbookTo: 'To', hbookDate: 'Date', hbookTime: 'Time', hbookStop: 'Stop', hbookFlight: 'Flight no.',
    hbookFromV: 'Pickup address', hbookToV: 'Destination address', hbookStopV: 'Stop address', hbookFlightV: 'e.g. OS 052', hbookCta: 'Calculate price', hbookAddStop: 'Add stop', hbookRemoveStop: 'Remove stop', hbookFlightReq: 'Please enter the flight number (airport pickup).',
    hbookAcList: 'Address suggestions', hbookAcSearching: 'Searching …', hbookAcEmpty: 'No match at Google.', hbookAcHint: 'Tip: street + number + city, or the name of the hotel/airport. Addresses abroad are supported.', hbookAcRequest: 'Can’t find it? Send a request',
    hbookDatePh: 'DD.MM.YYYY', hbookTimePh: 'HH:MM',
    calPrev: 'Previous month', calNext: 'Next month',
    calMonths: ['January','February','March','April','May','June','July','August','September','October','November','December'],
    calDows: ['Mo','Tu','We','Th','Fr','Sa','Su'],
    hbookLeadNotice: 'For bookings with less than 2 hours lead time, please contact us directly by phone or WhatsApp — we are happy to find a short-notice solution for you.',
    aboutEyebrow: 'About us',
    aboutTitle: 'Our chauffeur service combines Viennese discretion with modern comfort',
    aboutBody: 'Professional chauffeurs, an immaculate premium fleet and a well-thought-out process ensure that you can simply sit back on every journey — whether an airport transfer, a business appointment or a long-distance trip across Austria. Punctuality, discretion and personal care accompany you from the first contact to your arrival.',
    features: [
      { n: '01', label: 'Experienced chauffeurs', text: 'Discreet, professional and always courteous.', img: '/images/card-1.jpg', w: 1792, h: 2400 },
      { n: '02', label: 'Premium fleet', text: 'Immaculate luxury-class vehicles for the utmost comfort.', img: '/images/card-2.jpg', w: 2400, h: 1792 },
      { n: '03', label: 'Punctual & reliable', text: 'On time to the minute, on every journey.', img: '/images/card-3.jpg', w: 1792, h: 2400 },
    ],
    benefitsAria: 'Why Vienna Grand', benefitsEyebrow: 'Why Vienna Grand',
    benefitsTitle: 'Your chauffeur service Vienna, always reliable',
    benefitsIntro: 'You ride with a fixed team of trained chauffeurs who know Vienna well, plan your route ahead and are always there on time. That leaves your mind free for what truly matters.',
    benefits: [
      { icon: '/images/why-1.svg', title: 'Experienced & discreet chauffeurs', text: 'Trained in discretion, safety and etiquette, from the first greeting to your arrival.' },
      { icon: '/images/why-2.svg', title: 'Immaculate premium fleet', text: 'An all-black Mercedes-Benz luxury class, flawlessly maintained and air-conditioned.' },
      { icon: '/images/why-3.svg', title: 'Punctual & around the clock', text: 'Available 365 days a year and on time to the minute, including flight monitoring.' },
      { icon: '/images/why-4.svg', title: 'Transparent fixed prices', text: 'Final price at the time of booking, including tolls, waiting time and VAT, with no surprises.' },
    ],
    benefitsCta: 'Request now', benefitsAlt: 'Chauffeur opening the door of a black Mercedes limousine',
    htextTitle: 'From airport transfer to long-distance, all included',
    htextCol1: [
      'Whether a pickup at Vienna Airport, a meeting in the city or a longer ride, your chauffeur Vienna brings you there safely and in comfort. Our fleet ranges from the business limousine to the 20-seater Sprinter for larger groups.',
      'For every trip you pick the right vehicle and book it directly online. On request, the same private driver Vienna clients trust is available for every ride, waiting at the agreed time and knowing the route, which builds trust and makes each journey feel familiar.',
      'Payment is easy, by credit card, Apple Pay or Google Pay. You see the fixed price in advance, with no hidden costs.',
    ],
    htextCol2: [
      'Anyone who needs a chauffeur for a few hours simply books by the hour. For events or delegations you send a group request and receive a quote within a few hours.',
      'That is how straightforward your chauffeur service Vienna is, from a limousine service Vienna clients rely on to a discreet VIP transfer Vienna guests remember. From the first contact to arrival we handle every detail, so you can lean back and use the time for yourself.',
      'In every car you will find water, and your driver is happy to help with your luggage and knows the quickest routes through the city, so you always arrive relaxed and on time.',
    ],
    faqs: [
      { q: 'What does a chauffeur service in Vienna cost?', a: 'The price depends on vehicle, duration and route. You see the fixed price before booking, including driver, vehicle and all extras.' },
      { q: 'Can I book and pay online?', a: 'Yes. You choose your vehicle, see the price and pay by credit card, Apple Pay or Google Pay. Confirmation is immediate.' },
      { q: 'Are you available around the clock?', a: 'Yes, our chauffeur service in Vienna is available 24 hours a day, including weekends and holidays. We recommend booking ahead.' },
      { q: 'Do you offer rides for groups?', a: 'Yes. From the van to the 20-seater Sprinter, we bring larger groups to their destination reliably. Simply send a request.' },
      { q: 'Do you also drive outside Vienna?', a: 'Yes, we handle long-distance rides across Austria and to neighbouring countries such as Bratislava, Prague or Budapest.' },
      { q: 'How far in advance should I book?', a: 'For airport transfers a few hours often suffice. For groups, events or multi-day trips we recommend booking early.' },
    ],
  });

const tailAt = L.heroTitle.lastIndexOf(heroTitleTail);
const heroTitleHead = tailAt > 0 ? L.heroTitle.slice(0, tailAt).trimEnd() : L.heroTitle;
// Keep the separating space inside the second line so the heading still reads
// as one sentence for screen readers and text extraction. Leading whitespace
// at the start of a block box is collapsed, so nothing shifts visually.
const heroTitleRest = tailAt > 0 ? ' ' + L.heroTitle.slice(tailAt) : '';

// Split the first line around the highlighted part. The three pieces
// concatenate back to heroTitleHead exactly, spaces included.
const accentAt = heroTitleHead.indexOf(heroTitleAccent);
const heroTitleBefore = accentAt >= 0 ? heroTitleHead.slice(0, accentAt) : heroTitleHead;
const heroTitleAfter = accentAt >= 0 ? heroTitleHead.slice(accentAt + heroTitleAccent.length) : '';
---
<Layout title={L.metaTitle} description={L.metaDesc}>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hero-home.jpg" fetchpriority="high" />
    {/* Das LocalBusiness wird site-weit nur hier voll definiert — die englische
        Startseite und alle Unterseiten referenzieren es ueber seine @id. Der
        WebSite-Knoten dagegen steht auf beiden Startseiten — je einer pro
        Sprache, unterscheidbar ueber @id und inLanguage. */}
    <Schema business={lang === 'de'} website />
  </Fragment>

  <Nav />
  <main>
    <!-- ============ HERO ============ -->
    <section class="hero" aria-labelledby="hero-title">

      <div class="hero__media" data-hero-slider aria-hidden="true">
        {heroSlides.map((src, i) => (
          <img
            src={src}
            alt=""
            width="2000"
            height="1116"
            class:list={['hero__slide', { 'is-active': i === 0 }]}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            decoding="async"
          />
        ))}
      </div>
      <div class="hero__scrim" aria-hidden="true"></div>

      <div class="hero__inner">
        <h1 id="hero-title" class="hero__title" data-reveal>
          <span class="hero__title-line">{heroTitleBefore}{accentAt >= 0 && <span class="hero__title-accent">{heroTitleAccent}</span>}{heroTitleAfter}</span>
          {heroTitleRest && <span class="hero__title-line">{heroTitleRest}</span>}
        </h1>
        <p class="hero__sub" data-reveal style="--reveal-delay:0.1s" set:html={L.heroSub}></p>
        <div class="hero__cta" data-reveal style="--reveal-delay:0.2s">
          <Button href={bookHref}>{L.book}</Button>
          <Button href={phoneHref} variant="ghost-light">
            <svg slot="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z"/></svg>
            {CONTACT.phonePrimary.display}
          </Button>
        </div>
        <a class="hero__discover" href="#fahrzeuge" data-reveal style="--reveal-delay:0.3s">
          {L.discover}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        </a>
      </div>

      <svg class="hero__notch" viewBox="0 0 220 60" aria-hidden="true" preserveAspectRatio="xMidYMax meet">
        <path d="M 0 60 L 37.8 60 L 39.3 60 L 40.7 59.8 L 42.2 59.6 L 43.6 59.2 L 45 58.8 L 46.4 58.2 L 47.7 57.6 L 49 56.9 L 50.3 56.1 L 51.5 55.2 L 52.6 54.3 L 53.6 53.2 L 54.6 52.1 L 55.5 51 L 56.4 49.8 L 57.1 48.5 L 57.8 47.2 L 58.3 45.8 L 58.8 44.4 L 59.9 41.1 L 61.3 37.9 L 62.8 34.7 L 64.6 31.7 L 66.5 28.8 L 68.7 26 L 71 23.4 L 73.5 20.9 L 76.1 18.6 L 78.9 16.5 L 81.8 14.6 L 84.8 12.8 L 87.9 11.3 L 91.2 9.9 L 94.5 8.8 L 97.9 7.9 L 101.3 7.2 L 104.8 6.8 L 108.3 6.5 L 111.7 6.5 L 115.2 6.8 L 118.7 7.2 L 122.1 7.9 L 125.5 8.8 L 128.8 9.9 L 132.1 11.3 L 135.2 12.8 L 138.2 14.6 L 141.1 16.5 L 143.9 18.6 L 146.5 20.9 L 149 23.4 L 151.3 26 L 153.5 28.8 L 155.4 31.7 L 157.2 34.7 L 158.7 37.9 L 160.1 41.1 L 161.2 44.4 L 161.7 45.8 L 162.2 47.2 L 162.9 48.5 L 163.6 49.8 L 164.5 51 L 165.4 52.1 L 166.4 53.2 L 167.4 54.3 L 168.5 55.2 L 169.7 56.1 L 171 56.9 L 172.3 57.6 L 173.6 58.2 L 175 58.8 L 176.4 59.2 L 177.8 59.6 L 179.3 59.8 L 180.7 60 L 182.2 60 L 220 60 Z" fill="currentColor" />
      </svg>
      <a href="#ueber-uns" class="hero__scroll" aria-label={L.scrollAria}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </a>
    </section>

    <!-- ============ BOOKING BAR ============ -->
    <section class="hbook" aria-label={L.hbookAria}>
      <div class="container-x">
        <div class="hbook__inner" data-reveal>
          <span class="hbook__eyebrow"><span class="hbook__dot" aria-hidden="true"></span>{L.hbookEyebrow}</span>
          <form class="hbook__bar" id="hbook-form" data-book-base={bookHref} data-flight-req={L.hbookFlightReq} data-cal-months={JSON.stringify(L.calMonths)} data-cal-dows={JSON.stringify(L.calDows)} data-lang={lang} data-ac-searching={L.hbookAcSearching} data-ac-empty={L.hbookAcEmpty} data-ac-hint={L.hbookAcHint} data-ac-request={L.hbookAcRequest} data-ac-contact={kontaktHref} novalidate>
            <div class="hbook__row">
              <div class="hbook__cell" data-cell="from">
                <label class="hbook__flabel" for="hb-from">{L.hbookFrom}</label>
                <div class="hbook__inwrap">
                  <svg class="hbook__pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="10" r="3"/><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8Z"/></svg>
                  <input class="hbook__input hbook__addr" id="hb-from" name="vgc-q-from" type="text" role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false" autocomplete="one-time-code" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="search" data-lpignore="true" data-1p-ignore aria-controls="hb-from-list" placeholder={L.hbookFromV} />
                </div>
                <ul class="hbook__pop hbook__ac" id="hb-from-list" role="listbox" aria-label={L.hbookAcList} hidden></ul>
              </div>

              <div class="hbook__stops" id="hb-stops"></div>

              <div class="hbook__cell" data-cell="to">
                <label class="hbook__flabel" for="hb-to">{L.hbookTo}</label>
                <div class="hbook__inwrap">
                  <svg class="hbook__pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  <input class="hbook__input hbook__addr" id="hb-to" name="vgc-q-to" type="text" role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false" autocomplete="one-time-code" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="search" data-lpignore="true" data-1p-ignore aria-controls="hb-to-list" placeholder={L.hbookToV} />
                </div>
                <ul class="hbook__pop hbook__ac" id="hb-to-list" role="listbox" aria-label={L.hbookAcList} hidden></ul>
              </div>

              <div class="hbook__cell hbook__cell--sm hbook__cell--picker" data-cell="date">
                <label class="hbook__flabel" for="hb-date-display">{L.hbookDate}</label>
                <div class="hbook__inwrap">
                  <svg class="hbook__pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/></svg>
                  <input class="hbook__input hbook__input--picker" id="hb-date-display" type="text" placeholder={L.hbookDatePh} readonly inputmode="none" autocomplete="off" aria-haspopup="dialog" aria-expanded="false" />
                </div>
                <input type="hidden" id="hb-date" name="date" />
                <div class="hbook__pop hbook__cal" id="hb-cal" role="dialog" aria-label={L.hbookDate} hidden>
                  <div class="hbook__cal-head">
                    <button type="button" class="hbook__cal-nav" id="hb-cal-prev" aria-label={L.calPrev}>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
                    </button>
                    <div class="hbook__cal-month" id="hb-cal-month" aria-live="polite"></div>
                    <button type="button" class="hbook__cal-nav" id="hb-cal-next" aria-label={L.calNext}>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                    </button>
                  </div>
                  <div class="hbook__cal-grid" id="hb-cal-grid"></div>
                </div>
              </div>
              <div class="hbook__cell hbook__cell--sm hbook__cell--picker" data-cell="time">
                <label class="hbook__flabel" for="hb-time">{L.hbookTime}</label>
                <div class="hbook__inwrap">
                  <svg class="hbook__pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v5l3.2 1.8"/></svg>
                  <input class="hbook__input hbook__input--picker" id="hb-time" name="time" type="text" placeholder={L.hbookTimePh} inputmode="numeric" autocomplete="off" aria-haspopup="listbox" aria-expanded="false" />
                </div>
                <div class="hbook__pop hbook__times" id="hb-time-pop" role="listbox" hidden></div>
              </div>
              <div class="hbook__cell hbook__cell--sm" data-cell="flight" id="hb-flight-cell" hidden>
                <label class="hbook__flabel" for="hb-flight">{L.hbookFlight}</label>
                <input class="hbook__input" id="hb-flight" name="flight" type="text" placeholder={L.hbookFlightV} autocomplete="off" />
              </div>
            </div>

            <div class="hbook__actions">
              <button type="button" class="hbook__addstop" id="hb-addstop" data-label-add={L.hbookAddStop} data-label-stop={L.hbookStop} data-label-stopv={L.hbookStopV} data-label-remove={L.hbookRemoveStop}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                {L.hbookAddStop}
              </button>
              <button type="submit" class="hbook__cta">{L.hbookCta}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </button>
            </div>
          </form>
          {/* Cloudflare Turnstile (unsichtbar, "interaction-only") fuer die
              Adresssuche -- nur befuellt, wenn das Buchungssystem einen
              Site-Key liefert. Sichtbar nur, falls Cloudflare eine Interaktion
              verlangt. */}
          <div class="hbook__ts" id="hb-turnstile"></div>

          <div class="hbook__notice" id="hb-notice" role="alert" hidden>
            <svg class="hbook__notice-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M12 8h.01M11 12h1v4h1"/></svg>
            <div class="hbook__notice-body">
              <p class="hbook__notice-text">{L.hbookLeadNotice}</p>
              <div class="hbook__notice-links">
                <a class="hbook__notice-link" href="tel:+431941262850">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z"/></svg>
                  +43 1 941 262 850
                </a>
                <a class="hbook__notice-link hbook__notice-link--wa" href="https://wa.me/436764221825" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.4 15.17L2 22l4.95-1.3A9.9 9.9 0 1 0 12.04 2Zm0 1.8a8.1 8.1 0 1 1-4.13 15.06l-.3-.18-2.94.77.78-2.86-.2-.3A8.1 8.1 0 0 1 12.04 3.8Zm-2.6 4.02c-.15-.36-.3-.35-.45-.36h-.38c-.13 0-.35.05-.53.26-.18.2-.7.68-.7 1.66 0 .98.71 1.92.81 2.05.1.13 1.4 2.24 3.5 3.05 1.74.67 2.1.53 2.48.5.38-.04 1.22-.5 1.4-.98.17-.48.17-.9.12-.98-.05-.09-.18-.13-.38-.23-.2-.1-1.22-.6-1.4-.67-.19-.07-.33-.1-.47.1-.13.2-.53.66-.65.8-.12.13-.24.15-.44.05-.2-.1-.86-.32-1.63-1.01-.6-.54-1.01-1.2-1.13-1.4-.12-.2-.01-.31.09-.41.09-.09.2-.24.3-.36.1-.12.13-.2.2-.34.06-.13.03-.25-.02-.35-.05-.1-.44-1.12-.62-1.53Z"/></svg>
                  +43 676 422 18 25
                </a>
              </div>
            </div>
          </div>

          <template id="hb-stop-tpl">
            <div class="hbook__stop">
              <label class="hbook__flabel">{L.hbookStop}</label>
              <div class="hbook__inwrap">
                <svg class="hbook__pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="10" r="3"/><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8Z"/></svg>
                <input class="hbook__input hbook__addr hbook__stop-input" type="text" role="combobox" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false" autocomplete="one-time-code" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="search" data-lpignore="true" data-1p-ignore placeholder={L.hbookStopV} />
              </div>
              <ul class="hbook__pop hbook__ac" role="listbox" aria-label={L.hbookAcList} hidden></ul>
              <button type="button" class="hbook__stop-remove" aria-label={L.hbookRemoveStop}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
              </button>
            </div>
          </template>
        </div>
      </div>
    </section>

    <script>
      // Homepage-Schnellbuchung: Adressvorschlaege auf Von/Nach/Zwischenstopps,
      // Zwischenstopp hinzufuegen/entfernen, dann Deep-Link ins Buchungswidget
      // (/online-buchung?prefill=<JSON>). Das Widget liest den Param beim Mount,
      // befuellt Schritt 1 und springt zu Schritt 2.
      //
      // Adresssuche OHNE Google-Key im Browser: Vorschlaege und Orte kommen vom
      // VGC-Buchungssystem (Google Places API (New) serverseitig, Muster wie
      // vgc-buchung booking-widget/src/core/human.js + address-input.js):
      //   GET  /api/session              -> { turnstileSiteKey }
      //   (Turnstile unsichtbar, nur mit Site-Key)
      //   POST /api/session              -> { pass } (45 min)
      //   POST /api/places-autocomplete  -> { suggestions }
      //   POST /api/places-details       -> { place: { ..., sig } } (signiert)
      // Die Sitzung startet erst beim ersten Fokus eines Adressfelds (schont
      // den Hero-LCP). Ohne Site-Key/Pass oder bei API-Fehlern bleiben die
      // Felder normale Texteingaben; das Widget loest den Text dann selbst auf.
      // Basis-URL = dieselbe, von der BookingPage.astro das Widget laedt.
      const VGC_API = 'https://vgc-buchung-oezdemircagri-7244s-projects.vercel.app';
      const form = document.getElementById('hbook-form');
      if (form) {
        const stopsWrap = document.getElementById('hb-stops');
        const addBtn = document.getElementById('hb-addstop');
        const fromEl = document.getElementById('hb-from');
        const toEl = document.getElementById('hb-to');
        const dateEl = document.getElementById('hb-date');
        const timeEl = document.getElementById('hb-time');
        const flightCell = document.getElementById('hb-flight-cell');
        const flightInput = document.getElementById('hb-flight');
        const MAX_STOPS = 3;
        let stopSeq = 0;

        // ===== Custom Datum-/Uhrzeit-Picker (VGC) =====
        // dateEl = verstecktes Feld mit YYYY-MM-DD (fuer den Prefill-Submit),
        // dateDisplay = sichtbares, schreibgeschuetztes Feld mit TT.MM.JJJJ.
        // timeEl = Textfeld mit HH:MM (Freitext erlaubt). Kalendertage/Zeitslots
        // werden per innerHTML erzeugt und im gescopten <style> ueber :global()
        // gestyled (per createElement erzeugte Elemente bekommen Astros
        // Scope-Attribut nicht -> gescopte Klassen greifen sonst nicht).
        const MIN_LEAD_HOURS = 2;
        const TIME_INTERVAL = 15;
        const pad = (n) => String(n).padStart(2, '0');
        const dateDisplay = document.getElementById('hb-date-display');
        const calEl = document.getElementById('hb-cal');
        const calGrid = document.getElementById('hb-cal-grid');
        const calMonthLabel = document.getElementById('hb-cal-month');
        const timePop = document.getElementById('hb-time-pop');
        const notice = document.getElementById('hb-notice');
        const calMonths = JSON.parse(form.dataset.calMonths || '[]');
        const calDows = JSON.parse(form.dataset.calDows || '[]');
        const dateCell = dateEl ? dateEl.closest('.hbook__cell') : null;
        const timeCell = timeEl ? timeEl.closest('.hbook__cell') : null;
        let calCursor = new Date();
        let defaultTime = '';

        // jetzt + MIN_LEAD_HOURS, aufgerundet auf den naechsten TIME_INTERVAL.
        // strict schiebt bei exakter Rasterlage einen Schritt weiter (Default
        // entkommt so garantiert dem <2h-Live-Hinweis). Portiert aus dem
        // Buchungs-Widget (computeDefaultDateTime / computeLeadDateTime).
        function computeLeadDateTime(strict) {
          const t = new Date();
          t.setSeconds(0, 0);
          t.setHours(t.getHours() + MIN_LEAD_HOURS);
          const mins = t.getMinutes();
          let rounded = Math.ceil(mins / TIME_INTERVAL) * TIME_INTERVAL;
          if (strict && rounded === mins) rounded += TIME_INTERVAL;
          if (rounded >= 60) { t.setHours(t.getHours() + 1); t.setMinutes(rounded - 60); }
          else { t.setMinutes(rounded); }
          return t;
        }
        function computeDefaultDateTime() {
          const t = computeLeadDateTime(true);
          return {
            date: `${t.getFullYear()}-${pad(t.getMonth() + 1)}-${pad(t.getDate())}`,
            time: `${pad(t.getHours())}:${pad(t.getMinutes())}`,
          };
        }
        // HH:MM aus Freitext parsen -- akzeptiert "20:30", "2030", "830".
        function parseTimeInput(raw) {
          const c = (raw || '').trim();
          let m = c.match(/^([0-2]?\d):([0-5]\d)$/) || c.match(/^([0-2]?\d)([0-5]\d)$/);
          if (!m) return null;
          const h = parseInt(m[1], 10), mi = parseInt(m[2], 10);
          if (h > 23 || mi > 59) return null;
          return pad(h) + ':' + pad(mi);
        }
        // Gewaehltes Datum+Uhrzeit < jetzt+2h ?
        function leadBlocked() {
          const iso = dateEl ? dateEl.value : '';
          const tm = timeEl ? timeEl.value : '';
          if (!iso || !/^\d{2}:\d{2}$/.test(tm)) return false;
          const [y, mo, d] = iso.split('-').map(Number);
          const [h, mi] = tm.split(':').map(Number);
          const chosen = new Date(y, mo - 1, d, h, mi, 0, 0);
          const min = new Date(); min.setSeconds(0, 0); min.setHours(min.getHours() + MIN_LEAD_HOURS);
          return chosen.getTime() < min.getTime();
        }
        function updateNotice() {
          if (notice) notice.hidden = !leadBlocked();
        }

        function renderCal() {
          const y = calCursor.getFullYear(), m = calCursor.getMonth();
          calMonthLabel.textContent = (calMonths[m] || '') + ' ' + y;
          const firstDow = (new Date(y, m, 1).getDay() + 6) % 7; // Woche ab Montag
          const daysInMonth = new Date(y, m + 1, 0).getDate();
          const today = new Date(); today.setHours(0, 0, 0, 0);
          let html = '';
          calDows.forEach((d) => { html += '<span class="hbook__dow">' + d + '</span>'; });
          for (let i = 0; i < firstDow; i++) html += '<span class="hbook__day hbook__day--empty"></span>';
          for (let d = 1; d <= daysInMonth; d++) {
            const dt = new Date(y, m, d);
            const iso = y + '-' + pad(m + 1) + '-' + pad(d);
            let cls = 'hbook__day';
            let dis = '';
            if (dt < today) { dis = 'disabled'; cls += ' is-past'; }
            if (dt.getTime() === today.getTime()) cls += ' is-today';
            if (dateEl && dateEl.value === iso) cls += ' is-selected';
            html += '<button type="button" class="' + cls + '" data-iso="' + iso + '" ' + dis + '>' + d + '</button>';
          }
          calGrid.innerHTML = html;
          calGrid.querySelectorAll('button[data-iso]').forEach((btn) => {
            btn.addEventListener('click', () => { selectDate(btn.dataset.iso); closeCal(); });
          });
        }
        function selectDate(iso) {
          if (dateEl) dateEl.value = iso;
          const [y, mo, d] = iso.split('-');
          if (dateDisplay) dateDisplay.value = d + '.' + mo + '.' + y;
          updateNotice();
        }

        function buildTimes() {
          let html = '';
          for (let h = 0; h < 24; h++) {
            for (let mn = 0; mn < 60; mn += TIME_INTERVAL) {
              const v = pad(h) + ':' + pad(mn);
              html += '<button type="button" class="hbook__time' + (timeEl && v === timeEl.value ? ' is-selected' : '') + '" data-v="' + v + '" role="option">' + v + '</button>';
            }
          }
          timePop.innerHTML = html;
          timePop.querySelectorAll('button[data-v]').forEach((btn) => {
            // pointerdown (Maus/Pen) committet vor dem Outside-Click-Capture;
            // click deckt Touch/Tastatur ab. selectTime/closeTime sind idempotent.
            btn.addEventListener('pointerdown', (e) => {
              if (e.pointerType === 'touch') return;
              e.preventDefault(); selectTime(btn.dataset.v); closeTime();
            });
            btn.addEventListener('click', () => { selectTime(btn.dataset.v); closeTime(); });
          });
        }
        function selectTime(v) {
          if (timeEl) timeEl.value = v;
          updateNotice();
        }

        function anyPopOpen() { return (calEl && !calEl.hidden) || (timePop && !timePop.hidden); }
        function attachGlobal() {
          document.addEventListener('click', onDocClick, true);
          document.addEventListener('keydown', onEsc, true);
        }
        function detachGlobal() {
          if (!anyPopOpen()) {
            document.removeEventListener('click', onDocClick, true);
            document.removeEventListener('keydown', onEsc, true);
          }
        }
        function onDocClick(e) {
          const path = typeof e.composedPath === 'function' ? e.composedPath() : [];
          if (calEl && !calEl.hidden && !path.includes(calEl) && !path.includes(dateCell)) closeCal();
          if (timePop && !timePop.hidden && !path.includes(timePop) && !path.includes(timeCell)) closeTime();
        }
        function onEsc(e) { if (e.key === 'Escape') { closeCal(); closeTime(); } }

        function openCal() {
          if (!calEl || !calEl.hidden) return;
          closeTime();
          if (dateEl && dateEl.value) { const [yy, mm] = dateEl.value.split('-'); calCursor = new Date(+yy, +mm - 1, 1); }
          else { calCursor = new Date(); calCursor.setDate(1); }
          renderCal();
          calEl.hidden = false;
          if (dateDisplay) dateDisplay.setAttribute('aria-expanded', 'true');
          attachGlobal();
        }
        function closeCal() {
          if (!calEl || calEl.hidden) return;
          calEl.hidden = true;
          if (dateDisplay) dateDisplay.setAttribute('aria-expanded', 'false');
          detachGlobal();
        }
        function openTime() {
          if (!timePop || !timePop.hidden) return;
          closeCal();
          buildTimes();
          timePop.hidden = false;
          if (timeEl) timeEl.setAttribute('aria-expanded', 'true');
          const target = timePop.querySelector('.is-selected') || (defaultTime ? timePop.querySelector('[data-v="' + defaultTime + '"]') : null);
          if (target) timePop.scrollTop = Math.max(0, target.offsetTop - 70);
          attachGlobal();
        }
        function closeTime() {
          if (!timePop || timePop.hidden) return;
          timePop.hidden = true;
          if (timeEl) timeEl.setAttribute('aria-expanded', 'false');
          detachGlobal();
        }

        if (dateDisplay && calEl) {
          dateDisplay.addEventListener('focus', openCal);
          dateDisplay.addEventListener('click', openCal);
          const calPrev = document.getElementById('hb-cal-prev');
          const calNext = document.getElementById('hb-cal-next');
          if (calPrev) calPrev.addEventListener('click', (e) => { e.stopPropagation(); calCursor.setMonth(calCursor.getMonth() - 1); renderCal(); });
          if (calNext) calNext.addEventListener('click', (e) => { e.stopPropagation(); calCursor.setMonth(calCursor.getMonth() + 1); renderCal(); });
        }
        if (timeEl && timePop) {
          timeEl.addEventListener('focus', openTime);
          timeEl.addEventListener('input', updateNotice);
          timeEl.addEventListener('blur', () => {
            window.setTimeout(() => {
              const parsed = parseTimeInput(timeEl.value);
              if (parsed) selectTime(parsed);
              else if (timeEl.value.trim() === '') { timeEl.value = ''; updateNotice(); }
              closeTime();
            }, 120);
          });
          timeEl.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') { e.preventDefault(); const p = parseTimeInput(timeEl.value); if (p) selectTime(p); closeTime(); }
            if (e.key === 'Tab') { const p = parseTimeInput(timeEl.value); if (p) selectTime(p); closeTime(); }
          });
        }

        // Defaults beim Laden: heute (rollt mit, wenn jetzt+2h auf morgen faellt)
        // + Uhrzeit auf naechsten 15er aufgerundet (gleiche Logik wie im Widget).
        (function initDefaults() {
          const def = computeDefaultDateTime();
          defaultTime = def.time;
          const [yy, mm] = def.date.split('-');
          calCursor = new Date(+yy, +mm - 1, 1);
          selectDate(def.date);
          if (timeEl) timeEl.value = def.time;
          updateNotice();
        })();

        // Flugnummer-Feld nur zeigen, wenn die Abholadresse ein Flughafen ist.
        function updateFlight() {
          const isAir = !!pickedPlace(fromEl)?.isAirport;
          if (flightCell) flightCell.hidden = !isAir;
          if (!isAir && flightInput) flightInput.value = '';
        }

        // ===== Sitzung fuer die Adresssuche (Turnstile -> Pass) =====
        const apiLang = form.dataset.lang === 'en' ? 'en' : 'de';
        const TS_SRC = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        const TS_WAIT_STEPS = 200; // x 100 ms = max. 20 s auf das Turnstile-Token
        let humanPromise = null, sessionPromise = null;
        const PASS_RETRY_MS = 60000;
        let siteKey = null, tsToken = null, tsWidget = null, pass = null, passRetryAt = 0;
        const wait = (ms) => new Promise((r) => setTimeout(r, ms));

        function loadTurnstile() {
          if (window.turnstile) return Promise.resolve();
          return new Promise((resolve, reject) => {
            const sc = document.createElement('script');
            sc.src = TS_SRC; sc.async = true;
            sc.onload = resolve; sc.onerror = reject;
            document.head.appendChild(sc);
          });
        }
        // Einmalig: Site-Key holen, Turnstile nur MIT Site-Key laden/rendern.
        function initHuman() {
          if (!humanPromise) {
            humanPromise = (async () => {
              try {
                const r = await fetch(VGC_API + '/api/session', { method: 'GET' });
                const d = await r.json().catch(() => ({}));
                siteKey = (r.ok && d.turnstileSiteKey) || null;
              } catch { siteKey = null; }
              const mount = document.getElementById('hb-turnstile');
              if (!siteKey || !mount) return;
              try {
                await loadTurnstile();
                tsWidget = window.turnstile.render(mount, {
                  sitekey: siteKey,
                  appearance: 'interaction-only',
                  language: apiLang,
                  callback: (tk) => { tsToken = tk; },
                  'expired-callback': () => { tsToken = null; },
                  'error-callback': () => { tsToken = null; },
                });
              } catch { tsToken = null; }
            })();
          }
          return humanPromise;
        }
        // Pass per POST /api/session (mit geloestem Turnstile-Token bzw. ohne
        // Site-Key ohne Token). null = keine Adresssuche, Feld bleibt Freitext.
        function ensurePass() {
          if (pass) return Promise.resolve(pass);
          // Nach einem Fehlschlag nicht bei jedem Tastendruck erneut anfragen.
          if (Date.now() < passRetryAt) return Promise.resolve(null);
          if (!sessionPromise) {
            sessionPromise = (async () => {
              await initHuman();
              if (siteKey) {
                for (let i = 0; i < TS_WAIT_STEPS && !tsToken; i++) await wait(100);
                if (!tsToken) return null;
              }
              try {
                const r = await fetch(VGC_API + '/api/session', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(tsToken ? { turnstile_token: tsToken } : {}),
                });
                const d = await r.json().catch(() => ({}));
                if (r.ok && d.pass) pass = d.pass;
              } catch { /* kein Pass -> Freitext */ }
              // Token ist verbraucht -> fuer eine spaetere Erneuerung neu loesen lassen
              tsToken = null;
              if (tsWidget != null && window.turnstile) { try { window.turnstile.reset(tsWidget); } catch { /* noop */ } }
              return pass;
            })().finally(() => {
              sessionPromise = null;
              if (!pass) passRetryAt = Date.now() + PASS_RETRY_MS;
            });
          }
          return sessionPromise;
        }
        // POST mit Pass; bei abgelaufenem Pass (403 turnstile_required) einmal erneuern.
        async function apiPost(path, body) {
          for (let attempt = 0; attempt < 2; attempt++) {
            const p = await ensurePass();
            if (!p) return null;
            try {
              const r = await fetch(VGC_API + path, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ...body, lang: apiLang, pass: p }),
              });
              const d = await r.json().catch(() => ({}));
              if (r.status === 403 && d.turnstile_required) { pass = null; continue; }
              return r.ok ? d : null;
            } catch { return null; }
          }
          return null;
        }

        // ===== Adressfeld als ARIA-Combobox =====
        const AC_DEBOUNCE_MS = 250;
        const AC_MIN_CHARS = 2;
        const acSearching = form.dataset.acSearching || '';
        const acEmpty = form.dataset.acEmpty || '';
        const acHint = form.dataset.acHint || '';
        const acRequest = form.dataset.acRequest || '';
        const acContact = form.dataset.acContact || '/kontakt';
        const picked = new WeakMap(); // input -> signierter Ort (places-details)
        let acSeq = 0;

        function newSessionToken() {
          try { if (window.crypto?.randomUUID) return window.crypto.randomUUID(); } catch { /* Fallback */ }
          return 's' + Date.now().toString(36) + Math.random().toString(36).slice(2, 12);
        }
        function esc(v) {
          return String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }
        // Gewaehlter Ort nur, solange der Feldtext noch genau seiner Adresse entspricht.
        function pickedPlace(input) {
          const pl = input ? picked.get(input) : null;
          return pl && (input.value || '').trim() === pl.address ? pl : null;
        }

        const PIN_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="10" r="3"/><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8Z"/></svg>';
        const PLANE_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>';

        function attach(input, list) {
          if (!input || !list || input.dataset.acBound) return;
          input.dataset.acBound = '1';
          // Zufaelliger, nicht-adressartiger name bricht die Autofill-Heuristik je Feld.
          input.name = 'vgc-q-' + Math.random().toString(36).slice(2, 10);
          if (!list.id) list.id = (input.id || 'hb-addr-' + (++acSeq)) + '-list';
          input.setAttribute('aria-controls', list.id);

          let items = [], mode = 'closed', active = -1, timer = null, seq = 0, choosing = false;
          let session = newSessionToken();

          function render() {
            const open = mode !== 'closed';
            input.setAttribute('aria-expanded', String(open));
            if (!open) {
              list.hidden = true; list.innerHTML = '';
              input.removeAttribute('aria-activedescendant');
              return;
            }
            if (mode === 'loading') {
              list.innerHTML = '<li class="hbook__ac-status is-loading" role="presentation">' + esc(acSearching) + '</li>';
            } else if (mode === 'empty') {
              // Weltweite Adressen: Google findet nichts -> klare Meldung + Tipp
              // (Straße+Nr./Hotel-/Flughafenname, Ausland möglich) + Ausweg "Anfrage senden".
              list.innerHTML =
                '<li class="hbook__ac-status" role="presentation"><strong>' + esc(acEmpty) + '</strong></li>' +
                (acHint ? '<li class="hbook__ac-status hbook__ac-hint" role="presentation">' + esc(acHint) + '</li>' : '') +
                (acRequest ? '<li class="hbook__ac-status" role="presentation"><a class="hbook__ac-request" href="' + esc(acContact) + '">' + esc(acRequest) + '</a></li>' : '');
            } else {
              list.innerHTML = items.map((it, i) =>
                '<li id="' + list.id + '-opt-' + i + '" class="hbook__ac-opt' + (i === active ? ' is-active' : '') + '" role="option" aria-selected="' + (i === active) + '" data-i="' + i + '">' +
                '<span class="hbook__ac-ico" aria-hidden="true">' + (it.isAirport ? PLANE_SVG : PIN_SVG) + '</span>' +
                '<span class="hbook__ac-txt"><strong>' + esc(it.name) + '</strong>' + (it.secondary ? '<span>' + esc(it.secondary) + '</span>' : '') + '</span></li>'
              ).join('') + '<li class="hbook__ac-attr" role="presentation">Google</li>';
              if (active >= 0) {
                input.setAttribute('aria-activedescendant', list.id + '-opt-' + active);
                list.querySelector('.is-active')?.scrollIntoView({ block: 'nearest' });
              } else input.removeAttribute('aria-activedescendant');
            }
            list.hidden = false;
          }
          function setMode(next, nextItems) {
            mode = next; if (nextItems) items = nextItems; active = -1; render();
          }
          function close() { clearTimeout(timer); seq++; setMode('closed'); }

          async function search(text) {
            const mine = ++seq;
            const d = await apiPost('/api/places-autocomplete', { input: text, session_token: session });
            if (mine !== seq) return;
            // Kein Pass / API-Fehler: still schliessen, Feld bleibt Freitext.
            if (!d) { setMode('closed'); return; }
            const found = Array.isArray(d.suggestions) ? d.suggestions : [];
            setMode(found.length ? 'results' : 'empty', found);
          }
          async function choose(index) {
            const it = items[index];
            if (!it) return;
            const mine = ++seq;
            choosing = true;
            setMode('loading');
            const d = await apiPost('/api/places-details', { place_id: it.placeId, session_token: session }).finally(() => { choosing = false; });
            if (mine !== seq) return;
            const pl = d?.place;
            session = newSessionToken(); // naechster Suchvorgang = neue Google-Sitzung
            setMode('closed');
            if (!pl || !pl.sig || !pl.address) {
              // Details fehlgeschlagen: Vorschlagstext uebernehmen (Widget loest auf).
              picked.delete(input);
              input.value = [it.name, it.secondary].filter(Boolean).join(', ');
            } else {
              picked.set(input, pl);
              input.value = pl.address;
            }
            if (input === fromEl) updateFlight();
          }

          input.addEventListener('focus', () => { ensurePass(); }, { once: true });
          input.addEventListener('input', () => {
            picked.delete(input);
            if (input === fromEl) updateFlight();
            clearTimeout(timer);
            const text = input.value.trim();
            if (text.length < AC_MIN_CHARS) { close(); return; }
            // "Suche ..." nur zeigen, wenn eine Sitzung besteht (ohne API kein Flackern).
            if (pass) setMode('loading');
            timer = setTimeout(() => search(text), AC_DEBOUNCE_MS);
          });
          input.addEventListener('keydown', (e) => {
            const n = items.length;
            const nav = mode === 'results' && n > 0;
            if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
              if (!nav) return;
              e.preventDefault();
              active = e.key === 'ArrowDown' ? (active + 1) % n : (active <= 0 ? n - 1 : active - 1);
              render();
            } else if (e.key === 'Enter' && nav) {
              e.preventDefault();
              choose(active >= 0 ? active : 0);
            } else if (e.key === 'Tab' && nav && active >= 0) {
              e.preventDefault();
              choose(active);
            } else if (e.key === 'Escape' && mode !== 'closed') {
              e.preventDefault(); e.stopPropagation();
              close();
            }
          });
          input.addEventListener('blur', () => { if (!choosing) close(); });
          // mousedown verhindern: Feld behaelt beim Antippen eines Vorschlags den Fokus.
          list.addEventListener('mousedown', (e) => e.preventDefault());
          list.addEventListener('click', (e) => {
            const li = e.target.closest('[data-i]');
            if (li) choose(Number(li.dataset.i));
          });
          list.addEventListener('mousemove', (e) => {
            const li = e.target.closest('[data-i]');
            if (li && Number(li.dataset.i) !== active) {
              list.querySelector('.is-active')?.classList.remove('is-active');
              active = Number(li.dataset.i);
              li.classList.add('is-active');
            }
          });
        }

        attach(fromEl, document.getElementById('hb-from-list'));
        attach(toEl, document.getElementById('hb-to-list'));

        function stopCount() { return stopsWrap.querySelectorAll('.hbook__stop').length; }

        const stopTpl = document.getElementById('hb-stop-tpl');
        function addStop() {
          if (stopCount() >= MAX_STOPS || !stopTpl) return;
          // Aus dem <template> klonen -- so behalten die Elemente Astros
          // Scope-Attribut, das per JS erzeugte Elemente NICHT bekaemen (sonst
          // greift das gescopte CSS nicht -> unstyled/riesige Icons).
          const cell = stopTpl.content.firstElementChild.cloneNode(true);
          const id = 'hb-stop-' + (stopSeq++);
          const label = cell.querySelector('.hbook__flabel');
          const input = cell.querySelector('.hbook__stop-input');
          input.id = id; label.setAttribute('for', id);
          cell.querySelector('.hbook__stop-remove').addEventListener('click', () => { cell.remove(); addBtn.hidden = false; });
          attach(input, cell.querySelector('.hbook__ac'));
          stopsWrap.appendChild(cell);
          input.focus();
          if (stopCount() >= MAX_STOPS) addBtn.hidden = true;
        }
        if (addBtn) addBtn.addEventListener('click', addStop);

        // Uebergabe-Punkt: gewaehlter Ort komplett (inkl. Server-Signatur sig,
        // unveraendert, damit sie gueltig bleibt), sonst nur der Freitext.
        function readField(el) {
          const address = (el.value || '').trim();
          if (!address) return null;
          const pl = pickedPlace(el);
          if (!pl) return { address };
          const o = { address: pl.address, lat: pl.lat, lng: pl.lng, placeId: pl.placeId, isAirport: !!pl.isAirport, sig: pl.sig };
          if (pl.poiName) o.poiName = pl.poiName;
          if (pl.postalCode) o.postalCode = pl.postalCode;
          if (pl.city) o.city = pl.city;
          return o;
        }

        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const pickup = readField(fromEl);
          const dropoff = readField(toEl);
          if (!pickup) { fromEl.focus(); return; }
          if (!dropoff) { toEl.focus(); return; }
          // Flugnummer ist Pflicht, wenn die Abholadresse ein Flughafen ist.
          const flightVal = (flightInput?.value || '').trim();
          if (pickedPlace(fromEl)?.isAirport && !flightVal) {
            if (flightCell) { flightCell.hidden = false; flightCell.classList.add('hbook__cell--err'); }
            flightInput.addEventListener('input', () => flightCell.classList.remove('hbook__cell--err'), { once: true });
            flightInput.focus();
            return;
          }
          // 2h-Vorlaufregel: Klick bleibt erlaubt, leitet aber NICHT weiter --
          // stattdessen den Live-Hinweis einblenden/hervorheben und Fokus aufs
          // Zeitfeld setzen, damit klar ist, warum nichts passiert.
          if (leadBlocked()) {
            if (notice) {
              notice.hidden = false;
              notice.classList.remove('is-flash');
              // Reflow erzwingen, damit die Flash-Animation erneut startet.
              void notice.offsetWidth;
              notice.classList.add('is-flash');
              notice.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
            if (timeEl) timeEl.focus();
            return;
          }
          const stops = Array.from(stopsWrap.querySelectorAll('.hbook__stop-input')).map(readField).filter(Boolean);
          const prefill = { pickup, dropoff, stops };
          if (dateEl?.value) prefill.date = dateEl.value;
          if (timeEl?.value) prefill.time = timeEl.value;
          if (flightVal) prefill.flight = flightVal;
          const base = form.dataset.bookBase || '/online-buchung';
          window.location.href = base + '?prefill=' + encodeURIComponent(JSON.stringify(prefill));
        });
      }
    </script>

    <!-- ============ ÜBER UNS ============ -->
