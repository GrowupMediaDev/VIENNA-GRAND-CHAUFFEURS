<script>
  // Hero background slider — slow crossfade autoplay, pauses when tab hidden.
  const slider = document.querySelector<HTMLElement>('[data-hero-slider]');
  if (slider) {
    const slides = Array.from(slider.querySelectorAll<HTMLImageElement>('.hero__slide'));
    const reduceMo = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (slides.length > 1 && !reduceMo) {
      const HOLD = 6000; // ms each slide is shown
      let idx = 0;
      let timer: number | null = null;

      const advance = () => {
        slides[idx].classList.remove('is-active');
        idx = (idx + 1) % slides.length;
        slides[idx].classList.add('is-active');
      };
      const start = () => { if (timer === null) timer = window.setInterval(advance, HOLD); };
      const stop = () => { if (timer !== null) { clearInterval(timer); timer = null; } };

      document.addEventListener('visibilitychange', () => {
        document.hidden ? stop() : start();
      });
      start();
    }
  }
</script>
