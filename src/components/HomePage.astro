  .fcard__backtext {
    position: absolute; inset: 0; display: grid; place-items: center;
    margin: 0; padding-inline: clamp(1.4rem, 3vw, 2.2rem);
    text-align: center; z-index: 2;
    font-size: clamp(1.3rem, 1.75vw, 1.7rem); line-height: 1.3; font-weight: 600;
    color: #fff;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.22);
  }

  @media (max-width: 860px) {
    .about__inner { grid-template-columns: 1fr; row-gap: clamp(1.1rem, 3.5vw, 2rem); }
    .about__eyebrow, .about__title, .about__line, .about__body {
      grid-column: 1; grid-row: auto;
    }
    .about__eyebrow { font-size: 1.05rem; padding-block-start: 0; }
    .about__title { font-size: 2rem; margin-block-start: -0.5rem; }
    .about__line { inline-size: 80px; margin-block-start: 0; }
    .about__body { line-height: 1.62; font-size: 1rem; }
    .about__cards { gap: 1rem; }
  }
  @media (max-width: 560px) {
    .fcard { aspect-ratio: auto; block-size: 450px; }
  }

  @media (max-width: 640px) {
    .hero__title { font-size: clamp(2.2rem, 10vw, 3.2rem); }
    .hero__inner { padding-block-start: clamp(6rem, 26vh, 12rem); gap: 0.8rem; }
    .hero__cta { flex-wrap: nowrap; gap: 0.5rem; justify-content: center; margin-block-start: 1.75rem; }
    .hero__cta :global(.btn) { --px: 1rem; --py: 0.85rem; --fs: 0.9rem; gap: 0.4rem; }
    .hero__cta :global(.btn svg) { inline-size: 15px; block-size: 15px; }
  }
  @media (max-width: 380px) {
    .hero__cta :global(.btn) { --px: 0.8rem; --fs: 0.82rem; }
  }

  /* ============ WARUM VIENNA GRAND / BENEFITS ============ */
  .benefits { background: #fbf6f0; color: #0c0a08; padding-block: var(--section-py); margin-block-start: -1px; }
  .benefits__grid { display: flex; gap: 40px; align-items: stretch; }
  .benefits__col { flex: 1 1 0; min-inline-size: 0; display: flex; flex-direction: column; gap: 18px; padding-block-start: 6px; }

  .benefits__eyebrow { display: flex; align-items: center; gap: 15px; }
  .benefits__divider { inline-size: 60px; block-size: 1.429px; background: #c46a2d; opacity: 0.6; flex: none; }
  .benefits__eyebrow span:last-child {
    font-family: var(--font-display); font-weight: 600; font-size: 1.5rem;
    letter-spacing: -0.042em; text-transform: uppercase; color: #c46a2d; white-space: nowrap;
  }
  @media (max-width: 640px) {
    .benefits__eyebrow { gap: 12px; }
    .benefits__divider { inline-size: 42px; }
    .benefits__eyebrow span:last-child { font-size: 1.05rem; }
  }
  .benefits__title {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(2.3rem, 4vw, 3.5rem); line-height: 1; letter-spacing: -0.035em;
    color: #0c0a08; max-inline-size: 632px;
  }
  .benefits__intro {
    margin: 0; padding-block-start: 4px;
    font-size: 1.0625rem; line-height: 1.7; color: rgba(12, 10, 8, 0.62);
  }

  .benefits__list { list-style: none; margin: 0; padding: 10px 0 0; display: flex; flex-direction: column; }
  .benefits__item {
    display: grid; grid-template-columns: 54px minmax(0, 1fr); gap: 20px; align-items: start;
    border-block-start: 1px solid rgba(20, 15, 10, 0.12); padding-block: 21px 20px;
  }
  .benefits__item:last-child { border-block-end: 1px solid rgba(20, 15, 10, 0.12); padding-block-end: 21px; }
  .benefits__ic {
    inline-size: 54px; block-size: 54px; border-radius: 14px;
    background: rgba(196, 106, 45, 0.13); display: grid; place-items: center;
  }
  .benefits__ic img { inline-size: 24px; block-size: 24px; display: block; }
  .benefits__item-body { display: flex; flex-direction: column; gap: 5.5px; }
  .benefits__item-title { font-family: var(--font-display); font-weight: 600; font-size: 19px; letter-spacing: -0.38px; color: #0c0a08; }
  .benefits__item-text { margin: 0; font-size: 14.5px; line-height: 1.55; color: rgba(12, 10, 8, 0.62); }

  .benefits__actions { display: flex; align-items: center; gap: 20px; padding-block-start: 20px; }
  .benefits__cta {
    padding: 16px 36px; border-radius: 42px;
    background: linear-gradient(90deg, #c46a2d 0%, #e9b79a 100%);
    box-shadow: 0 10px 30px -12px rgba(196, 106, 45, 0.55), inset 0 0 0 1px rgba(255, 255, 255, 0.09);
    color: rgba(0, 0, 0, 0.9); text-decoration: none; font-weight: 500; font-size: 16px; white-space: nowrap;
    transition: filter 0.3s ease, transform 0.25s ease;
  }
  .benefits__cta:hover { filter: brightness(1.05); transform: translateY(-2px); }
  .benefits__phone {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 16px 26px; border-radius: 45px;
    background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(9.3px); -webkit-backdrop-filter: blur(9.3px);
    color: #000; text-decoration: none; font-size: 16px; white-space: nowrap;
    transition: background 0.3s ease;
  }
  .benefits__phone:hover { background: rgba(0, 0, 0, 0.09); }
  .benefits__phone svg { inline-size: 20px; block-size: 20px; }

  .benefits__media { flex: 1 1 0; min-inline-size: 0; display: flex; flex-direction: column; justify-content: flex-end; }
  .benefits__media-frame {
    position: relative;
    inline-size: 100%; aspect-ratio: 560.63 / 700.78;
    border-radius: 5px; overflow: hidden; background: #15100b;
  }
  .benefits__media-frame img { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; }

  @media (max-width: 860px) {
    .benefits__grid { flex-direction: column; gap: 2.5rem; }
    .benefits__media { justify-content: flex-start; }
    .benefits__media-frame { aspect-ratio: 1 / 1; }
    .benefits__actions { flex-wrap: wrap; }
    .benefits__title { font-size: 2rem; margin-block-start: -0.4rem; }
    .benefits__intro { font-size: 16px; line-height: 1.6; }
  }

  @media (max-width: 640px) {
    .benefits__cta, .benefits__phone {
      padding: 0.85rem 1.4rem; font-size: 0.9rem; line-height: 1; block-size: auto;
    }
    .benefits__phone svg { inline-size: 15px; block-size: 15px; }
  }

  /* ============ BOOKING BAR ============ */
  .hbook { background: var(--color-cream); color: #0c0a08; padding-block: clamp(3.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem); }
  .hbook__inner { display: flex; flex-direction: column; gap: 1rem; }
  .hbook__eyebrow { display: inline-flex; align-items: center; gap: 9px; font-family: var(--font-display); font-weight: 600; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; color: #c46a2d; }
  .hbook__dot { inline-size: 8px; block-size: 8px; border-radius: 999px; background: #c46a2d; flex: none; }
  .hbook__bar {
    display: flex; flex-direction: column; gap: 14px;
    padding: clamp(0.85rem, 1.6vw, 1.15rem);
    border-radius: 22px; background: #fff; border: 1px solid rgba(20, 15, 10, 0.12);
    box-shadow: 0 30px 70px -40px rgba(0, 0, 0, 0.5);
  }
  .hbook__row { display: flex; flex-wrap: wrap; gap: 10px; }
  .hbook__cell, .hbook__stop {
    flex: 1 1 200px; min-inline-size: 158px; position: relative;
    display: flex; flex-direction: column; gap: 4px;
    padding: 11px 16px; border-radius: 14px; background: #faf7f2;
    border: 1px solid rgba(20, 15, 10, 0.09);
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }
  .hbook__cell--sm { flex: 0 1 150px; min-inline-size: 128px; }
  .hbook__cell:focus-within, .hbook__stop:focus-within { border-color: #c46a2d; background: #fff; box-shadow: 0 0 0 3px rgba(196, 106, 45, 0.13); }
  .hbook__cell[hidden] { display: none; }
  .hbook__cell--err { border-color: #c0392b; box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.15); }
  .hbook__cell--err .hbook__flabel { color: #c0392b; }
  .hbook__flabel { font-family: var(--font-display); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: #a4531f; font-weight: 600; }
  .hbook__inwrap { display: flex; align-items: center; gap: 8px; }
  .hbook__pin { inline-size: 15px; block-size: 15px; color: #c46a2d; flex: none; opacity: 0.75; }
  .hbook__input { inline-size: 100%; min-inline-size: 0; border: none; background: transparent; padding: 0; margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 15px; color: #0c0a08; line-height: 1.35; }
  .hbook__input::placeholder { color: rgba(12, 10, 8, 0.4); font-weight: 500; }
  .hbook__input:focus { outline: none; }
  /* iOS Safari zoomt beim Fokus in ein Eingabefeld hinein, sobald dessen
     Schrift kleiner als 16px ist — auf dem Handy sprang die Startseite beim
     Antippen der Felder darum kurz in den Zoom (Reklamation Cagribey
     2026-07-22). Auf Touch-Geraeten deshalb exakt 16px; Desktop behaelt die
     kompakteren 15px, da dort kein Zoom ausgeloest wird. Dieselbe Loesung
     nutzt das grosse Buchungswidget bereits (styles/base.css.js). */
  @media (pointer: coarse) {
    .hbook__input { font-size: 16px; }
  }
  .hbook__input--picker { cursor: pointer; font-variant-numeric: tabular-nums; }
  #hb-date-display { caret-color: transparent; }

  /* ===== Datum-/Uhrzeit-Popover ===== */
  .hbook__cell--picker { position: relative; }
  .hbook__pop {
    position: absolute; z-index: 60;
    inset-block-start: calc(100% + 8px);
    inset-inline-end: 0; inset-inline-start: auto;
    display: block;
    background: #fff;
    border: 1px solid rgba(20, 15, 10, 0.12);
    border-radius: 16px;
    box-shadow: 0 24px 60px -22px rgba(40, 20, 5, 0.5), 0 4px 14px -8px rgba(0, 0, 0, 0.18);
    transform-origin: top center;
    animation: hbPop 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hbook__pop[hidden] { display: none; }
  @keyframes hbPop {
    from { opacity: 0; transform: translateY(-6px) scale(0.98); }
    to   { opacity: 1; transform: none; }
  }

  /* Kalender */
  .hbook__cal { inline-size: 296px; max-inline-size: calc(100vw - 2.5rem); padding: 14px; }
  .hbook__cal-head { display: flex; align-items: center; justify-content: space-between; margin-block-end: 10px; }
  .hbook__cal-month { font-family: var(--font-display); font-weight: 700; font-size: 15px; letter-spacing: -0.01em; color: #0c0a08; }
  .hbook__cal-nav {
    inline-size: 30px; block-size: 30px; display: inline-grid; place-items: center;
    border: 1px solid rgba(20, 15, 10, 0.12); border-radius: 9px;
    background: #faf7f2; color: #7a4a2b; cursor: pointer;
    transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }
  .hbook__cal-nav svg { inline-size: 15px; block-size: 15px; }
  .hbook__cal-nav:hover { background: rgba(196, 106, 45, 0.12); border-color: #c46a2d; color: #a4531f; }
  .hbook__cal-nav:focus-visible { outline: 2px solid #c46a2d; outline-offset: 2px; }
  .hbook__cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
  .hbook__cal-grid :global(.hbook__dow) {
    display: grid; place-items: center; block-size: 26px;
    font-family: var(--font-display); font-weight: 600; font-size: 10.5px;
    letter-spacing: 0.04em; text-transform: uppercase; color: rgba(12, 10, 8, 0.4);
  }
  .hbook__cal-grid :global(.hbook__day) {
    aspect-ratio: 1 / 1; min-block-size: 34px;
    display: grid; place-items: center;
    border: none; border-radius: 10px; background: transparent;
    font-family: var(--font-display); font-weight: 600; font-size: 13.5px;
    color: #0c0a08; cursor: pointer;
    transition: background 0.16s ease, color 0.16s ease, transform 0.16s ease;
  }
  .hbook__cal-grid :global(.hbook__day--empty) { cursor: default; }
  .hbook__cal-grid :global(.hbook__day:not(:disabled):hover) { background: rgba(196, 106, 45, 0.14); transform: translateY(-1px); }
  .hbook__cal-grid :global(.hbook__day:focus-visible) { outline: 2px solid #c46a2d; outline-offset: 1px; }
  .hbook__cal-grid :global(.hbook__day.is-today) { color: #c46a2d; box-shadow: inset 0 0 0 1px rgba(196, 106, 45, 0.45); }
  .hbook__cal-grid :global(.hbook__day.is-selected) { background: #c46a2d; color: #fff; box-shadow: none; }
  .hbook__cal-grid :global(.hbook__day.is-selected:hover) { background: #b25f26; }
  .hbook__cal-grid :global(.hbook__day.is-past) { color: rgba(12, 10, 8, 0.26); cursor: not-allowed; }

  /* Zeit-Dropdown */
  .hbook__times { inline-size: 148px; max-inline-size: calc(100vw - 2.5rem); max-block-size: 264px; overflow-y: auto; padding: 6px; scrollbar-width: thin; scrollbar-color: rgba(196, 106, 45, 0.4) transparent; }
  .hbook__times::-webkit-scrollbar { inline-size: 7px; }
  .hbook__times::-webkit-scrollbar-thumb { background: rgba(196, 106, 45, 0.35); border-radius: 4px; }
  .hbook__times :global(.hbook__time) {
    inline-size: 100%; display: block; padding: 9px 12px;
    border: none; border-radius: 9px; background: transparent;
    font-family: var(--font-display); font-weight: 600; font-size: 14px;
    color: #0c0a08; text-align: left; cursor: pointer; font-variant-numeric: tabular-nums;
    transition: background 0.14s ease, color 0.14s ease;
  }
  .hbook__times :global(.hbook__time:hover) { background: rgba(196, 106, 45, 0.12); }
  .hbook__times :global(.hbook__time.is-selected) { background: #c46a2d; color: #fff; }

  /* 2h-Vorlauf-Hinweis */
  .hbook__notice {
    display: flex; align-items: flex-start; gap: 12px;
    margin-block-start: 4px; padding: 14px 18px;
    border-radius: 16px;
    background: rgba(196, 106, 45, 0.08);
    border: 1px solid rgba(196, 106, 45, 0.28);
    color: #5c3316;
  }
  .hbook__notice[hidden] { display: none; }
  .hbook__notice.is-flash { animation: hbFlash 0.7s ease; }
  @keyframes hbFlash {
    0%, 100% { box-shadow: 0 0 0 0 rgba(196, 106, 45, 0); }
    25% { box-shadow: 0 0 0 4px rgba(196, 106, 45, 0.28); border-color: #c46a2d; }
    60% { box-shadow: 0 0 0 6px rgba(196, 106, 45, 0.12); }
  }
  .hbook__notice-ic { inline-size: 22px; block-size: 22px; color: #c46a2d; flex: none; margin-block-start: 1px; }
  .hbook__notice-body { display: flex; flex-direction: column; gap: 9px; min-inline-size: 0; }
  .hbook__notice-text { margin: 0; font-size: 14px; line-height: 1.55; color: #5c3316; }
  .hbook__notice-links { display: flex; flex-wrap: wrap; gap: 10px; }
  .hbook__notice-link {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 8px 15px; border-radius: 999px;
    background: #fff; border: 1px solid rgba(196, 106, 45, 0.4);
    color: #a4531f; text-decoration: none;
    font-family: var(--font-display); font-weight: 600; font-size: 13.5px; white-space: nowrap;
    transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }
  .hbook__notice-link:hover { background: rgba(196, 106, 45, 0.1); border-color: #c46a2d; transform: translateY(-1px); }
  .hbook__notice-link svg { inline-size: 15px; block-size: 15px; flex: none; }
  .hbook__notice-link--wa { color: #1f7a44; border-color: rgba(31, 122, 68, 0.4); }
  .hbook__notice-link--wa:hover { background: rgba(31, 122, 68, 0.1); border-color: #1f7a44; }

  /* Adressvorschlaege (eigene Liste statt Google-Dropdown). Gleicher Look
     wie Datum-/Uhrzeit-Popover; die Eintraege entstehen per innerHTML und
     werden deshalb ueber :global() gestyled. */
  .hbook__ac {
    inset-inline-start: 0; inset-inline-end: auto;
    inline-size: max(100%, 320px); max-inline-size: calc(100vw - 2.5rem);
    max-block-size: min(340px, 60vh); overflow-y: auto; overscroll-behavior: contain;
    margin: 0; padding: 6px; list-style: none;
    scrollbar-width: thin; scrollbar-color: rgba(196, 106, 45, 0.4) transparent;
  }
  .hbook__ac :global(.hbook__ac-opt) {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 10px 12px; border-radius: 10px; cursor: pointer;
    transition: background 0.14s ease;
  }
  .hbook__ac :global(.hbook__ac-opt.is-active) { background: rgba(196, 106, 45, 0.12); }
  .hbook__ac :global(.hbook__ac-ico) {
    flex: none; inline-size: 28px; block-size: 28px; display: grid; place-items: center;
    border-radius: 8px; background: #faf7f2; color: #c46a2d;
    transition: background 0.14s ease;
  }
  .hbook__ac :global(.hbook__ac-opt.is-active .hbook__ac-ico) { background: #fff; }
  .hbook__ac :global(.hbook__ac-ico svg) { inline-size: 15px; block-size: 15px; }
  .hbook__ac :global(.hbook__ac-txt) { display: flex; flex-direction: column; gap: 2px; min-inline-size: 0; }
  .hbook__ac :global(.hbook__ac-txt strong) {
    font-family: var(--font-display); font-weight: 600; font-size: 14.5px; line-height: 1.3; color: #0c0a08;
    overflow-wrap: anywhere;
  }
  .hbook__ac :global(.hbook__ac-txt span) { font-size: 12.5px; line-height: 1.35; color: rgba(12, 10, 8, 0.58); overflow-wrap: anywhere; }
  .hbook__ac :global(.hbook__ac-status) { padding: 12px 14px; font-size: 13.5px; line-height: 1.45; color: rgba(12, 10, 8, 0.62); }
  .hbook__ac :global(.hbook__ac-status strong) { color: #0c0a08; font-weight: 600; }
  .hbook__ac :global(.hbook__ac-status.is-loading) { animation: hbAcPulse 1.1s ease-in-out infinite; }
  .hbook__ac :global(.hbook__ac-hint) { padding-block: 2px 8px; font-size: 12.5px; }
  .hbook__ac :global(.hbook__ac-request) {
    display: inline-block; font-weight: 600; color: #c46a2d;
    text-decoration: underline; text-underline-offset: 2px;
  }
  .hbook__ac :global(.hbook__ac-request:hover),
  .hbook__ac :global(.hbook__ac-request:focus-visible) { color: #0c0a08; }
  .hbook__ac :global(.hbook__ac-attr) {
    padding: 6px 12px 2px; text-align: end;
    font-size: 10.5px; letter-spacing: 0.04em; color: rgba(12, 10, 8, 0.42);
  }
  @keyframes hbAcPulse { 50% { opacity: 0.55; } }
  @media (pointer: coarse) {
    .hbook__ac :global(.hbook__ac-opt) { padding-block: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hbook__ac :global(.hbook__ac-opt), .hbook__ac :global(.hbook__ac-ico) { transition: none; }
    .hbook__ac :global(.hbook__ac-status.is-loading) { animation: none; }
  }
  /* Turnstile-Mount: leer und ohne Hoehe, solange Cloudflare keine
     Interaktion verlangt. */
  .hbook__ts:empty { display: none; }

  @media (max-width: 620px) {
    .hbook__pop { inset-inline-start: 0; inset-inline-end: auto; }
    .hbook__cal { inline-size: min(320px, calc(100vw - 2.5rem)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hbook__pop { animation: none; }
    .hbook__notice.is-flash { animation: none; }
    .hbook__cal-grid :global(.hbook__day:not(:disabled):hover) { transform: none; }
    .hbook__notice-link:hover { transform: none; }
  }
  .hbook__stops { display: contents; }
  .hbook__stop { padding-inline-end: 34px; }
  .hbook__stop-remove {
    position: absolute; inset-block-start: 8px; inset-inline-end: 8px;
    inline-size: 22px; block-size: 22px; display: inline-grid; place-items: center;
    border: none; border-radius: 999px; background: rgba(20, 15, 10, 0.07); color: #7a4a2b; cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .hbook__stop-remove:hover { background: rgba(196, 106, 45, 0.18); color: #a4531f; transform: rotate(90deg); }
  .hbook__stop-remove svg { inline-size: 12px; block-size: 12px; }
  .hbook__actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .hbook__addstop { display: inline-flex; align-items: center; gap: 7px; padding: 9px 16px 9px 12px; border: 1px dashed rgba(196, 106, 45, 0.5); border-radius: 999px; background: transparent; color: #a4531f; font-family: var(--font-display); font-weight: 600; font-size: 13px; cursor: pointer; transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease; }
  .hbook__addstop svg { inline-size: 15px; block-size: 15px; }
  .hbook__addstop:hover { background: rgba(196, 106, 45, 0.08); border-color: #c46a2d; transform: translateY(-1px); }
  .hbook__addstop[hidden] { display: none; }
  .hbook__cta { margin-inline-start: auto; display: inline-flex; align-items: center; gap: 10px; padding: 14px 32px; border: none; border-radius: 999px; background: linear-gradient(90deg, #c46a2d 0%, #e9b79a 100%); color: #1a0e04; font-family: var(--font-display); font-weight: 700; font-size: 15px; white-space: nowrap; cursor: pointer; transition: filter 0.3s ease, transform 0.25s ease, box-shadow 0.3s ease; }
  .hbook__cta:hover { filter: brightness(1.05); transform: translateY(-1px); box-shadow: 0 14px 30px -14px rgba(196, 106, 45, 0.75); }
  .hbook__cta:active { transform: translateY(0); }
  .hbook__cta svg { inline-size: 17px; block-size: 17px; }
  @media (max-width: 620px) {
    .hbook__cell, .hbook__stop { flex: 1 1 100%; }
    .hbook__cell--sm { flex: 1 1 calc(50% - 5px); }
    .hbook__actions { flex-direction: column-reverse; align-items: stretch; }
