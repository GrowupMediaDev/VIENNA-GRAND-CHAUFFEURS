  .benefits__item {
    display: grid; grid-template-columns: 54px minmax(0, 1fr); gap: 20px; align-items: start;
    border-block-start: 1px solid rgba(20, 15, 10, 0.12); padding-block: 21px 20px;
  }
  .benefits__item:last-child { border-block-end: 1px solid rgba(20, 15, 10, 0.12); padding-block-end: 21px; }
  .benefits__ic {
    inline-size: 54px; block-size: 54px; border-radius: 14px;
    background: rgba(196, 106, 45, 0.13); display: grid; place-items: center;
  }
  .benefits__ic img { inline-size: 24px; block-size: 24px; display: block; }
  .benefits__item-body { display: flex; flex-direction: column; gap: 5.5px; }
  .benefits__item-title { font-family: var(--font-display); font-weight: 600; font-size: 19px; letter-spacing: -0.38px; color: #0c0a08; }
  .benefits__item-text { margin: 0; font-size: 14.5px; line-height: 1.55; color: rgba(12, 10, 8, 0.62); }

  .benefits__actions { display: flex; align-items: center; gap: 20px; padding-block-start: 20px; }
  .benefits__cta {
    padding: 16px 36px; border-radius: 42px;
    background: linear-gradient(90deg, #c46a2d 0%, #e9b79a 100%);
    box-shadow: 0 10px 30px -12px rgba(196, 106, 45, 0.55), inset 0 0 0 1px rgba(255, 255, 255, 0.09);
    color: rgba(0, 0, 0, 0.9); text-decoration: none; font-weight: 500; font-size: 16px; white-space: nowrap;
    transition: filter 0.3s ease, transform 0.25s ease;
  }
  .benefits__cta:hover { filter: brightness(1.05); transform: translateY(-2px); }
  .benefits__phone {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 16px 26px; border-radius: 45px;
    background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(9.3px); -webkit-backdrop-filter: blur(9.3px);
    color: #000; text-decoration: none; font-size: 16px; white-space: nowrap;
    transition: background 0.3s ease;
  }
  .benefits__phone:hover { background: rgba(0, 0, 0, 0.09); }
  .benefits__phone svg { inline-size: 20px; block-size: 20px; }

  .benefits__media { flex: 1 1 0; min-inline-size: 0; display: flex; flex-direction: column; justify-content: flex-end; }
  .benefits__media-frame {
    position: relative;
    inline-size: 100%; aspect-ratio: 560.63 / 700.78;
    border-radius: 5px; overflow: hidden; background: #15100b;
  }
  .benefits__media-frame img { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; }

  @media (max-width: 860px) {
    .benefits__grid { flex-direction: column; gap: 2.5rem; }
    .benefits__media { justify-content: flex-start; }
