          <template id="hb-stop-tpl">
            <div class="hbook__stop">
              <label class="hbook__flabel">{L.hbookStop}</label>
              <div class="hbook__inwrap">
                <svg class="hbook__pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="10" r="3"/><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8Z"/></svg>
                <input class="hbook__input hbook__stop-input" type="text" placeholder={L.hbookStopV} autocomplete="off" />
              </div>
              <button type="button" class="hbook__stop-remove" aria-label={L.hbookRemoveStop}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
              </button>
