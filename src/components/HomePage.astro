---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Faq from './Faq.astro';
import CtaBand from './CtaBand.astro';
import FleetShowcase from './FleetShowcase.astro';
import ServicesCarousel from './ServicesCarousel.astro';
import Button from './Button.astro';
import Picture from './Picture.astro';
import { CONTACT } from '../lib/site';
import { getLang, hrefFor, pick } from '../lib/i18n';

const lang = getLang(Astro.url);
const phoneHref = `tel:${CONTACT.phone.tel}`;
const bookHref = hrefFor('/online-buchung', lang);
const kontaktHref = hrefFor('/kontakt', lang);

const L = pick(lang,
  {
    metaTitle: 'Vienna Grand Chauffeurs — Chauffeurservice der Extraklasse',
    metaDesc: 'Premium Chauffeurservice in Wien: erfahrene, diskrete Chauffeure, gepflegte Mercedes-Benz Oberklasse und transparente Fixpreise. Flughafentransfer, Business- und Langstreckenfahrten.',
    heroTitle: 'Chauffeurservice<br />der Extraklasse',
    heroSub: 'Premium Chauffeurservice in Wien &amp; Österreich,<br />ganz nach Ihren Wünschen',
    book: 'Jetzt buchen', scrollAria: 'Nach unten scrollen',
    hbookAria: 'Online buchen', hbookEyebrow: 'Buchungssystem — wird hier eingebunden',
    hbookFrom: 'Von', hbookTo: 'Nach', hbookWhen: 'Datum & Uhrzeit',
    hbookFromV: 'Abholadresse', hbookToV: 'Zieladresse', hbookWhenV: 'Wann geht’s los?', hbookCta: 'Preis berechnen',
    aboutEyebrow: 'Über uns',
    aboutTitle: 'Unser Chauffeurservice verbindet Wiener Diskretion mit modernem Komfort',
    aboutBody: 'Professionelle Chauffeure, eine gepflegte Premiumflotte und ein durchdachter Ablauf sorgen dafür, dass Sie sich auf jeder Fahrt einfach zurücklehnen können, ob Flughafentransfer, Geschäftstermin oder Langstrecke in ganz Österreich. Pünktlichkeit, Diskretion und persönliche Betreuung begleiten Sie dabei vom ersten Kontakt bis zur Ankunft.',
    features: [
      { n: '01', label: 'Erfahrene Chauffeure', text: 'Diskret, professionell und stets zuvorkommend.', img: '/images/card-1.jpg', w: 1792, h: 2400 },
      { n: '02', label: 'Premiumflotte', text: 'Gepflegte Oberklasse-Fahrzeuge für höchsten Komfort.', img: '/images/card-2.jpg', w: 2400, h: 1792 },
      { n: '03', label: 'Pünktlich & Zuverlässig', text: 'Auf die Minute pünktlich, bei jeder Fahrt.', img: '/images/card-3.jpg', w: 1792, h: 2400 },
    ],
    benefitsAria: 'Warum Vienna Grand', benefitsEyebrow: 'Warum Vienna Grand',
    benefitsTitle: 'Erstklassiger Service,<br />auf den Sie sich verlassen können.',
    benefitsIntro: 'Bei uns steht Ihr Komfort an erster Stelle. Erfahrene Chauffeure, eine gepflegte Premiumflotte und ein durchdachter Ablauf machen jede Fahrt zu einem verlässlichen Erlebnis.',
    benefits: [
      { icon: '/images/why-1.svg', title: 'Erfahrene & diskrete Chauffeure', text: 'Geschult auf Diskretion, Sicherheit und Etikette, vom ersten Gruß bis zur Ankunft.' },
      { icon: '/images/why-2.svg', title: 'Gepflegte Premiumflotte', text: 'Eine durchweg schwarze Mercedes-Benz Oberklasse, makellos gepflegt und klimatisiert.' },
      { icon: '/images/why-3.svg', title: 'Pünktlich & rund um die Uhr', text: '365 Tage im Jahr verfügbar und auf die Minute pünktlich inklusive Flugüberwachung.' },
      { icon: '/images/why-4.svg', title: 'Transparente Fixpreise', text: 'Endpreis schon bei der Buchung, inklusive Maut, Wartezeit und MwSt., ohne Überraschungen.' },
    ],
    benefitsCta: 'Jetzt anfragen', benefitsAlt: 'Chauffeur öffnet die Fahrzeugtür einer schwarzen Mercedes-Limousine',
    htextTitle: 'Ihr Chauffeurservice in Wien — diskret, pünktlich und eine Klasse für sich.',
    htextCol1: [
      'Ein professioneller Chauffeurservice in Wien bedeutet weit mehr als eine komfortable Fahrt. Er schenkt Ihnen Zeit, Ruhe und die Gewissheit, überall pünktlich und entspannt anzukommen. Vienna Grand Chauffeurs steht für einen Premium-Service, der Diskretion, Zuverlässigkeit und echten Komfort miteinander verbindet — in Wien und ganz Österreich.',
      'Ob Flughafentransfer, Geschäftstermin, Event oder private Fahrt: Unsere erfahrenen Chauffeure sind auf Etikette, Sicherheit und ein souveränes Auftreten geschult. Sie kennen die Stadt, denken mit und passen sich flexibel Ihrem Ablauf an. So wird jede Fahrt zu einer ruhigen Etappe, in der Sie sich einfach zurücklehnen können.',
      'Unsere durchweg schwarze Mercedes-Benz Oberklasse — von der E-Klasse über die S-Klasse bis zur geräumigen V-Klasse — ist makellos gepflegt, klimatisiert und auf höchsten Komfort ausgelegt. Für jeden Anlass und jede Personenzahl finden wir das passende Fahrzeug.',
    ],
    htextCol2: [
      'Transparente Fixpreise ohne versteckte Kosten sind bei uns selbstverständlich. Sie erhalten Ihren Endpreis bereits bei der Buchung — inklusive Maut, Wartezeit und Mehrwertsteuer. So behalten Sie jederzeit die volle Kostenkontrolle, ganz ohne Überraschungen.',
      'Gerade beim Flughafentransfer zählt Verlässlichkeit: Wir überwachen Ihren Flug in Echtzeit, passen die Abholzeit flexibel an und empfangen Sie persönlich mit einem Meet & Greet Service. Kein Suchen, kein Warten — nur eine entspannte Fahrt von Tür zu Tür, rund um die Uhr und 365 Tage im Jahr.',
      'Vertrauen Sie auf einen Partner, der Diskretion und Qualität in den Mittelpunkt stellt. Buchen Sie Ihren Chauffeur bequem online oder kontaktieren Sie uns direkt — wir antworten schnell, unkompliziert und beraten Sie gerne persönlich.',
    ],
    faqs: [
      { q: 'Wie buche ich einen Flughafentransfer?', a: 'Ganz einfach online über unser Anfrageformular oder telefonisch. Nennen Sie uns Flugnummer, Datum und Adresse, Sie erhalten umgehend eine Bestätigung mit Fixpreis und allen Details.' },
      { q: 'Was passiert, wenn mein Flug Verspätung hat?', a: 'Kein Problem — wir überwachen Ihren Flug in Echtzeit und passen die Abholzeit automatisch an. Wartezeiten durch Verspätungen sind für Sie kostenfrei.' },
      { q: 'Wo wartet mein Chauffeur bei der Ankunft?', a: 'Ihr Chauffeur erwartet Sie mit Namensschild direkt in der Ankunftshalle und begleitet Sie mit Ihrem Gepäck bis zum Fahrzeug.' },
      { q: 'Ist der Preis für den Transfer festgelegt oder variabel?', a: 'Sie erhalten einen transparenten Fixpreis bereits bei der Buchung — inklusive Maut, Wartezeit und MwSt., ganz ohne versteckte Kosten.' },
      { q: 'Kann ich auch für Gruppenreisen oder viel Gepäck buchen?', a: 'Selbstverständlich. Für Gruppen und viel Gepäck steht Ihnen unsere Mercedes V-Klasse mit bis zu sieben Sitzplätzen zur Verfügung.' },
      { q: 'Welche Fahrzeuge stehen für den Flughafentransfer zur Verfügung?', a: 'Zur Wahl stehen die Mercedes E-Klasse und S-Klasse für Limousinen-Komfort sowie die V-Klasse für Gruppen und mehr Gepäck.' },
    ],
  },
  {
    metaTitle: 'Vienna Grand Chauffeurs — First-Class Chauffeur Service',
    metaDesc: 'Premium chauffeur service in Vienna: experienced, discreet chauffeurs, an immaculate Mercedes-Benz luxury fleet and transparent fixed prices. Airport transfers, business and long-distance journeys.',
    heroTitle: 'First-class<br />chauffeur service',
    heroSub: 'Premium chauffeur service in Vienna &amp; Austria,<br />entirely tailored to your wishes',
    book: 'Book now', scrollAria: 'Scroll down',
    hbookAria: 'Book online', hbookEyebrow: 'Booking system — to be embedded here',
    hbookFrom: 'From', hbookTo: 'To', hbookWhen: 'Date & time',
    hbookFromV: 'Pickup address', hbookToV: 'Destination address', hbookWhenV: 'When do you set off?', hbookCta: 'Calculate price',
    aboutEyebrow: 'About us',
    aboutTitle: 'Our chauffeur service combines Viennese discretion with modern comfort',
    aboutBody: 'Professional chauffeurs, an immaculate premium fleet and a well-thought-out process ensure that you can simply sit back on every journey — whether an airport transfer, a business appointment or a long-distance trip across Austria. Punctuality, discretion and personal care accompany you from the first contact to your arrival.',
    features: [
      { n: '01', label: 'Experienced chauffeurs', text: 'Discreet, professional and always courteous.', img: '/images/card-1.jpg', w: 1792, h: 2400 },
      { n: '02', label: 'Premium fleet', text: 'Immaculate luxury-class vehicles for the utmost comfort.', img: '/images/card-2.jpg', w: 2400, h: 1792 },
      { n: '03', label: 'Punctual & reliable', text: 'On time to the minute, on every journey.', img: '/images/card-3.jpg', w: 1792, h: 2400 },
    ],
    benefitsAria: 'Why Vienna Grand', benefitsEyebrow: 'Why Vienna Grand',
    benefitsTitle: 'First-class service<br />you can rely on.',
    benefitsIntro: 'Your comfort comes first with us. Experienced chauffeurs, an immaculate premium fleet and a well-thought-out process make every journey a dependable experience.',
    benefits: [
      { icon: '/images/why-1.svg', title: 'Experienced & discreet chauffeurs', text: 'Trained in discretion, safety and etiquette, from the first greeting to your arrival.' },
      { icon: '/images/why-2.svg', title: 'Immaculate premium fleet', text: 'An all-black Mercedes-Benz luxury class, flawlessly maintained and air-conditioned.' },
      { icon: '/images/why-3.svg', title: 'Punctual & around the clock', text: 'Available 365 days a year and on time to the minute, including flight monitoring.' },
      { icon: '/images/why-4.svg', title: 'Transparent fixed prices', text: 'Final price at the time of booking, including tolls, waiting time and VAT, with no surprises.' },
    ],
    benefitsCta: 'Request now', benefitsAlt: 'Chauffeur opening the door of a black Mercedes limousine',
    htextTitle: 'Your chauffeur service in Vienna — discreet, punctual and in a class of its own.',
    htextCol1: [
      'A professional chauffeur service in Vienna means far more than a comfortable ride. It gives you time, calm and the certainty of arriving everywhere on time and relaxed. Vienna Grand Chauffeurs stands for a premium service that combines discretion, reliability and genuine comfort — in Vienna and throughout Austria.',
      'Whether an airport transfer, a business appointment, an event or a private journey: our experienced chauffeurs are trained in etiquette, safety and a composed presence. They know the city, think ahead and adapt flexibly to your schedule. This turns every journey into a calm stage where you can simply sit back.',
      'Our all-black Mercedes-Benz luxury class — from the E-Class and the S-Class to the spacious V-Class — is flawlessly maintained, air-conditioned and designed for the utmost comfort. For every occasion and every number of passengers, we find the right vehicle.',
    ],
    htextCol2: [
      'Transparent fixed prices with no hidden costs are a matter of course with us. You receive your final price at the time of booking — including tolls, waiting time and value-added tax. This gives you full cost control at all times, with no surprises.',
      'Reliability matters most on the airport transfer: we monitor your flight in real time, adjust the pickup time flexibly and welcome you personally with a meet & greet service. No searching, no waiting — just a relaxed door-to-door journey, around the clock and 365 days a year.',
      'Rely on a partner that puts discretion and quality at the centre. Book your chauffeur conveniently online or contact us directly — we respond quickly, without fuss, and are happy to advise you personally.',
    ],
    faqs: [
      { q: 'How do I book an airport transfer?', a: 'Very easily online via our enquiry form or by phone. Give us the flight number, date and address, and you will receive an immediate confirmation with a fixed price and all the details.' },
      { q: 'What happens if my flight is delayed?', a: 'No problem — we monitor your flight in real time and adjust the pickup time automatically. Waiting time due to delays is free of charge for you.' },
      { q: 'Where does my chauffeur wait on arrival?', a: 'Your chauffeur awaits you with a name sign right in the arrivals hall and accompanies you and your luggage to the vehicle.' },
      { q: 'Is the transfer price fixed or variable?', a: 'You receive a transparent fixed price already at the time of booking — including tolls, waiting time and VAT, with no hidden costs whatsoever.' },
      { q: 'Can I also book for group travel or a lot of luggage?', a: 'Of course. For groups and a lot of luggage, our Mercedes V-Class with up to seven seats is available to you.' },
      { q: 'Which vehicles are available for the airport transfer?', a: 'You can choose the Mercedes E-Class and S-Class for limousine comfort, as well as the V-Class for groups and more luggage.' },
    ],
  });
---
<Layout title={L.metaTitle} description={L.metaDesc}>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hero-home.webp" type="image/webp" fetchpriority="high" />
  </Fragment>

  <Nav />
  <main>
    <!-- ============ HERO ============ -->
    <section class="hero" aria-labelledby="hero-title">

      <div class="hero__media" aria-hidden="true">
        <Picture src="/images/hero-home.jpg" alt="" width="2752" height="1536" fetchpriority="high" />
      </div>
      <div class="hero__scrim" aria-hidden="true"></div>

      <div class="hero__inner">
        <h1 id="hero-title" class="hero__title" data-reveal set:html={L.heroTitle}></h1>
        <p class="hero__sub" data-reveal style="--reveal-delay:0.1s" set:html={L.heroSub}></p>
        <div class="hero__cta" data-reveal style="--reveal-delay:0.2s">
          <Button href={bookHref}>{L.book}</Button>
          <Button href={phoneHref} variant="ghost-light">
            <svg slot="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z"/></svg>
            {CONTACT.phone.display}
          </Button>
        </div>
      </div>

      <svg class="hero__notch" viewBox="0 0 220 60" aria-hidden="true" preserveAspectRatio="xMidYMax meet">
        <path d="M 0 60 L 37.8 60 L 39.3 60 L 40.7 59.8 L 42.2 59.6 L 43.6 59.2 L 45 58.8 L 46.4 58.2 L 47.7 57.6 L 49 56.9 L 50.3 56.1 L 51.5 55.2 L 52.6 54.3 L 53.6 53.2 L 54.6 52.1 L 55.5 51 L 56.4 49.8 L 57.1 48.5 L 57.8 47.2 L 58.3 45.8 L 58.8 44.4 L 59.9 41.1 L 61.3 37.9 L 62.8 34.7 L 64.6 31.7 L 66.5 28.8 L 68.7 26 L 71 23.4 L 73.5 20.9 L 76.1 18.6 L 78.9 16.5 L 81.8 14.6 L 84.8 12.8 L 87.9 11.3 L 91.2 9.9 L 94.5 8.8 L 97.9 7.9 L 101.3 7.2 L 104.8 6.8 L 108.3 6.5 L 111.7 6.5 L 115.2 6.8 L 118.7 7.2 L 122.1 7.9 L 125.5 8.8 L 128.8 9.9 L 132.1 11.3 L 135.2 12.8 L 138.2 14.6 L 141.1 16.5 L 143.9 18.6 L 146.5 20.9 L 149 23.4 L 151.3 26 L 153.5 28.8 L 155.4 31.7 L 157.2 34.7 L 158.7 37.9 L 160.1 41.1 L 161.2 44.4 L 161.7 45.8 L 162.2 47.2 L 162.9 48.5 L 163.6 49.8 L 164.5 51 L 165.4 52.1 L 166.4 53.2 L 167.4 54.3 L 168.5 55.2 L 169.7 56.1 L 171 56.9 L 172.3 57.6 L 173.6 58.2 L 175 58.8 L 176.4 59.2 L 177.8 59.6 L 179.3 59.8 L 180.7 60 L 182.2 60 L 220 60 Z" fill="currentColor" />
      </svg>
      <a href="#ueber-uns" class="hero__scroll" aria-label={L.scrollAria}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </a>
    </section>

    <!-- ============ BOOKING BAR ============ -->
    <section class="hbook" aria-label={L.hbookAria}>
      <div class="container-x">
        <div class="hbook__inner" data-reveal>
          <span class="hbook__eyebrow"><span class="hbook__dot" aria-hidden="true"></span>{L.hbookEyebrow}</span>
          <div class="hbook__bar" data-booking-slot>
            <div class="hbook__field">
              <span class="hbook__flabel">{L.hbookFrom}</span>
              <span class="hbook__fval">{L.hbookFromV}</span>
            </div>
            <span class="hbook__div" aria-hidden="true"></span>
            <div class="hbook__field">
              <span class="hbook__flabel">{L.hbookTo}</span>
              <span class="hbook__fval">{L.hbookToV}</span>
            </div>
            <span class="hbook__div" aria-hidden="true"></span>
            <div class="hbook__field">
              <span class="hbook__flabel">{L.hbookWhen}</span>
              <span class="hbook__fval">{L.hbookWhenV}</span>
            </div>
            <a class="hbook__cta" href={bookHref}>{L.hbookCta}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ ÜBER UNS ============ -->
    <section id="ueber-uns" class="about section">
      <div class="container-x about__inner">
        <p class="eyebrow about__eyebrow" data-reveal>{L.aboutEyebrow}</p>
        <h2 class="about__title" data-reveal style="--reveal-delay:0.08s">{L.aboutTitle}</h2>
        <span class="about__line" data-reveal aria-hidden="true"></span>
        <p class="about__body" data-reveal style="--reveal-delay:0.12s">{L.aboutBody}</p>
      </div>

      <div class="container-x">
        <div class="about__cards">
          {L.features.map((f, i) => (
            <article class="fcard" data-reveal style={`--reveal-delay:${i * 0.1}s`}>
              <div class="fcard__inner">
                <div class="fcard__front">
                  <Picture class="fcard__img" src={f.img} alt={f.label} width={f.w} height={f.h} loading="lazy" />
                  <span class="fcard__scrim" aria-hidden="true"></span>
                  <span class="fcard__label">{f.label}</span>
                  <span class="fcard__num">{f.n}</span>
                  <p class="fcard__caption">{f.text}</p>
                </div>
                <div class="fcard__back">
                  <span class="fcard__label fcard__label--back">{f.label}</span>
                  <span class="fcard__numbg" aria-hidden="true">{f.n}</span>
                  <p class="fcard__backtext">{f.text}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ FAHRZEUGE ============ -->
    <FleetShowcase />

    <!-- ============ LEISTUNGEN ============ -->
    <ServicesCarousel />

    <!-- ============ WARUM VIENNA GRAND / BENEFITS ============ -->
    <section class="benefits" id="preise" aria-label={L.benefitsAria}>
      <div class="container-x benefits__grid">
        <div class="benefits__col" data-reveal>
          <div class="benefits__eyebrow">
            <span class="benefits__divider" aria-hidden="true"></span>
            <span>{L.benefitsEyebrow}</span>
          </div>
          <h2 class="benefits__title" set:html={L.benefitsTitle}></h2>
          <p class="benefits__intro">{L.benefitsIntro}</p>
          <ul class="benefits__list">
            {L.benefits.map((b) => (
              <li class="benefits__item">
                <span class="benefits__ic" aria-hidden="true"><img src={b.icon} alt="" width="24" height="24" /></span>
                <div class="benefits__item-body">
                  <h3 class="benefits__item-title">{b.title}</h3>
                  <p class="benefits__item-text">{b.text}</p>
                </div>
              </li>
            ))}
          </ul>
          <div class="benefits__actions">
            <a class="benefits__cta" href={kontaktHref}>{L.benefitsCta}</a>
            <a class="benefits__phone" href={phoneHref}>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z"/></svg>
              <span>{CONTACT.phone.display}</span>
            </a>
          </div>
        </div>

        <div class="benefits__media" data-reveal style="--reveal-delay:0.1s">
          <div class="benefits__media-frame">
            <Picture src="/images/why-image.jpg" alt={L.benefitsAlt} width="1792" height="2400" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- ============ SEO / LANGTEXT ============ -->
    <section class="htext" aria-labelledby="htext-title">
      <div class="container-x">
        <div class="htext__head" data-reveal>
          <div class="htext__eyebrow"><span class="htext__line" aria-hidden="true"></span><span>Vienna Grand Chauffeurs</span></div>
          <h2 class="htext__title" id="htext-title">{L.htextTitle}</h2>
        </div>
        <div class="htext__cols" data-reveal style="--reveal-delay:0.08s">
          <div class="htext__col">{L.htextCol1.map((p) => <p>{p}</p>)}</div>
          <div class="htext__col">{L.htextCol2.map((p) => <p>{p}</p>)}</div>
        </div>
      </div>
    </section>

    <Faq faqs={L.faqs} />

    <!-- ============ CTA BAND ============ -->
    <CtaBand />
  </main>
  <Footer />
</Layout>


<style is:global>
  /* Homepage runs on a warm cream canvas; the hero has a rounded bottom. */
  body { background: var(--color-cream); color: var(--color-ink); }
</style>

<style>
  .hero {
    position: relative;
    margin: 0;
    min-block-size: 100svh;
    border-radius: 0 0 clamp(20px, 2vw, 30px) clamp(20px, 2vw, 30px);
    isolation: isolate;
    color: #fff;
  }

  .hero__media,
  .hero__scrim {
    position: absolute; inset: 0;
    border-radius: inherit;
    z-index: 0;
  }
  .hero__media { overflow: hidden; }
  .hero__media img { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; object-position: 50% 55%; }
  .hero__scrim {
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(0,0,0,0.80) 34.07%,
      rgba(102,102,102,0.80) 100%
    );
    mix-blend-mode: multiply;
  }

  .hero__inner {
    position: relative; z-index: 2;
    block-size: 100%;
    min-block-size: inherit;
    display: flex; flex-direction: column; align-items: center;
    text-align: center;
    padding-inline: clamp(1.5rem, 4vw, 3rem);
    padding-block: clamp(6rem, 23vh, 14rem) clamp(4rem, 8vh, 7rem);
    gap: clamp(1.3rem, 2.4vw, 2rem);
  }
  .hero__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 6.03vw, 5.43rem);
    line-height: 1.0303;
    letter-spacing: -0.0575em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 2px 34px rgba(0,0,0,0.28);
  }
  .hero__sub {
    max-inline-size: 46ch;
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    line-height: 1.65;
    color: rgba(255,255,255,0.86);
    margin: 0;
  }
  .hero__cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.85rem; margin-block-start: 0.4rem; }

  .hero__notch {
    position: absolute; z-index: 4;
    left: 50%; bottom: -1px; transform: translateX(-50%);
    inline-size: 220px; block-size: 60px;
    color: var(--color-cream);
    pointer-events: none;
  }

  .hero__scroll {
    position: absolute; z-index: 5;
