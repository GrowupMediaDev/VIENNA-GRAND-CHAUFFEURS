---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Faq from './Faq.astro';
import CtaBand from './CtaBand.astro';
import FleetShowcase from './FleetShowcase.astro';
import ServicesCarousel from './ServicesCarousel.astro';
import Button from './Button.astro';
import { CONTACT } from '../lib/site';
import { getLang, hrefFor, pick } from '../lib/i18n';

const lang = getLang(Astro.url);
const phoneHref = `tel:${CONTACT.phonePrimary.tel}`;
const bookHref = hrefFor('/online-buchung', lang);
const kontaktHref = hrefFor('/kontakt', lang);

// Hero background slider — first slide is preloaded/eager, the rest lazy.
// Add or reorder entries here; the slider adapts automatically.
const heroSlides = [
  '/images/hero-home.jpg',
  '/images/hero-slide-2.jpg',
  '/images/hero-slide-3.jpg',
];

// Hero H1: the closing part gets its own line ("Your Chauffeur Service" /
// "in Vienna"). The split lives here rather than in the text itself, because
// L.heroTitle below is generated from content.json and would lose any markup
// on the next content update. If the marker is not found, the title renders
// in one piece.
const heroTitleTail = pick(lang, 'mit Fahrer', 'in Vienna');

const L = pick(lang,
  {
    metaTitle: 'Chauffeur Service Wien – Limousine & Transfer',
    metaDesc: 'Chauffeur Service Wien: Flughafentransfer, Limousinen und Langstreckenfahrten zum Fixpreis. Diskret, pünktlich, rund um die Uhr. Jetzt online buchen.',
    heroTitle: 'Chauffeur Service Wien mit Fahrer',
    heroSub: 'Diskret, pünktlich und zuverlässig durch Wien und darüber hinaus.',
    book: 'Jetzt buchen', discover: 'Unsere Fahrzeuge entdecken', scrollAria: 'Nach unten scrollen',
    hbookAria: 'Online buchen', hbookEyebrow: 'In 30 Sekunden zum Fixpreis',
    hbookFrom: 'Von', hbookTo: 'Nach', hbookDate: 'Datum', hbookTime: 'Uhrzeit', hbookStop: 'Zwischenstopp', hbookFlight: 'Flugnummer',
    hbookFromV: 'Abholadresse', hbookToV: 'Zieladresse', hbookStopV: 'Adresse Zwischenstopp', hbookFlightV: 'z. B. OS 052', hbookCta: 'Preis berechnen', hbookAddStop: 'Zwischenstopp hinzufügen', hbookRemoveStop: 'Zwischenstopp entfernen', hbookFlightReq: 'Bitte Flugnummer angeben (Flughafen-Abholung).',
    hbookDatePh: 'TT.MM.JJJJ', hbookTimePh: 'HH:MM',
    calPrev: 'Vorheriger Monat', calNext: 'Nächster Monat',
    calMonths: ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'],
    calDows: ['Mo','Di','Mi','Do','Fr','Sa','So'],
    hbookLeadNotice: 'Für Buchungen mit weniger als 2 Stunden Vorlaufzeit kontaktieren Sie uns bitte direkt telefonisch oder per WhatsApp — wir finden gerne kurzfristig die passende Lösung für Sie.',
    aboutEyebrow: 'Über uns',
    aboutTitle: 'Unser Chauffeurservice verbindet Wiener Diskretion mit modernem Komfort',
    aboutBody: 'Professionelle Chauffeure, eine gepflegte Premiumflotte und ein durchdachter Ablauf sorgen dafür, dass Sie sich auf jeder Fahrt einfach zurücklehnen können, ob Flughafentransfer, Geschäftstermin oder Langstrecke in ganz Österreich. Pünktlichkeit, Diskretion und persönliche Betreuung begleiten Sie dabei vom ersten Kontakt bis zur Ankunft.',
    features: [
      { n: '01', label: 'Erfahrene Chauffeure', text: 'Diskret, professionell und stets zuvorkommend.', img: '/images/card-1.jpg', w: 1792, h: 2400 },
      { n: '02', label: 'Premiumflotte', text: 'Gepflegte Oberklasse-Fahrzeuge für höchsten Komfort.', img: '/images/card-2.jpg', w: 2400, h: 1792 },
      { n: '03', label: 'Pünktlich & Zuverlässig', text: 'Auf die Minute pünktlich, bei jeder Fahrt.', img: '/images/card-3.jpg', w: 1792, h: 2400 },
    ],
    benefitsAria: 'Warum Vienna Grand', benefitsEyebrow: 'Warum Vienna Grand',
    benefitsTitle: 'Ihr Chauffeur in Wien, auf den Sie zählen',
    benefitsIntro: 'Bei uns fahren Sie mit einem festen Team geschulter Chauffeure. Wir kennen Wien, planen Ihre Route voraus und sind pünktlich zur Stelle. So bleibt Ihr Kopf frei fürs Wesentliche.',
    benefits: [
      { icon: '/images/why-1.svg', title: 'Erfahrene & diskrete Chauffeure', text: 'Geschult auf Diskretion, Sicherheit und Etikette, vom ersten Gruß bis zur Ankunft.' },
      { icon: '/images/why-2.svg', title: 'Gepflegte Premiumflotte', text: 'Eine durchweg schwarze Mercedes-Benz Oberklasse, makellos gepflegt und klimatisiert.' },
      { icon: '/images/why-3.svg', title: 'Pünktlich & rund um die Uhr', text: '365 Tage im Jahr verfügbar und auf die Minute pünktlich inklusive Flugüberwachung.' },
      { icon: '/images/why-4.svg', title: 'Transparente Fixpreise', text: 'Endpreis schon bei der Buchung, inklusive Maut, Wartezeit und MwSt., ohne Überraschungen.' },
    ],
    benefitsCta: 'Jetzt anfragen', benefitsAlt: 'Chauffeur öffnet die Fahrzeugtür einer schwarzen Mercedes-Limousine',
    htextTitle: 'Vom Flughafentransfer bis zur Langstrecke, alles inklusive',
    htextCol1: [
      'Ob Abholung am Flughafen Wien, Termin in der Stadt oder längere Fahrt: Unser Chauffeurservice Wien bringt Sie sicher und pünktlich ans Ziel. Unsere Fahrzeuge reichen von der Business-Limousine bis zum 20-Sitzer Sprinter für größere Gruppen.',
      'Für jede Fahrt wählen Sie das passende Fahrzeug und buchen es direkt online.',
      'Ihr Chauffeur Wien wartet zur vereinbarten Zeit, kennt die Route und bringt Sie ruhig ans Ziel. Auf Wunsch steht Ihnen derselbe Fahrer bei jeder Fahrt zur Verfügung, das schafft Vertrauen und macht jede Fahrt vertraut.',
    ],
    htextCol2: [
      'Die Bezahlung ist einfach, per Kreditkarte, Apple Pay oder Google Pay. Den Fixpreis sehen Sie vorab, ohne versteckte Kosten. Wer einen Chauffeur für einige Stunden braucht, bucht ihn einfach stundenweise.',
      'Unser Limousinenservice Wien reicht von der eleganten Limousine bis zum geräumigen Van, sodass für jeden Anlass das richtige Fahrzeug bereitsteht. Für Events oder Delegationen schicken Sie eine Gruppenanfrage und erhalten innerhalb weniger Stunden ein Angebot.',
      'So unkompliziert ist Ihr Chauffeurservice Wien. Vom ersten Kontakt bis zur Ankunft kümmern wir uns um jedes Detail Ihrer Fahrt, damit Sie sich zurücklehnen und die Zeit für sich nutzen',
    ],
    faqs: [
      { q: 'Was kostet ein Chauffeur Service in Wien?', a: 'Der Preis richtet sich nach Fahrzeug, Dauer und Strecke. Sie sehen den Fixpreis vor der Buchung, inklusive Fahrer, Fahrzeug und allen Nebenkosten.' },
      { q: 'Kann ich online buchen und bezahlen?', a: 'Ja. Sie wählen Ihr Fahrzeug, sehen den Preis und zahlen per Kreditkarte, Apple Pay oder Google Pay. Die Bestätigung kommt sofort.' },
      { q: 'Sind Sie rund um die Uhr erreichbar?', a: 'Ja, unser Chauffeur Service in Wien ist 24 Stunden am Tag verfügbar, auch an Wochenenden und Feiertagen. Wir empfehlen eine Buchung im Voraus.' },
      { q: 'Bieten Sie auch Fahrten für Gruppen an?', a: 'Ja. Vom Van bis zum Sprinter mit bis zu 20 Sitzen bringen wir auch größere Gruppen zuverlässig ans Ziel. Stellen Sie einfach eine Anfrage.' },
      { q: 'Fahren Sie auch außerhalb von Wien?', a: 'Ja, wir übernehmen Langstreckenfahrten in ganz Österreich und ins benachbarte Ausland, etwa nach Bratislava, Prag oder Budapest.' },
      { q: 'Wie weit im Voraus sollte ich buchen?', a: 'Für Flughafentransfers genügen oft wenige Stunden. Für Gruppen, Events oder mehrtägige Fahrten empfehlen wir eine frühzeitige Reservierung.' },
    ],
  },
  {
    metaTitle: 'Chauffeur Service Vienna – Limousine & Transfer',
    metaDesc: 'Chauffeur service in Vienna: airport transfers, limousines and long-distance rides at a fixed price. Discreet, punctual, around the clock. Book online now.',
    heroTitle: 'Your Chauffeur Service in Vienna',
    heroSub: 'Discreet, punctual and reliable across Vienna and beyond.',
    book: 'Book now', discover: 'Discover our vehicles', scrollAria: 'Scroll down',
    hbookAria: 'Book online', hbookEyebrow: 'Your fixed price in 30 seconds',
    hbookFrom: 'From', hbookTo: 'To', hbookDate: 'Date', hbookTime: 'Time', hbookStop: 'Stop', hbookFlight: 'Flight no.',
    hbookFromV: 'Pickup address', hbookToV: 'Destination address', hbookStopV: 'Stop address', hbookFlightV: 'e.g. OS 052', hbookCta: 'Calculate price', hbookAddStop: 'Add stop', hbookRemoveStop: 'Remove stop', hbookFlightReq: 'Please enter the flight number (airport pickup).',
    hbookDatePh: 'DD.MM.YYYY', hbookTimePh: 'HH:MM',
    calPrev: 'Previous month', calNext: 'Next month',
    calMonths: ['January','February','March','April','May','June','July','August','September','October','November','December'],
    calDows: ['Mo','Tu','We','Th','Fr','Sa','Su'],
    hbookLeadNotice: 'For bookings with less than 2 hours lead time, please contact us directly by phone or WhatsApp — we are happy to find a short-notice solution for you.',
    aboutEyebrow: 'About us',
    aboutTitle: 'Our chauffeur service combines Viennese discretion with modern comfort',
    aboutBody: 'Professional chauffeurs, an immaculate premium fleet and a well-thought-out process ensure that you can simply sit back on every journey — whether an airport transfer, a business appointment or a long-distance trip across Austria. Punctuality, discretion and personal care accompany you from the first contact to your arrival.',
    features: [
      { n: '01', label: 'Experienced chauffeurs', text: 'Discreet, professional and always courteous.', img: '/images/card-1.jpg', w: 1792, h: 2400 },
      { n: '02', label: 'Premium fleet', text: 'Immaculate luxury-class vehicles for the utmost comfort.', img: '/images/card-2.jpg', w: 2400, h: 1792 },
      { n: '03', label: 'Punctual & reliable', text: 'On time to the minute, on every journey.', img: '/images/card-3.jpg', w: 1792, h: 2400 },
    ],
    benefitsAria: 'Why Vienna Grand', benefitsEyebrow: 'Why Vienna Grand',
    benefitsTitle: 'Your chauffeur service Vienna, always reliable',
    benefitsIntro: 'You ride with a fixed team of trained chauffeurs who know Vienna well, plan your route ahead and are always there on time. That leaves your mind free for what truly matters.',
    benefits: [
      { icon: '/images/why-1.svg', title: 'Experienced & discreet chauffeurs', text: 'Trained in discretion, safety and etiquette, from the first greeting to your arrival.' },
      { icon: '/images/why-2.svg', title: 'Immaculate premium fleet', text: 'An all-black Mercedes-Benz luxury class, flawlessly maintained and air-conditioned.' },
      { icon: '/images/why-3.svg', title: 'Punctual & around the clock', text: 'Available 365 days a year and on time to the minute, including flight monitoring.' },
      { icon: '/images/why-4.svg', title: 'Transparent fixed prices', text: 'Final price at the time of booking, including tolls, waiting time and VAT, with no surprises.' },
    ],
    benefitsCta: 'Request now', benefitsAlt: 'Chauffeur opening the door of a black Mercedes limousine',
    htextTitle: 'From airport transfer to long-distance, all included',
    htextCol1: [
      'Whether a pickup at Vienna Airport, a meeting in the city or a longer ride, your chauffeur Vienna brings you there safely and in comfort. Our fleet ranges from the business limousine to the 20-seater Sprinter for larger groups.',
      'For every trip you pick the right vehicle and book it directly online. On request, the same private driver Vienna clients trust is available for every ride, waiting at the agreed time and knowing the route, which builds trust and makes each journey feel familiar.',
      'Payment is easy, by credit card, Apple Pay or Google Pay. You see the fixed price in advance, with no hidden costs.',
    ],
    htextCol2: [
      'Anyone who needs a chauffeur for a few hours simply books by the hour. For events or delegations you send a group request and receive a quote within a few hours.',
      'That is how straightforward your chauffeur service Vienna is, from a limousine service Vienna clients rely on to a discreet VIP transfer Vienna guests remember. From the first contact to arrival we handle every detail, so you can lean back and use the time for yourself.',
      'In every car you will find water, and your driver is happy to help with your luggage and knows the quickest routes through the city, so you always arrive relaxed and on time.',
    ],
    faqs: [
      { q: 'What does a chauffeur service in Vienna cost?', a: 'The price depends on vehicle, duration and route. You see the fixed price before booking, including driver, vehicle and all extras.' },
      { q: 'Can I book and pay online?', a: 'Yes. You choose your vehicle, see the price and pay by credit card, Apple Pay or Google Pay. Confirmation is immediate.' },
      { q: 'Are you available around the clock?', a: 'Yes, our chauffeur service in Vienna is available 24 hours a day, including weekends and holidays. We recommend booking ahead.' },
      { q: 'Do you offer rides for groups?', a: 'Yes. From the van to the 20-seater Sprinter, we bring larger groups to their destination reliably. Simply send a request.' },
      { q: 'Do you also drive outside Vienna?', a: 'Yes, we handle long-distance rides across Austria and to neighbouring countries such as Bratislava, Prague or Budapest.' },
      { q: 'How far in advance should I book?', a: 'For airport transfers a few hours often suffice. For groups, events or multi-day trips we recommend booking early.' },
    ],
  });

const tailAt = L.heroTitle.lastIndexOf(heroTitleTail);
const heroTitleHead = tailAt > 0 ? L.heroTitle.slice(0, tailAt).trimEnd() : L.heroTitle;
// Keep the separating space inside the second line so the heading still reads
// as one sentence for screen readers and text extraction. Leading whitespace
// at the start of a block box is collapsed, so nothing shifts visually.
const heroTitleRest = tailAt > 0 ? ' ' + L.heroTitle.slice(tailAt) : '';
---
<Layout title={L.metaTitle} description={L.metaDesc}>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hero-home.jpg" fetchpriority="high" />
  </Fragment>

  <Nav />
  <main>
    <!-- ============ HERO ============ -->
    <section class="hero" aria-labelledby="hero-title">

      <div class="hero__media" data-hero-slider aria-hidden="true">
        {heroSlides.map((src, i) => (
          <img
            src={src}
            alt=""
            width="2000"
            height="1116"
            class:list={['hero__slide', { 'is-active': i === 0 }]}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            decoding="async"
          />
        ))}
      </div>
      <div class="hero__scrim" aria-hidden="true"></div>

      <div class="hero__inner">
        <h1 id="hero-title" class="hero__title" data-reveal>
          <span class="hero__title-line">{heroTitleHead}</span>
          {heroTitleRest && <span class="hero__title-line">{heroTitleRest}</span>}
        </h1>
        <p class="hero__sub" data-reveal style="--reveal-delay:0.1s" set:html={L.heroSub}></p>
        <div class="hero__cta" data-reveal style="--reveal-delay:0.2s">
          <Button href={bookHref}>{L.book}</Button>
          <Button href={phoneHref} variant="ghost-light">
            <svg slot="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z"/></svg>
            {CONTACT.phonePrimary.display}
          </Button>
        </div>
        <a class="hero__discover" href="#fahrzeuge" data-reveal style="--reveal-delay:0.3s">
          {L.discover}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        </a>
      </div>

      <svg class="hero__notch" viewBox="0 0 220 60" aria-hidden="true" preserveAspectRatio="xMidYMax meet">
        <path d="M 0 60 L 37.8 60 L 39.3 60 L 40.7 59.8 L 42.2 59.6 L 43.6 59.2 L 45 58.8 L 46.4 58.2 L 47.7 57.6 L 49 56.9 L 50.3 56.1 L 51.5 55.2 L 52.6 54.3 L 53.6 53.2 L 54.6 52.1 L 55.5 51 L 56.4 49.8 L 57.1 48.5 L 57.8 47.2 L 58.3 45.8 L 58.8 44.4 L 59.9 41.1 L 61.3 37.9 L 62.8 34.7 L 64.6 31.7 L 66.5 28.8 L 68.7 26 L 71 23.4 L 73.5 20.9 L 76.1 18.6 L 78.9 16.5 L 81.8 14.6 L 84.8 12.8 L 87.9 11.3 L 91.2 9.9 L 94.5 8.8 L 97.9 7.9 L 101.3 7.2 L 104.8 6.8 L 108.3 6.5 L 111.7 6.5 L 115.2 6.8 L 118.7 7.2 L 122.1 7.9 L 125.5 8.8 L 128.8 9.9 L 132.1 11.3 L 135.2 12.8 L 138.2 14.6 L 141.1 16.5 L 143.9 18.6 L 146.5 20.9 L 149 23.4 L 151.3 26 L 153.5 28.8 L 155.4 31.7 L 157.2 34.7 L 158.7 37.9 L 160.1 41.1 L 161.2 44.4 L 161.7 45.8 L 162.2 47.2 L 162.9 48.5 L 163.6 49.8 L 164.5 51 L 165.4 52.1 L 166.4 53.2 L 167.4 54.3 L 168.5 55.2 L 169.7 56.1 L 171 56.9 L 172.3 57.6 L 173.6 58.2 L 175 58.8 L 176.4 59.2 L 177.8 59.6 L 179.3 59.8 L 180.7 60 L 182.2 60 L 220 60 Z" fill="currentColor" />
      </svg>
      <a href="#ueber-uns" class="hero__scroll" aria-label={L.scrollAria}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </a>
    </section>

    <!-- ============ BOOKING BAR ============ -->
    <section class="hbook" aria-label={L.hbookAria}>
      <div class="container-x">
        <div class="hbook__inner" data-reveal>
          <span class="hbook__eyebrow"><span class="hbook__dot" aria-hidden="true"></span>{L.hbookEyebrow}</span>
          <form class="hbook__bar" id="hbook-form" data-book-base={bookHref} data-flight-req={L.hbookFlightReq} data-cal-months={JSON.stringify(L.calMonths)} data-cal-dows={JSON.stringify(L.calDows)} novalidate>
            <div class="hbook__row">
              <div class="hbook__cell" data-cell="from">
                <label class="hbook__flabel" for="hb-from">{L.hbookFrom}</label>
                <div class="hbook__inwrap">
                  <svg class="hbook__pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="10" r="3"/><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8Z"/></svg>
                  <input class="hbook__input" id="hb-from" name="from" type="text" placeholder={L.hbookFromV} autocomplete="off" data-lat="" data-lng="" data-airport="" />
                </div>
              </div>

              <div class="hbook__stops" id="hb-stops"></div>

              <div class="hbook__cell" data-cell="to">
                <label class="hbook__flabel" for="hb-to">{L.hbookTo}</label>
                <div class="hbook__inwrap">
                  <svg class="hbook__pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  <input class="hbook__input" id="hb-to" name="to" type="text" placeholder={L.hbookToV} autocomplete="off" data-lat="" data-lng="" data-airport="" />
                </div>
              </div>

              <div class="hbook__cell hbook__cell--sm hbook__cell--picker" data-cell="date">
                <label class="hbook__flabel" for="hb-date-display">{L.hbookDate}</label>
                <div class="hbook__inwrap">
                  <svg class="hbook__pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M3 9h18M8 2.5v4M16 2.5v4"/></svg>
                  <input class="hbook__input hbook__input--picker" id="hb-date-display" type="text" placeholder={L.hbookDatePh} readonly inputmode="none" autocomplete="off" aria-haspopup="dialog" aria-expanded="false" />
                </div>
                <input type="hidden" id="hb-date" name="date" />
                <div class="hbook__pop hbook__cal" id="hb-cal" role="dialog" aria-label={L.hbookDate} hidden>
                  <div class="hbook__cal-head">
                    <button type="button" class="hbook__cal-nav" id="hb-cal-prev" aria-label={L.calPrev}>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
                    </button>
                    <div class="hbook__cal-month" id="hb-cal-month" aria-live="polite"></div>
                    <button type="button" class="hbook__cal-nav" id="hb-cal-next" aria-label={L.calNext}>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                    </button>
                  </div>
                  <div class="hbook__cal-grid" id="hb-cal-grid"></div>
                </div>
              </div>
              <div class="hbook__cell hbook__cell--sm hbook__cell--picker" data-cell="time">
                <label class="hbook__flabel" for="hb-time">{L.hbookTime}</label>
                <div class="hbook__inwrap">
                  <svg class="hbook__pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v5l3.2 1.8"/></svg>
                  <input class="hbook__input hbook__input--picker" id="hb-time" name="time" type="text" placeholder={L.hbookTimePh} inputmode="numeric" autocomplete="off" aria-haspopup="listbox" aria-expanded="false" />
                </div>
                <div class="hbook__pop hbook__times" id="hb-time-pop" role="listbox" hidden></div>
              </div>
              <div class="hbook__cell hbook__cell--sm" data-cell="flight" id="hb-flight-cell" hidden>
                <label class="hbook__flabel" for="hb-flight">{L.hbookFlight}</label>
                <input class="hbook__input" id="hb-flight" name="flight" type="text" placeholder={L.hbookFlightV} autocomplete="off" />
              </div>
            </div>

            <div class="hbook__actions">
              <button type="button" class="hbook__addstop" id="hb-addstop" data-label-add={L.hbookAddStop} data-label-stop={L.hbookStop} data-label-stopv={L.hbookStopV} data-label-remove={L.hbookRemoveStop}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                {L.hbookAddStop}
              </button>
              <button type="submit" class="hbook__cta">{L.hbookCta}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </button>
            </div>
          </form>

          <div class="hbook__notice" id="hb-notice" role="alert" hidden>
            <svg class="hbook__notice-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M12 8h.01M11 12h1v4h1"/></svg>
            <div class="hbook__notice-body">
              <p class="hbook__notice-text">{L.hbookLeadNotice}</p>
              <div class="hbook__notice-links">
                <a class="hbook__notice-link" href="tel:+431941262850">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z"/></svg>
                  +43 1 941 262 850
                </a>
                <a class="hbook__notice-link hbook__notice-link--wa" href="https://wa.me/436764221825" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.4 15.17L2 22l4.95-1.3A9.9 9.9 0 1 0 12.04 2Zm0 1.8a8.1 8.1 0 1 1-4.13 15.06l-.3-.18-2.94.77.78-2.86-.2-.3A8.1 8.1 0 0 1 12.04 3.8Zm-2.6 4.02c-.15-.36-.3-.35-.45-.36h-.38c-.13 0-.35.05-.53.26-.18.2-.7.68-.7 1.66 0 .98.71 1.92.81 2.05.1.13 1.4 2.24 3.5 3.05 1.74.67 2.1.53 2.48.5.38-.04 1.22-.5 1.4-.98.17-.48.17-.9.12-.98-.05-.09-.18-.13-.38-.23-.2-.1-1.22-.6-1.4-.67-.19-.07-.33-.1-.47.1-.13.2-.53.66-.65.8-.12.13-.24.15-.44.05-.2-.1-.86-.32-1.63-1.01-.6-.54-1.01-1.2-1.13-1.4-.12-.2-.01-.31.09-.41.09-.09.2-.24.3-.36.1-.12.13-.2.2-.34.06-.13.03-.25-.02-.35-.05-.1-.44-1.12-.62-1.53Z"/></svg>
                  +43 676 422 18 25
