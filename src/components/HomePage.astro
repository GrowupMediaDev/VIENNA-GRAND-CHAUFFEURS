    <script>
      // Homepage-Schnellbuchung: Google Places auf Von/Nach/Zwischenstopps,
      // Zwischenstopp hinzufuegen/entfernen, dann Deep-Link ins Buchungswidget
      // (/online-buchung?prefill=<JSON>). Das Widget liest den Param beim Mount,
      // befuellt Schritt 1 und springt zu Schritt 2. Maps laedt lazy beim ersten
      // Fokus (schont Hero-LCP). Ohne Maps: reiner Text-Prefill (Widget faengt ab).
      const GOOGLE_MAPS_KEY = 'AIzaSyA8CwHhxiR9ZUdyCkGcbfePvEGl2e6mgj4';
      const form = document.getElementById('hbook-form');
      if (form) {
        const stopsWrap = document.getElementById('hb-stops');
        const addBtn = document.getElementById('hb-addstop');
        const fromEl = document.getElementById('hb-from');
        const toEl = document.getElementById('hb-to');
        const dateEl = document.getElementById('hb-date');
        const timeEl = document.getElementById('hb-time');
        const flightCell = document.getElementById('hb-flight-cell');
        const flightInput = document.getElementById('hb-flight');
        const MAX_STOPS = 3;
        let mapsPromise = null, stopSeq = 0;

        // ===== Custom Datum-/Uhrzeit-Picker (VGC) =====
        // dateEl = verstecktes Feld mit YYYY-MM-DD (fuer den Prefill-Submit),
        // dateDisplay = sichtbares, schreibgeschuetztes Feld mit TT.MM.JJJJ.
        // timeEl = Textfeld mit HH:MM (Freitext erlaubt). Kalendertage/Zeitslots
        // werden per innerHTML erzeugt und im gescopten <style> ueber :global()
        // gestyled (per createElement erzeugte Elemente bekommen Astros
        // Scope-Attribut nicht -> gescopte Klassen greifen sonst nicht).
        const MIN_LEAD_HOURS = 2;
        const TIME_INTERVAL = 15;
        const pad = (n) => String(n).padStart(2, '0');
        const dateDisplay = document.getElementById('hb-date-display');
        const calEl = document.getElementById('hb-cal');
        const calGrid = document.getElementById('hb-cal-grid');
        const calMonthLabel = document.getElementById('hb-cal-month');
        const timePop = document.getElementById('hb-time-pop');
        const notice = document.getElementById('hb-notice');
        const calMonths = JSON.parse(form.dataset.calMonths || '[]');
        const calDows = JSON.parse(form.dataset.calDows || '[]');
        const dateCell = dateEl ? dateEl.closest('.hbook__cell') : null;
        const timeCell = timeEl ? timeEl.closest('.hbook__cell') : null;
        let calCursor = new Date();
        let defaultTime = '';

        // jetzt + MIN_LEAD_HOURS, aufgerundet auf den naechsten TIME_INTERVAL.
        // strict schiebt bei exakter Rasterlage einen Schritt weiter (Default
        // entkommt so garantiert dem <2h-Live-Hinweis). Portiert aus dem
        // Buchungs-Widget (computeDefaultDateTime / computeLeadDateTime).
        function computeLeadDateTime(strict) {
          const t = new Date();
          t.setSeconds(0, 0);
          t.setHours(t.getHours() + MIN_LEAD_HOURS);
          const mins = t.getMinutes();
          let rounded = Math.ceil(mins / TIME_INTERVAL) * TIME_INTERVAL;
          if (strict && rounded === mins) rounded += TIME_INTERVAL;
          if (rounded >= 60) { t.setHours(t.getHours() + 1); t.setMinutes(rounded - 60); }
          else { t.setMinutes(rounded); }
          return t;
        }
        function computeDefaultDateTime() {
          const t = computeLeadDateTime(true);
          return {
            date: `${t.getFullYear()}-${pad(t.getMonth() + 1)}-${pad(t.getDate())}`,
            time: `${pad(t.getHours())}:${pad(t.getMinutes())}`,
          };
        }
        // HH:MM aus Freitext parsen -- akzeptiert "20:30", "2030", "830".
        function parseTimeInput(raw) {
          const c = (raw || '').trim();
          let m = c.match(/^([0-2]?\d):([0-5]\d)$/) || c.match(/^([0-2]?\d)([0-5]\d)$/);
          if (!m) return null;
          const h = parseInt(m[1], 10), mi = parseInt(m[2], 10);
          if (h > 23 || mi > 59) return null;
          return pad(h) + ':' + pad(mi);
        }
        // Gewaehltes Datum+Uhrzeit < jetzt+2h ?
        function leadBlocked() {
          const iso = dateEl ? dateEl.value : '';
          const tm = timeEl ? timeEl.value : '';
          if (!iso || !/^\d{2}:\d{2}$/.test(tm)) return false;
          const [y, mo, d] = iso.split('-').map(Number);
          const [h, mi] = tm.split(':').map(Number);
          const chosen = new Date(y, mo - 1, d, h, mi, 0, 0);
          const min = new Date(); min.setSeconds(0, 0); min.setHours(min.getHours() + MIN_LEAD_HOURS);
          return chosen.getTime() < min.getTime();
        }
        function updateNotice() {
          if (notice) notice.hidden = !leadBlocked();
        }

        function renderCal() {
          const y = calCursor.getFullYear(), m = calCursor.getMonth();
          calMonthLabel.textContent = (calMonths[m] || '') + ' ' + y;
          const firstDow = (new Date(y, m, 1).getDay() + 6) % 7; // Woche ab Montag
          const daysInMonth = new Date(y, m + 1, 0).getDate();
          const today = new Date(); today.setHours(0, 0, 0, 0);
          let html = '';
          calDows.forEach((d) => { html += '<span class="hbook__dow">' + d + '</span>'; });
          for (let i = 0; i < firstDow; i++) html += '<span class="hbook__day hbook__day--empty"></span>';
          for (let d = 1; d <= daysInMonth; d++) {
            const dt = new Date(y, m, d);
            const iso = y + '-' + pad(m + 1) + '-' + pad(d);
            let cls = 'hbook__day';
            let dis = '';
            if (dt < today) { dis = 'disabled'; cls += ' is-past'; }
            if (dt.getTime() === today.getTime()) cls += ' is-today';
            if (dateEl && dateEl.value === iso) cls += ' is-selected';
            html += '<button type="button" class="' + cls + '" data-iso="' + iso + '" ' + dis + '>' + d + '</button>';
          }
          calGrid.innerHTML = html;
          calGrid.querySelectorAll('button[data-iso]').forEach((btn) => {
            btn.addEventListener('click', () => { selectDate(btn.dataset.iso); closeCal(); });
          });
        }
        function selectDate(iso) {
          if (dateEl) dateEl.value = iso;
          const [y, mo, d] = iso.split('-');
          if (dateDisplay) dateDisplay.value = d + '.' + mo + '.' + y;
          updateNotice();
        }

        function buildTimes() {
          let html = '';
          for (let h = 0; h < 24; h++) {
            for (let mn = 0; mn < 60; mn += TIME_INTERVAL) {
              const v = pad(h) + ':' + pad(mn);
              html += '<button type="button" class="hbook__time' + (timeEl && v === timeEl.value ? ' is-selected' : '') + '" data-v="' + v + '" role="option">' + v + '</button>';
            }
          }
          timePop.innerHTML = html;
          timePop.querySelectorAll('button[data-v]').forEach((btn) => {
            // pointerdown (Maus/Pen) committet vor dem Outside-Click-Capture;
            // click deckt Touch/Tastatur ab. selectTime/closeTime sind idempotent.
            btn.addEventListener('pointerdown', (e) => {
              if (e.pointerType === 'touch') return;
              e.preventDefault(); selectTime(btn.dataset.v); closeTime();
            });
            btn.addEventListener('click', () => { selectTime(btn.dataset.v); closeTime(); });
          });
        }
        function selectTime(v) {
          if (timeEl) timeEl.value = v;
          updateNotice();
        }

        function anyPopOpen() { return (calEl && !calEl.hidden) || (timePop && !timePop.hidden); }
        function attachGlobal() {
          document.addEventListener('click', onDocClick, true);
          document.addEventListener('keydown', onEsc, true);
        }
        function detachGlobal() {
          if (!anyPopOpen()) {
            document.removeEventListener('click', onDocClick, true);
            document.removeEventListener('keydown', onEsc, true);
          }
        }
        function onDocClick(e) {
          const path = typeof e.composedPath === 'function' ? e.composedPath() : [];
          if (calEl && !calEl.hidden && !path.includes(calEl) && !path.includes(dateCell)) closeCal();
          if (timePop && !timePop.hidden && !path.includes(timePop) && !path.includes(timeCell)) closeTime();
        }
        function onEsc(e) { if (e.key === 'Escape') { closeCal(); closeTime(); } }

        function openCal() {
          if (!calEl || !calEl.hidden) return;
          closeTime();
          if (dateEl && dateEl.value) { const [yy, mm] = dateEl.value.split('-'); calCursor = new Date(+yy, +mm - 1, 1); }
          else { calCursor = new Date(); calCursor.setDate(1); }
          renderCal();
          calEl.hidden = false;
          if (dateDisplay) dateDisplay.setAttribute('aria-expanded', 'true');
          attachGlobal();
        }
        function closeCal() {
          if (!calEl || calEl.hidden) return;
          calEl.hidden = true;
          if (dateDisplay) dateDisplay.setAttribute('aria-expanded', 'false');
          detachGlobal();
        }
        function openTime() {
          if (!timePop || !timePop.hidden) return;
          closeCal();
          buildTimes();
          timePop.hidden = false;
          if (timeEl) timeEl.setAttribute('aria-expanded', 'true');
          const target = timePop.querySelector('.is-selected') || (defaultTime ? timePop.querySelector('[data-v="' + defaultTime + '"]') : null);
          if (target) timePop.scrollTop = Math.max(0, target.offsetTop - 70);
          attachGlobal();
        }
        function closeTime() {
          if (!timePop || timePop.hidden) return;
          timePop.hidden = true;
          if (timeEl) timeEl.setAttribute('aria-expanded', 'false');
          detachGlobal();
        }

        if (dateDisplay && calEl) {
          dateDisplay.addEventListener('focus', openCal);
          dateDisplay.addEventListener('click', openCal);
          const calPrev = document.getElementById('hb-cal-prev');
          const calNext = document.getElementById('hb-cal-next');
          if (calPrev) calPrev.addEventListener('click', (e) => { e.stopPropagation(); calCursor.setMonth(calCursor.getMonth() - 1); renderCal(); });
          if (calNext) calNext.addEventListener('click', (e) => { e.stopPropagation(); calCursor.setMonth(calCursor.getMonth() + 1); renderCal(); });
        }
        if (timeEl && timePop) {
          timeEl.addEventListener('focus', openTime);
          timeEl.addEventListener('input', updateNotice);
          timeEl.addEventListener('blur', () => {
            window.setTimeout(() => {
              const parsed = parseTimeInput(timeEl.value);
              if (parsed) selectTime(parsed);
              else if (timeEl.value.trim() === '') { timeEl.value = ''; updateNotice(); }
              closeTime();
            }, 120);
          });
          timeEl.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') { e.preventDefault(); const p = parseTimeInput(timeEl.value); if (p) selectTime(p); closeTime(); }
            if (e.key === 'Tab') { const p = parseTimeInput(timeEl.value); if (p) selectTime(p); closeTime(); }
          });
        }

        // Defaults beim Laden: heute (rollt mit, wenn jetzt+2h auf morgen faellt)
        // + Uhrzeit auf naechsten 15er aufgerundet (gleiche Logik wie im Widget).
        (function initDefaults() {
          const def = computeDefaultDateTime();
          defaultTime = def.time;
          const [yy, mm] = def.date.split('-');
          calCursor = new Date(+yy, +mm - 1, 1);
          selectDate(def.date);
          if (timeEl) timeEl.value = def.time;
          updateNotice();
        })();

        // Flugnummer-Feld nur zeigen, wenn die Abholadresse ein Flughafen ist.
        function updateFlight() {
          const isAir = fromEl.dataset.airport === '1';
          if (flightCell) flightCell.hidden = !isAir;
          if (!isAir && flightInput) flightInput.value = '';
        }

        function loadMaps() {
          if (window.google?.maps?.places) return Promise.resolve(true);
          if (mapsPromise) return mapsPromise;
          mapsPromise = new Promise((resolve) => {
            const cb = 'hbMapsReady';
            window[cb] = () => resolve(true);
            const s = document.createElement('script');
            s.src = `https://maps.googleapis.com/maps/api/js?key=${GOOGLE_MAPS_KEY}&libraries=places&callback=${cb}`;
            s.async = true;
            s.onerror = () => resolve(false);
            document.head.appendChild(s);
          });
          return mapsPromise;
        }

        async function attach(input) {
          if (input.dataset.bound) return;
          input.dataset.bound = '1';
          const ok = await loadMaps();
          if (!ok || !window.google?.maps?.places) return;
          const ac = new window.google.maps.places.Autocomplete(input, {
            fields: ['formatted_address', 'geometry', 'name', 'types'],
            componentRestrictions: { country: ['at', 'de', 'sk', 'hu', 'cz'] },
          });
          ac.addListener('place_changed', () => {
            const p = ac.getPlace();
            const loc = p?.geometry?.location;
            if (loc) { input.dataset.lat = String(loc.lat()); input.dataset.lng = String(loc.lng()); }
            else { input.dataset.lat = ''; input.dataset.lng = ''; }
            const types = Array.isArray(p?.types) ? p.types : [];
            input.dataset.airport = types.includes('airport') ? '1' : '';
            // Bei POIs/Flughaefen den NAMEN zeigen (z. B. "Flughafen Wien"),
            // nicht die Buerger-Adresse ("1300 Schwechat"). Sonst geht der
            // Ortsname verloren und die Flughafen-Erkennung im Widget (Keyword)
            // greift nach dem Prefill nicht mehr.
            const isPoi = types.some((t) => ['establishment', 'point_of_interest', 'airport', 'transit_station', 'lodging', 'tourist_attraction'].includes(t));
            if (p) input.value = (isPoi && p.name) ? p.name : (p.formatted_address || p.name || input.value);
            if (input === fromEl) updateFlight();
          });
          // Manuelle Aenderung entwertet die Koordinaten (Adresse nicht bestaetigt).
          input.addEventListener('input', () => {
            input.dataset.lat = ''; input.dataset.lng = ''; input.dataset.airport = '';
            if (input === fromEl) updateFlight();
          });
        }

        [fromEl, toEl].forEach((el) => { if (el) el.addEventListener('focus', () => attach(el), { once: true }); });

        function stopCount() { return stopsWrap.querySelectorAll('.hbook__stop').length; }

        const stopTpl = document.getElementById('hb-stop-tpl');
        function addStop() {
          if (stopCount() >= MAX_STOPS || !stopTpl) return;
          // Aus dem <template> klonen -- so behalten die Elemente Astros
          // Scope-Attribut, das per JS erzeugte Elemente NICHT bekaemen (sonst
          // greift das gescopte CSS nicht -> unstyled/riesige Icons).
          const cell = stopTpl.content.firstElementChild.cloneNode(true);
          const id = 'hb-stop-' + (stopSeq++);
          const label = cell.querySelector('.hbook__flabel');
          const input = cell.querySelector('.hbook__stop-input');
          input.id = id; label.setAttribute('for', id);
          cell.querySelector('.hbook__stop-remove').addEventListener('click', () => { cell.remove(); addBtn.hidden = false; });
          stopsWrap.appendChild(cell);
          input.focus();
          attach(input);
          if (stopCount() >= MAX_STOPS) addBtn.hidden = true;
        }
        if (addBtn) addBtn.addEventListener('click', addStop);

        function readField(el) {
          const address = (el.value || '').trim();
          if (!address) return null;
          const lat = parseFloat(el.dataset.lat), lng = parseFloat(el.dataset.lng);
          const o = { address };
          if (Number.isFinite(lat) && Number.isFinite(lng)) { o.lat = lat; o.lng = lng; }
          if (el.dataset.airport === '1') o.isAirport = true;
          return o;
        }

        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const pickup = readField(fromEl);
          const dropoff = readField(toEl);
          if (!pickup) { fromEl.focus(); return; }
          if (!dropoff) { toEl.focus(); return; }
          // Flugnummer ist Pflicht, wenn die Abholadresse ein Flughafen ist.
          const flightVal = (flightInput?.value || '').trim();
          if (fromEl.dataset.airport === '1' && !flightVal) {
            if (flightCell) { flightCell.hidden = false; flightCell.classList.add('hbook__cell--err'); }
            flightInput.addEventListener('input', () => flightCell.classList.remove('hbook__cell--err'), { once: true });
            flightInput.focus();
            return;
          }
          // 2h-Vorlaufregel: Klick bleibt erlaubt, leitet aber NICHT weiter --
          // stattdessen den Live-Hinweis einblenden/hervorheben und Fokus aufs
          // Zeitfeld setzen, damit klar ist, warum nichts passiert.
          if (leadBlocked()) {
            if (notice) {
              notice.hidden = false;
              notice.classList.remove('is-flash');
              // Reflow erzwingen, damit die Flash-Animation erneut startet.
              void notice.offsetWidth;
              notice.classList.add('is-flash');
              notice.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
            if (timeEl) timeEl.focus();
            return;
          }
          const stops = Array.from(stopsWrap.querySelectorAll('.hbook__stop-input')).map(readField).filter(Boolean);
          const prefill = { pickup, dropoff, stops };
          if (dateEl?.value) prefill.date = dateEl.value;
          if (timeEl?.value) prefill.time = timeEl.value;
          if (flightVal) prefill.flight = flightVal;
          const base = form.dataset.bookBase || '/online-buchung';
          window.location.href = base + '?prefill=' + encodeURIComponent(JSON.stringify(prefill));
        });
      }
    </script>

    <!-- ============ ÜBER UNS ============ -->
    <section id="ueber-uns" class="about section">
      <div class="container-x about__inner">
        <p class="eyebrow about__eyebrow" data-reveal>{L.aboutEyebrow}</p>
