---
import { CONTACT } from '../lib/site';
import { getLang, t, hrefFor } from '../lib/i18n';
interface Props {
  heading?: string;
  id?: string;
  bg?: string;
  ctaHref?: string;
}
const lang = getLang(Astro.url);
const ct = t(lang).cta;
const {
  heading = ct.heading,
  id = 'kontakt',
  bg = '/images/cta-bg.jpg',
  ctaHref = hrefFor('/kontakt', lang),
} = Astro.props;
const phoneHref = `tel:${CONTACT.phonePrimary.tel}`;
---
<section class="cta" id={id} aria-label={ct.aria}>
  <div class="cta__bg" style={`--cta-bg: url('${bg}')`} aria-hidden="true"></div>
  <div class="container-x cta__inner">
    <div class="cta__row">
      <h2 class="cta__title" data-reveal>{heading}</h2>
      <div class="cta__actions" data-reveal style="--reveal-delay:0.08s">
        <a class="cta__cta" href={ctaHref}>{ct.button}</a>
        <a class="cta__phone" href={phoneHref}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z"/></svg>
          <span>{CONTACT.phonePrimary.display}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Figma 151:2313 / 151:3004 */
  .cta {
    position: relative; isolation: isolate; overflow: hidden; color: #fff;
    margin-block-start: -1px;
    display: flex; flex-direction: column; justify-content: flex-end;
    min-block-size: 700px;
    padding-block: var(--section-py);
  }
  .cta__bg {
    position: absolute; inset: 0; z-index: 0;
    background-image:
      linear-gradient(180deg, rgba(13, 7, 3, 0) 0%, rgba(13, 7, 3, 0.76) 96.635%),
      linear-gradient(rgba(0, 0, 0, 0.30), rgba(0, 0, 0, 0.30)),
      var(--cta-bg);
    background-size: cover; background-position: 50% 42%; background-repeat: no-repeat;
    background-blend-mode: normal, multiply, normal;
    background-color: #0d0703;
  }
  .cta__inner { position: relative; z-index: 1; }
  .cta__row { display: flex; align-items: flex-end; justify-content: space-between; gap: clamp(2rem, 4vw, 4rem); }
  .cta__title {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(1.9rem, 3.4vw, 3rem); line-height: 1.04; letter-spacing: -0.03em;
    color: #fff; max-inline-size: 46ch;
  }
  .cta__actions { display: flex; align-items: center; gap: 20px; flex: none; }
  .cta__cta {
    padding: 16px 36px; border-radius: 42px;
    background: linear-gradient(90deg, #c46a2d 0%, #e9b79a 100%);
    border: 1px solid rgba(255, 255, 255, 0.09);
    color: rgba(0, 0, 0, 0.9); font-weight: 500; font-size: 16px; text-decoration: none; white-space: nowrap;
    transition: filter 0.3s ease, transform 0.25s ease;
  }
  .cta__cta:hover { filter: brightness(1.05); transform: translateY(-2px); }
  .cta__phone {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 16px 26px; border-radius: 45px;
    background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(9.3px); -webkit-backdrop-filter: blur(9.3px);
    color: #fff; font-size: 16px; text-decoration: none; white-space: nowrap;
    transition: background 0.3s ease;
  }
  .cta__phone:hover { background: rgba(255, 255, 255, 0.12); }
  .cta__phone svg { inline-size: 20px; block-size: 20px; }

  @media (max-width: 820px) {
    .cta { min-block-size: 560px; }
    .cta__row { flex-direction: column; align-items: flex-start; gap: 2rem; }
    .cta__actions { flex-wrap: wrap; }
  }
  @media (max-width: 640px) {
    .cta__cta, .cta__phone { padding: 0.85rem 1.4rem; font-size: 0.9rem; line-height: 1; }
    .cta__phone svg { inline-size: 15px; block-size: 15px; }
  }
</style>
