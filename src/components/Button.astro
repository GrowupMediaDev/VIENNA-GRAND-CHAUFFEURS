---
// Vienna Grand Chauffeurs CTA. Sharp rectangle, Inter medium.
// variant: solid (terracotta), ghost-light (outline on dark),
//          ghost-dark (outline on light). Optional [slot=icon].
interface Props {
  href: string;
  variant?: 'solid' | 'ghost-light' | 'ghost-dark';
  size?: 'sm' | 'md';
  class?: string;
  target?: string;
  rel?: string;
  ariaLabel?: string;
}
const {
  href,
  variant = 'solid',
  size = 'md',
  class: className = '',
  target,
  rel,
  ariaLabel,
} = Astro.props;
---
<a
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  href={href}
  target={target}
  rel={rel}
  aria-label={ariaLabel}
>
  <slot name="icon" />
  <span class="btn__label"><slot /></span>
</a>

<style>
  .btn {
    --px: 1.9rem;
    --py: 0.95rem;
    --fs: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding-inline: var(--px);
    padding-block: var(--py);
    border-radius: 42px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--fs);
    letter-spacing: 0.005em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    border: 0;
    transition:
      transform 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      filter 0.3s ease;
  }
  .btn:focus-visible {
    outline: 2px solid var(--color-terracotta);
    outline-offset: 3px;
  }
  .btn--sm { --px: 1.4rem; --py: 0.75rem; --fs: 0.85rem; }

  /* Figma primary: 90deg terracotta→peach gradient, dark text. Crisp edge —
     no white hairline (it read as a fuzzy halo against the dark hero). */
  .btn--solid {
    background: linear-gradient(90deg, #c46a2d 0%, #e9b79a 100%);
    color: var(--color-ink);
  }
  .btn--solid:hover {
    filter: brightness(1.05);
    transform: translateY(-2px);
  }

  .btn--ghost-light {
    background: rgba(255, 255, 255, 0.02);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .btn--ghost-light:hover {
    background: #fff;
    color: var(--color-ink);
    border-color: #fff;
    transform: translateY(-2px);
  }

  .btn--ghost-dark {
    background: transparent;
    color: var(--color-ink);
    border: 1px solid rgba(30, 30, 30, 0.35);
  }
  .btn--ghost-dark:hover {
    background: var(--color-ink);
    color: #fff;
    border-color: var(--color-ink);
    transform: translateY(-2px);
  }

  .btn :global(svg) {
    inline-size: 18px;
    block-size: 18px;
    flex: none;
  }
</style>
