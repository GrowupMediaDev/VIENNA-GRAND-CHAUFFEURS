---
import { CONTACT } from '../lib/site';
import { getServices } from '../lib/services-data';
import Picture from './Picture.astro';
import { getLang, hrefFor, pick } from '../lib/i18n';
const lang = getLang(Astro.url);
const phoneHref = `tel:${CONTACT.phone.tel}`;
const leistungenBase = hrefFor('/leistungen/', lang);
const services = getServices(lang).map((s) => ({ title: s.hero.title, slug: s.slug, img: s.heroImg, text: s.hero.sub }));
const L = pick(lang,
  { eyebrow: 'Leistungen', request: 'Jetzt anfragen', aria: 'Leistungen', dialAria: 'Durch die Leistungen blättern — ziehen zum Scrollen', titleHtml: 'Maßgeschneiderter Service<br class="serv__br" />für jeden Anlass', intro: 'Ob geschäftlich oder privat, kurze Strecke oder lange Reise: Wir bieten für jeden Anlass den passenden Chauffeurservice in Wien und ganz Österreich. Vom Flughafentransfer bis zur Langstrecke steht Ihnen ein erfahrenes Team mit gepflegter Premiumflotte zur Seite, wählen Sie einfach die Leistung, die zu Ihnen passt.' },
  { eyebrow: 'Services', request: 'Request now', aria: 'Services', dialAria: 'Browse the services — drag to scroll', titleHtml: 'Tailored service<br class="serv__br" />for every occasion', intro: 'Whether for business or private matters, a short trip or a long journey: we offer the right chauffeur service for every occasion in Vienna and throughout Austria. From the airport transfer to long-distance travel, an experienced team with an immaculate premium fleet is at your side — simply choose the service that suits you.' });
---
    <section class="serv" id="leistungen" aria-label={L.aria}>
      <div class="serv__bg" aria-hidden="true"></div>

      <div class="container-x serv__inner">
        <div class="serv__head">
          <p class="eyebrow serv__eyebrow" data-reveal>{L.eyebrow}</p>
          <h2 class="serv__title" data-reveal style="--reveal-delay:0.06s" set:html={L.titleHtml}></h2>
          <a class="serv__phone" href={phoneHref} data-reveal style="--reveal-delay:0.1s">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z"/></svg>
            <span>{CONTACT.phone.display}</span>
          </a>
          <p class="serv__intro" data-reveal style="--reveal-delay:0.14s">{L.intro}</p>
        </div>

        <div class="serv__viewport" data-carousel>
          <div class="serv__track" data-track>
            {services.concat(services).map((s, i) => {
              const clone = i >= services.length;
              return (
                <article class="scard" aria-hidden={clone ? 'true' : undefined}>
                  <div class="scard__media">
                    <Picture src={s.img} alt={clone ? '' : s.title} loading="lazy" draggable={false} />
                  </div>
                  <div class="scard__body">
                    <div class="scard__text-wrap">
                      <h3 class="scard__title">{s.title}</h3>
                      <p class="scard__text">{s.text}</p>
                    </div>
                    <a class="scard__cta" href={`${leistungenBase}${s.slug}`} tabindex={clone ? -1 : undefined}>
                      <span>{L.request}</span>
                      <span class="scard__cta-ic" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                      </span>
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </div>

        <!-- Dashed route + draggable friction dial -->
        <div class="serv__dialwrap" data-dialwrap>
          <svg class="serv__route" viewBox="0 0 1200 90" preserveAspectRatio="none" aria-hidden="true">
            <path class="serv__route-path" d="M0 24 Q 600 78 1200 24" fill="none" />
          </svg>
          <button class="serv__dial" data-dial type="button" aria-label={L.dialAria}>
            <span class="serv__dial-face" aria-hidden="true">
              <svg class="serv__dial-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 7l-5 5 5 5M15 7l5 5-5 5"/></svg>
            </span>
          </button>
        </div>
      </div>
    </section>

<style>
  /* ============ LEISTUNGEN ============ */
  /* -1px pulls the section up over the fleet so no sub-pixel gap (cream body)
     shows at the seam. */
  .serv { position: relative; isolation: isolate; overflow: hidden; color: #fff; background: #0d0703; margin-block-start: -1px; }
  /* Layers (top → bottom): gradient (blends to #0D0703 at top for the section
     above), 30% black MULTIPLIED over the image, the image, then #000. */
  .serv__bg {
    position: absolute; inset: 0; z-index: 0;
    background-image:
      linear-gradient(0deg, rgba(13, 7, 3, 0) 0%, #0d0703 100%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.30) 0%, rgba(0, 0, 0, 0.30) 100%),
      image-set(url('/images/hero-home.webp') type('image/webp'), url('/images/hero-home.jpg') type('image/jpeg'));
    background-position: 50% 60%;
    background-size: cover;
    background-repeat: no-repeat;
    background-blend-mode: normal, multiply, normal;
    background-color: #000;
  }
  .serv__inner { position: relative; z-index: 2; padding-block: clamp(4rem, 8vw, 7rem); }

  .serv__head {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.5fr);
    column-gap: clamp(1.5rem, 3vw, 3rem); row-gap: clamp(0.8rem, 1.5vw, 1.2rem);
    align-items: start;
  }
  /* Same eyebrow treatment as "Über uns" — consistent across sections. */
  .serv__eyebrow {
    grid-area: 1 / 1 / 2 / 2;
    font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; letter-spacing: -0.042em;
  }
  .serv__title {
    grid-area: 2 / 1 / 3 / 2;
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(2.2rem, 3.8vw, 3.4rem); line-height: 1.06; letter-spacing: -0.02em; color: #fff;
  }
  .serv__phone {
    grid-area: 2 / 2 / 3 / 3; justify-self: end; align-self: end;
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.85rem 1.5rem; border-radius: 999px;
    background: rgba(20, 20, 20, 0.45); border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    color: #fff; text-decoration: none; font-weight: 500; font-size: 0.95rem; white-space: nowrap;
    transition: background 0.3s ease;
  }
  .serv__phone:hover { background: rgba(20, 20, 20, 0.7); }
  .serv__phone svg { inline-size: 17px; block-size: 17px; }
  .serv__intro {
    grid-area: 3 / 1 / 4 / 3; justify-self: end; max-inline-size: min(100%, 58%);
    margin: 0;
    color: rgba(255, 255, 255, 0.72); line-height: 1.75; font-size: clamp(0.95rem, 1vw, 1.05rem);
  }
  @media (max-width: 760px) {
    .serv__head { grid-template-columns: 1fr; row-gap: 1.5rem; }
    .serv__eyebrow, .serv__title, .serv__phone, .serv__intro { grid-area: auto; justify-self: start; }
    .serv__eyebrow { font-size: 1.05rem; }
    /* Drop the forced line break on mobile so the heading wraps naturally. */
    .serv__br { display: none; }
    .serv__title { font-size: 2rem; margin-block-start: -0.45rem; }
    .serv__intro { max-inline-size: none; font-size: 16px; line-height: 1.6; }
    /* Move the phone CTA below the description for a cleaner reading flow. */
    .serv__phone { order: 1; }
  }

  /* Carousel */
  .serv__viewport { overflow: hidden; margin-block: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2.5rem); }
  .serv__track {
    --gap: clamp(1rem, 1.5vw, 1.375rem);
    display: flex; gap: var(--gap);
    transform: translate3d(calc(var(--scroll, 0) * -1px), 0, 0);
    will-change: transform; touch-action: pan-y;
  }
  /* Figma card 151:1849 — frosted-glass, fixed 320px image, 3-up. */
  .scard {
    flex: 0 0 calc((100% - 2 * var(--gap)) / 3);
    display: flex; flex-direction: column; align-items: flex-start;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 30px;
    backdrop-filter: blur(17.5px); -webkit-backdrop-filter: blur(17.5px);
    overflow: clip;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.45s ease,
                border-color 0.45s ease, background 0.45s ease;
  }
  .scard__media { block-size: 320px; inline-size: 100%; border-radius: 30px; overflow: hidden; }
  .scard__media img { inline-size: 100%; block-size: 100%; object-fit: cover; transition: transform 0.7s cubic-bezier(0.2, 0, 0.15, 1); }
  /* Cool hover — lift, image zoom, brighten glass, glow, arrow nudge. */
  .scard:hover {
    transform: translateY(-10px);
    box-shadow: 0 34px 72px -26px rgba(0, 0, 0, 0.6);
    border-color: rgba(196, 106, 45, 0.55);
    background: rgba(255, 255, 255, 0.14);
  }
  .scard:hover .scard__media img { transform: scale(1.07); }
  .scard:hover .scard__cta { filter: brightness(1.05); }
  .scard__cta-ic svg { transition: transform 0.3s ease; }
  .scard:hover .scard__cta-ic svg { transform: translateX(3px); }
  .scard__body {
    display: flex; flex-direction: column; align-items: flex-start; gap: 35px;
    inline-size: 100%; padding: 40px 20px; flex: 1;
  }
  .scard__text-wrap { display: flex; flex-direction: column; gap: 10px; inline-size: 100%; }
  .scard__title {
    font-family: var(--font-display); font-weight: 600;
    font-size: 1.75rem; line-height: normal; letter-spacing: -0.03em; color: #fff;
  }
  .scard__text { margin: 0; color: rgba(255, 255, 255, 0.72); line-height: 1.75rem; font-size: 1rem; }
  .scard__cta {
    margin-block-start: auto;
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    padding: 5px 3px 5px 16px; border-radius: 42px;
    background: linear-gradient(90deg, #c46a2d 0%, #e9b79a 100%);
    border: 0;
    color: #000; text-decoration: none; font-weight: 500; font-size: 0.875rem; white-space: nowrap;
    transition: filter 0.3s ease, transform 0.25s ease;
  }
  .scard__cta:hover { filter: brightness(1.05); transform: translateY(-1px); }
  .scard__cta-ic {
    background: #000; border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 10px; border-radius: 39px; color: #fff; display: grid; place-items: center;
  }
  .scard__cta-ic svg { inline-size: 14px; block-size: 14px; }

  /* Dashed route + friction dial */
  .serv__dialwrap { position: relative; block-size: 92px; display: grid; place-items: center; }
  .serv__route {
    position: absolute; inset: 0; inline-size: 100%; block-size: 100%; overflow: visible;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 14%, #000 86%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 14%, #000 86%, transparent 100%);
  }
  .serv__route-path {
    stroke: var(--color-terracotta); stroke-width: 2; stroke-linecap: round;
    stroke-dasharray: 7 11;
    vector-effect: non-scaling-stroke;
  }
  .serv__dial {
    position: relative; z-index: 2;
    inline-size: 58px; block-size: 58px; border-radius: 999px;
    background: rgba(20, 20, 20, 0.55); border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    color: #fff; cursor: grab; display: grid; place-items: center;
    touch-action: none; user-select: none;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.4);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }
  .serv__dial:hover { background: rgba(30, 30, 30, 0.7); }
  .serv__dial.is-dragging { cursor: grabbing; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.5); }
  .serv__dial-face { display: grid; place-items: center; will-change: transform; }
  .serv__dial-ic { inline-size: 24px; block-size: 24px; }

  /* Tablet: two cards at a time, and let the intro span full width. */
  @media (max-width: 1024px) {
    .scard { flex-basis: calc((100% - var(--gap)) / 2); }
    .serv__intro { justify-self: stretch; max-inline-size: none; }
  }

  @media (max-width: 760px) {
    /* One card at a time, smaller corners, shorter 4:3 image, compact body. */
    .scard { flex-basis: 100%; border-radius: 16px; }
    .scard__media { block-size: auto; aspect-ratio: 4 / 3; border-radius: 16px; }
    .scard__body { padding: 26px 20px 24px; gap: 20px; }
    .scard__title { font-size: 1.4rem; }
    .scard__text { font-size: 0.95rem; line-height: 1.55rem; }
  }

  @media (max-width: 820px) {
    .fleet__frame { border-inline: 0; }
    .fleet__frame::before { display: none; }
    .fleet__tabs { top: clamp(4.5rem, 11vw, 6rem); }
    /* Smaller arrows tucked inside the frame (were half-off the edges). */
    .fleet__arrow { inline-size: 42px; block-size: 42px; }
    .fleet__arrow svg { inline-size: 17px; block-size: 17px; }
    .fleet__arrow--prev { left: 12px; transform: translate(0, -50%); }
    .fleet__arrow--next { right: 12px; transform: translate(0, -50%); }
    /* Grid: name/tier/button on its own row, then thumbnail + specs side by side. */
    .fleet__bar {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas: "meta meta" "thumb specs";
      column-gap: 1.4rem; row-gap: 3rem;
      align-items: center; block-size: auto;   /* was a fixed 200px flex row */
      border-block: 0; padding-block: 0;
      inset-block-end: clamp(2rem, 8vh, 5rem);
    }
    .fleet__meta { grid-area: meta; padding-inline-start: 0; }
    .fleet__specs { grid-area: specs; align-self: center; }
    /* Explicit box so the thumbnail doesn't collapse to a strip. */
    .fleet__thumb {
      grid-area: thumb; inline-size: 168px; block-size: 108px;
      align-self: center; border-radius: 0;
    }
    .fleet__play { inline-size: 44px; block-size: 44px; }
    .fleet__play svg { inline-size: 18px; block-size: 18px; }
    .fleet__specs { gap: 0; }
    .fleet__specs > div { padding-inline: clamp(0.85rem, 3.5vw, 1.4rem); }
    .fleet__specs > div:first-child { padding-inline-start: 0; }
    .fleet__specs > div:first-child::before { display: none; }
    .fleet__specs dd { font-size: 0.68rem; }
  }

  @media (max-width: 640px) { .serv__phone { padding: 0.85rem 1.4rem; font-size: 0.9rem; line-height: 1; } .serv__phone svg { inline-size: 15px; block-size: 15px; } }
</style>

<script>
  // Leistungen — friction dial carousel with mechanical tick sounds.
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  const track = document.querySelector<HTMLElement>('[data-track]');
  const dial = document.querySelector<HTMLElement>('[data-dial]');
  const routePath = document.querySelector<SVGPathElement>('.serv__route-path');
  if (carousel && track && dial) {
    const reduceMo = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const TICK_STEP = 42;
    let pos = 0, vel = 0, step = 1, period = 1, raf: number | null = null, lastTick = 0, lastRenderPos = 0;

    const measure = () => {
      const c = track.children;
      step = c.length > 1 ? (c[1] as HTMLElement).offsetLeft - (c[0] as HTMLElement).offsetLeft : carousel.clientWidth;
      period = step * (c.length / 2);      // two identical card sets → one seamless loop
    };
    const snap = (v: number) => Math.round(v / step) * step;
    measure();
    window.addEventListener('resize', measure);

    // Web Audio — subtle detent click, built lazily on first gesture.
    let ac: AudioContext | null = null;
    const ensureAudio = () => {
      if (ac) { if (ac.state === 'suspended') ac.resume(); return; }
      try { ac = new (window.AudioContext || (window as any).webkitAudioContext)(); } catch { ac = null; }
    };
    const playTick = (strength: number) => {
      if (!ac) return;
      const t = ac.currentTime;
      const osc = ac.createOscillator(), g = ac.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(1300 + Math.random() * 260, t);
      const peak = Math.min(0.07, 0.016 + strength * 0.05);
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(peak, t + 0.002);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.045);
      osc.connect(g); g.connect(ac.destination);
      osc.start(t); osc.stop(t + 0.06);
    };

    const render = () => {
      const vis = ((pos % period) + period) % period;   // seamless loop
      track.style.setProperty('--scroll', String(vis));
      // Handle stays fixed — the dashed route flows past it instead.
      if (routePath) routePath.style.strokeDashoffset = String(-pos * 0.8);
      const delta = pos - lastRenderPos; lastRenderPos = pos;
      const idx = Math.round(pos / TICK_STEP);
      if (idx !== lastTick) { playTick(Math.min(1, Math.abs(delta) / 14)); lastTick = idx; }
    };
    render();

    // Ease to a target position (used for momentum-snap + keyboard).
    const animateTo = (target: number) => {
      if (raf) { cancelAnimationFrame(raf); raf = null; }
      if (reduceMo) { pos = target; render(); return; }
      const startP = pos, dist = target - pos;
      if (Math.abs(dist) < 0.5) { pos = target; render(); return; }
      const dur = Math.min(720, 300 + Math.abs(dist) * 0.4);
      let t0: number | null = null;
      const frame = (ts: number) => {
        if (t0 === null) t0 = ts;
        const k = Math.min(1, (ts - t0) / dur);
        pos = startP + dist * (1 - Math.pow(1 - k, 3));
        render();
        if (k < 1) { raf = requestAnimationFrame(frame); } else { pos = target; render(); raf = null; }
      };
      raf = requestAnimationFrame(frame);
    };

    let dragging = false, lastX = 0, lastT = 0, moved = 0, amp = 1;
    const down = (e: PointerEvent, factor: number) => {
      ensureAudio();
      dragging = true; amp = factor; moved = 0;
      lastX = e.clientX; lastT = e.timeStamp || performance.now(); vel = 0;
      if (raf) { cancelAnimationFrame(raf); raf = null; }
      dial.classList.add('is-dragging');
    };
    const move = (e: PointerEvent) => {
      if (!dragging) return;
      const dx = e.clientX - lastX;
      const dt = Math.max(1, (e.timeStamp || performance.now()) - lastT);
      moved += Math.abs(dx);
      pos -= dx * amp;
      vel = (-dx * amp) / dt * 16;
      lastX = e.clientX; lastT = e.timeStamp || performance.now();
      render();
    };
    const up = () => {
      if (!dragging) return;
      dragging = false; dial.classList.remove('is-dragging');
      // Momentum-predicted landing, snapped to the nearest card boundary (3-up).
      animateTo(snap(pos + vel * 10));
    };

    dial.addEventListener('pointerdown', (e) => { e.preventDefault(); dial.setPointerCapture?.(e.pointerId); down(e, 2.6); });
    track.addEventListener('pointerdown', (e) => down(e, 1));
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', up);
    window.addEventListener('pointercancel', up);
    // Swallow card-link clicks that follow a drag.
    track.addEventListener('click', (e) => { if (moved > 6) e.preventDefault(); }, true);

    dial.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      ensureAudio();
      animateTo(snap(pos + (e.key === 'ArrowRight' ? 1 : -1) * step));
      e.preventDefault();
    });
  }
</script>
