---
import { CONTACT } from '../lib/site';
import { getLang, t, hrefFor } from '../lib/i18n';
const lang = getLang(Astro.url);
const ft = t(lang).footer;
const year = 2026;
---
<footer class="footer">
  <div class="container-x">
    <div class="footer__rule" aria-hidden="true"></div>

    <div class="footer__main">
      <div class="footer__brand">
        <p class="footer__tagline" set:html={ft.tagline}></p>
        <a href={hrefFor('/', lang)} class="footer__logo" aria-label="Vienna Grand Chauffeurs">
          <img src="/images/logo-footer.svg" alt="Vienna Grand Chauffeurs" width="157" height="60" />
        </a>
      </div>

      <div class="footer__col">
        <div class="footer__block">
          <h3 class="footer__head">{ft.location}</h3>
          <p class="footer__text">{ft.locationValue}</p>
        </div>
        <nav class="footer__block footer__links" aria-label={ft.explore}>
          <h3 class="footer__head footer__head--sans">{ft.explore}</h3>
          <a href={hrefFor('/#leistungen', lang)}>{ft.services}</a>
          <a href={hrefFor('/#fahrzeuge', lang)}>{ft.fleet}</a>
          <a href={hrefFor('/preise', lang)}>{ft.prices}</a>
          <a href={hrefFor('/leistungen/flughafen-transfer-wien', lang)}>{ft.airport}</a>
        </nav>
      </div>

      <div class="footer__col">
        <div class="footer__block">
          <h3 class="footer__head">{ft.contact}</h3>
          <p class="footer__text">
            <a href={CONTACT.email.mailto}>{CONTACT.email.display}</a><br />
            <a href={`tel:${CONTACT.phonePrimary.tel}`}>{CONTACT.phonePrimary.display}</a>
            <span class="footer__phoneLabel">{ft.landline}</span><br />
            <a href={`tel:${CONTACT.phoneSecondary.tel}`}>{CONTACT.phoneSecondary.display}</a>
            <span class="footer__phoneLabel">{ft.mobile}</span>
          </p>
        </div>
        <nav class="footer__block footer__links" aria-label={ft.company}>
          <h3 class="footer__head footer__head--sans">{ft.company}</h3>
          <a href={hrefFor('/#ueber-uns', lang)}>{ft.aboutUs}</a>
          <a href={hrefFor('/kontakt', lang)}>{ft.contactLink}</a>
          <a href={hrefFor('/impressum/', lang)}>{ft.imprint}</a>
          <a href={hrefFor('/datenschutz/', lang)}>{ft.privacy}</a>
        </nav>
      </div>
    </div>

    <div class="footer__rule" aria-hidden="true"></div>

    <div class="footer__bottom">
      <p>© {year} Vienna Grand Chauffeurs. {ft.rights}</p>
      <p class="footer__legal">
        <a href={hrefFor('/impressum/', lang)}>{ft.imprint}</a> · <a href={hrefFor('/datenschutz/', lang)}>{ft.privacy}</a> · <a href={hrefFor('/agb/', lang)}>{ft.terms}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #0d0703; color: #fff;
    padding-block: var(--section-py);
    margin-block-start: -1px;
  }
  .footer__rule { block-size: 1px; inline-size: 100%; background: rgba(255, 255, 255, 0.1); }

  .footer__main {
    display: flex; align-items: stretch;
    min-block-size: 400px;
    padding-block: clamp(2.5rem, 4vw, 2.5rem);
  }
  .footer__brand {
    inline-size: 600px; flex: none; max-inline-size: 50%;
    display: flex; flex-direction: column; justify-content: space-between; gap: 2rem;
  }
  .footer__tagline {
    margin: 0; font-family: var(--font-body); font-weight: 500;
    font-size: clamp(1.6rem, 2.5vw, 2.25rem); line-height: 1.06; letter-spacing: -0.02em; color: #fff;
  }
  .footer__logo { display: inline-flex; line-height: 0; }
  .footer__logo img { block-size: 60px; inline-size: auto; }

  .footer__col {
    flex: 1 1 0; min-inline-size: 0;
    display: flex; flex-direction: column; justify-content: space-between; gap: 2rem;
    padding: 10px clamp(1.5rem, 2.5vw, 2.25rem);
    border-inline-start: 1px solid rgba(255, 255, 255, 0.1);
  }
  .footer__block { display: flex; flex-direction: column; gap: 18px; }
  .footer__head {
    font-family: var(--font-display); font-weight: 500; font-size: 24px;
    letter-spacing: -0.72px; text-transform: capitalize; color: #fff; margin: 0;
  }
  .footer__head--sans { font-family: var(--font-body); letter-spacing: 0; text-transform: none; }
  .footer__text { margin: 0; font-size: 16px; line-height: 35px; color: rgba(255, 255, 255, 0.8); }
  .footer__text a { color: inherit; text-decoration: none; transition: color 0.3s ease; }
  .footer__phoneLabel { font-size: 12.5px; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255, 255, 255, 0.45); }
  .footer__links { gap: 24px; }
  .footer__links a {
    font-size: 16px; line-height: 1.25; color: rgba(255, 255, 255, 0.7);
    text-decoration: none; transition: color 0.3s ease;
  }
  .footer__text a:hover, .footer__links a:hover { color: var(--color-terracotta-300); }

  .footer__bottom {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
    padding-block-start: clamp(1.5rem, 3vw, 2.5rem);
  }
  .footer__bottom p { margin: 0; font-weight: 500; font-size: 14px; letter-spacing: 0.14px; color: rgba(255, 255, 255, 0.8); }
  .footer__legal a { color: inherit; text-decoration: none; transition: color 0.3s ease; }
  .footer__legal a:hover { color: var(--color-terracotta-300); }

  /* Tablet: brand full-width on top, the two link columns side by side. */
  @media (max-width: 900px) {
    .footer__main { flex-wrap: wrap; min-block-size: 0; gap: clamp(2rem, 5vw, 3rem) clamp(2rem, 4vw, 3rem); }
    .footer__brand {
      inline-size: 100%; max-inline-size: none;
      flex-direction: column-reverse; gap: 2rem; align-items: flex-start;
    }
    .footer__col { flex: 1 1 40%; border-inline-start: 0; padding: 0; gap: 2.5rem; }
  }
  /* Phones: single column. */
  @media (max-width: 560px) {
    .footer__col { flex-basis: 100%; }
    .footer__col:not(:last-child) { border-block-end: 1px solid rgba(255, 255, 255, 0.1); padding-block-end: 2rem; }
  }
</style>
