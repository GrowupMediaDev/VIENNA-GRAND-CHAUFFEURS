---
// Serves WebP with a JPEG/PNG fallback via <picture>. `display:contents` on the
// wrapper keeps the <img> laid out exactly as before, so existing CSS on the img
// (object-fit, positioning, its class) is unaffected.
interface Props {
  src: string;
  alt?: string;
  class?: string;
  width?: number | string;
  height?: number | string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
  fetchpriority?: 'high' | 'low' | 'auto';
  draggable?: boolean;
}
const { src, alt = '', class: cls, width, height, loading, decoding = 'async', fetchpriority, draggable } = Astro.props;
const webp = src.replace(/\.(jpe?g|png)$/i, '.webp');
const hasWebp = webp !== src;
---
<picture style="display:contents">
  {hasWebp && <source type="image/webp" srcset={webp} />}
  <img src={src} alt={alt} class={cls} width={width} height={height} loading={loading} decoding={decoding} fetchpriority={fetchpriority} draggable={draggable} />
</picture>
