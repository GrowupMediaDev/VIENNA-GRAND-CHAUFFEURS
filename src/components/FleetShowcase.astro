---
import { getLang, hrefFor, pick } from '../lib/i18n';
const lang = getLang(Astro.url);

const g = (slug: string) => [1, 2, 3, 4].map((n) => `/images/fahrzeuge/${slug}-gal-${n}.jpg`);
const BASE = [
  { slug: 'e-klasse', tab: { de: 'E-Klasse', en: 'E-Class' }, name: { de: 'Mercedes E-Klasse', en: 'Mercedes E-Class' }, tier: { de: 'Business Class Limousine', en: 'Business Class Sedan' }, pax: 3, bags: 3 },
  { slug: 'bmw-5er', tab: { de: 'BMW 5er', en: 'BMW 5 Series' }, name: { de: 'BMW 5er', en: 'BMW 5 Series' }, tier: { de: 'Business Class Limousine', en: 'Business Class Sedan' }, pax: 3, bags: 3 },
  { slug: 's-klasse', tab: { de: 'S-Klasse', en: 'S-Class' }, name: { de: 'Mercedes S-Klasse', en: 'Mercedes S-Class' }, tier: { de: 'First Class Limousine', en: 'First Class Sedan' }, pax: 3, bags: 4 },
  { slug: 'maybach', tab: { de: 'Maybach', en: 'Maybach' }, name: { de: 'Mercedes-Maybach', en: 'Mercedes-Maybach' }, tier: { de: 'Luxury Class Limousine', en: 'Luxury Class Sedan' }, pax: 3, bags: 3 },
  { slug: 'mercedes-eqe', tab: { de: 'EQE', en: 'EQE' }, name: { de: 'Mercedes EQE', en: 'Mercedes EQE' }, tier: { de: 'Elektro Limousine', en: 'Electric Sedan' }, pax: 3, bags: 3 },
  { slug: 'v-klasse', tab: { de: 'V-Klasse', en: 'V-Class' }, name: { de: 'Mercedes V-Klasse', en: 'Mercedes V-Class' }, tier: { de: 'Business Van & Shuttle', en: 'Business Van & Shuttle' }, pax: 7, bags: 7 },
  { slug: 'vip-minibus', tab: { de: 'VIP Minibus', en: 'VIP Minibus' }, name: { de: 'VIP Sprinter', en: 'VIP Sprinter' }, tier: { de: 'VIP Lounge Minibus', en: 'VIP Lounge Minibus' }, pax: 12, bags: 8 },
  { slug: 'business-sprinter', tab: { de: 'Sprinter', en: 'Sprinter' }, name: { de: 'Mercedes Sprinter', en: 'Mercedes Sprinter' }, tier: { de: 'Gruppen & Events', en: 'Groups & Events' }, pax: 19, bags: 10 },
];
const vehicles = BASE.map((v) => ({
  tab: pick(lang, v.tab.de, v.tab.en), name: pick(lang, v.name.de, v.name.en), tier: pick(lang, v.tier.de, v.tier.en),
  pax: v.pax, bags: v.bags, slug: v.slug, img: `/images/fahrzeuge/card-${v.slug}.jpg`, w: 1400, h: 1400, gallery: g(v.slug),
}));
const galleryData = vehicles.map((v) => ({ name: v.name, slug: v.slug, gallery: v.gallery }));
const viewBase = hrefFor('/fahrzeuge/', lang);
const L = pick(lang,
  { view: 'Fahrzeug ansehen', pax: 'Passagiere', bags: 'Gepäck', max: 'Max.', sectionAria: 'Fahrzeuge', tabsAria: 'Fahrzeugklasse wählen', prev: 'Vorheriges Fahrzeug', next: 'Nächstes Fahrzeug', openGallery: 'Galerie öffnen', galleryAria: 'Fahrzeug-Galerie', closeGallery: 'Galerie schließen', prevImg: 'Vorheriges Bild', nextImg: 'Nächstes Bild' },
  { view: 'View vehicle', pax: 'Passengers', bags: 'Luggage', max: 'Max.', sectionAria: 'Fleet', tabsAria: 'Select vehicle class', prev: 'Previous vehicle', next: 'Next vehicle', openGallery: 'Open gallery', galleryAria: 'Vehicle gallery', closeGallery: 'Close gallery', prevImg: 'Previous image', nextImg: 'Next image' });
---
    <section class="fleet" id="fahrzeuge" aria-label={L.sectionAria}>
      <div class="fleet__stage" data-fleet data-view-base={viewBase} data-reveal>
          <div class="fleet__slides">
            {vehicles.map((v, i) => (
              <img class:list={['fleet__img', i === 0 && 'is-active']} data-slide={i}
                src={v.img} alt={v.name} width={v.w} height={v.h} loading="lazy" decoding="async" />
            ))}
          </div>
          <div class="fleet__shade" aria-hidden="true"></div>

          <div class="fleet__frame">
          <div class="fleet__tabs" role="tablist" aria-label={L.tabsAria}>
            {vehicles.map((v, i) => (
              <button
                class:list={['fleet__tab', i === 0 && 'is-active']}
                type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'}
                data-tab={i} data-name={v.name} data-tier={v.tier} data-pax={v.pax} data-bags={v.bags} data-slug={v.slug}
              >{v.tab}</button>
            ))}
          </div>

          <button class="fleet__arrow fleet__arrow--prev" type="button" data-prev aria-label={L.prev}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
          </button>
          <button class="fleet__arrow fleet__arrow--next" type="button" data-next aria-label={L.next}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </button>

          <div class="fleet__bar">
            <div class="fleet__thumb">
              {vehicles.map((v, i) => (
                <img class:list={['fleet__thumb-img', i === 0 && 'is-active']} data-thumb={i} src={v.img} alt="" loading="lazy" />
              ))}
              <button class="fleet__play" type="button" data-play aria-label={L.openGallery}>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              </button>
            </div>
            <div class="fleet__meta">
              <h3 class="fleet__name" data-name>{vehicles[0].name}</h3>
              <p class="fleet__tier" data-tier>{vehicles[0].tier}</p>
              <a class="fleet__view" data-view href={viewBase + vehicles[0].slug}>
                <span>{L.view}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </a>
            </div>
            <dl class="fleet__specs">
              <div><dt data-pax>{L.max} {vehicles[0].pax}</dt><dd>{L.pax}</dd></div>
              <div><dt data-bags>{L.max} {vehicles[0].bags}</dt><dd>{L.bags}</dd></div>
            </dl>
          </div>
          </div>
      </div>
    </section>

<script type="application/json" data-fleet-galleries set:html={JSON.stringify(galleryData)} is:inline></script>

<!-- Lightbox gallery -->
<div class="fleet__lb" data-lb aria-hidden="true" role="dialog" aria-modal="true" aria-label={L.galleryAria}>
  <button class="fleet__lb-x" type="button" data-lb-close aria-label={L.closeGallery}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <div class="fleet__lb-inner">
    <button class="fleet__lb-nav" type="button" data-lb-prev aria-label={L.prevImg}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <figure class="fleet__lb-stage"><img data-lb-img src="" alt="" /></figure>
    <button class="fleet__lb-nav" type="button" data-lb-next aria-label={L.nextImg}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
    </button>
  </div>
  <div class="fleet__lb-foot">
    <div class="fleet__lb-meta">
      <span class="fleet__lb-name" data-lb-name></span>
      <span class="fleet__lb-count" data-lb-count></span>
    </div>
    <a class="fleet__lb-view" data-lb-view href="#">{L.view}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
    </a>
  </div>
</div>

<style>
  /* ============ FAHRZEUGE ============ */
  .fleet { background: #0d0703; margin-block-start: -1px; position: relative; }
  /* Solid dark bridge straddling the seam into the Leistungen section —
     covers Chrome's 100vh sub-pixel hairline. */
  .fleet::after {
    content: ''; position: absolute; inset-inline: 0; inset-block-end: -2px; block-size: 4px;
    background: #0d0703; z-index: 20; pointer-events: none;
  }
  .fleet__stage {
    position: relative; isolation: isolate;
    inline-size: 100%; block-size: 100vh; min-block-size: 100vh;
    overflow: hidden;
    color: #fff;
  }
  /* Fade the bottom to #0D0703 so the overlay lines dissolve and the section
     blends seamlessly into the Leistungen section below (also #0D0703). */
  .fleet__stage::after {
    content: ''; position: absolute; inset-inline: 0; inset-block-end: 0; z-index: 5;
    block-size: 14vh;
    background: linear-gradient(180deg, rgba(13, 7, 3, 0) 0%, #0d0703 100%);
    pointer-events: none;
  }
  .fleet__slides, .fleet__img { position: absolute; inset: 0; }
  .fleet__img {
    inline-size: 100%; block-size: 100%; object-fit: cover;
    opacity: 0; transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .fleet__img.is-active { opacity: 1; }
  .fleet__shade {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(180deg, rgba(13, 7, 3, 0.00) 0%, #0d0703 96.63%);
  }

  /* Centered max-width frame — image is full-bleed, UI aligns to this.
     Full-height vertical rules on the left/right edges + one interior column
     line that lines up with the thumbnail/name divider in the bar. */
  .fleet__frame {
    --col1: 30.5%;                 /* thumbnail column / interior line */
    position: absolute; inset: 0; z-index: 3;
    /* Same content width as .container-x (max-width 1440 + matching padding). */
    inline-size: calc(min(100%, 1440px) - 2 * clamp(20px, 3.5vw, 50px));
    margin-inline: auto;
    border-inline: 1px solid rgba(255, 255, 255, 0.15);
    pointer-events: none;
  }
  .fleet__frame::before {
    content: ''; position: absolute; inset-block: 0;
    inset-inline-start: var(--col1);
    inline-size: 1px; background: rgba(255, 255, 255, 0.15);
    pointer-events: none;
  }
  .fleet__frame > * { pointer-events: auto; }

  /* Class tabs — top-right of the frame */
  .fleet__tabs {
    position: absolute;
    top: clamp(1.5rem, 3vw, 2.6rem); right: 0;
    display: flex; gap: 0.7rem;
    max-inline-size: 100%; overflow-x: auto;
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .fleet__tabs::-webkit-scrollbar { display: none; }
  .fleet__tab {
    flex: none;
    padding: 0.75rem 1.5rem; border-radius: 999px; border: 0; cursor: pointer;
    background: rgba(20, 20, 20, 0.42);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    color: #fff; font-family: var(--font-body); font-weight: 500; font-size: 0.95rem;
    transition: background 0.3s ease;
  }
  .fleet__tab:hover { background: rgba(20, 20, 20, 0.62); }
  .fleet__tab.is-active { background: var(--color-terracotta); color: var(--color-ink); }

  /* Prev / next arrows — centered on the frame's side edges */
  .fleet__arrow {
    position: absolute; top: 45%;
    inline-size: 60px; block-size: 60px; border-radius: 999px;
    display: grid; place-items: center; cursor: pointer;
    background: rgba(255, 255, 255, 0.20);
    backdrop-filter: blur(2.5px); -webkit-backdrop-filter: blur(2.5px);
    border: 1px solid rgba(255, 255, 255, 0.08); color: #fff;
    transition: background 0.3s ease;
  }
  .fleet__arrow:hover { background: rgba(255, 255, 255, 0.32); }
  .fleet__arrow svg { inline-size: 22px; block-size: 22px; }
  .fleet__arrow--prev { left: 0; transform: translate(-50%, -50%); }
  .fleet__arrow--next { right: 0; transform: translate(50%, -50%); }

  /* Info bar — sits in the lower third, top + bottom rules, thumbnail fills
     the first column so its right edge meets the interior line. */
  .fleet__bar {
    position: absolute; inset-inline: 0;
    inset-block-end: clamp(3rem, 15vh, 11rem);
    block-size: 200px;
    display: flex; align-items: stretch;
    border-block: 1px solid rgba(255, 255, 255, 0.18);
  }
  .fleet__thumb {
    position: relative; flex: none; align-self: stretch;
    inline-size: var(--col1);
    overflow: hidden;
  }
  .fleet__thumb-img { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; opacity: 0; transition: opacity 0.5s ease; }
  .fleet__thumb-img.is-active { opacity: 1; }
  .fleet__play {
    position: absolute; inset: 0; margin: auto;
    inline-size: 52px; block-size: 52px; border-radius: 999px; border: 0; cursor: pointer;
    display: grid; place-items: center;
    background: rgba(255, 255, 255, 0.92); color: var(--color-ink);
    transition: transform 0.25s ease, background 0.3s ease;
  }
  .fleet__play:hover { transform: scale(1.08); background: #fff; }
  .fleet__play svg { inline-size: 22px; block-size: 22px; margin-inline-start: 2px; }

  .fleet__meta {
    flex: 1 1 auto;
    display: flex; flex-direction: column; justify-content: center;
    padding-inline-start: clamp(1.6rem, 3vw, 2.8rem);
  }
  .fleet__name { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.6rem, 2.6vw, 2.4rem); line-height: 1.1; color: #fff; }
  .fleet__tier { margin: 0.55rem 0 0; font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255, 255, 255, 0.7); }
  .fleet__view {
    align-self: flex-start; margin-block-start: 1rem;
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.55rem 1.1rem; border-radius: 999px;
    background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    color: #fff; font-size: 0.85rem; font-weight: 500; text-decoration: none;
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.25s ease;
  }
  .fleet__view:hover { background: var(--color-terracotta); border-color: var(--color-terracotta); transform: translateY(-1px); }
  .fleet__view svg { inline-size: 15px; block-size: 15px; transition: transform 0.3s ease; }
  .fleet__view:hover svg { transform: translateX(2px); }

  .fleet__specs { display: flex; margin: 0; }
  .fleet__specs > div {
    position: relative;
    display: flex; flex-direction: column; justify-content: center;
    padding-inline: clamp(1.8rem, 3.5vw, 3.5rem);
  }
  /* short, vertically-centered divider — not full bar height */
  .fleet__specs > div::before {
    content: ''; position: absolute; inset-inline-start: 0; top: 50%;
    transform: translateY(-50%);
    inline-size: 1px; block-size: 58px;
    background: rgba(255, 255, 255, 0.3);
  }
  .fleet__specs dt { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.3rem, 2vw, 1.85rem); color: #fff; white-space: nowrap; }
  .fleet__specs dd { margin: 0.4rem 0 0; font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255, 255, 255, 0.6); }

  /* ===== Lightbox gallery ===== */
  .fleet__lb {
    position: fixed; inset: 0; z-index: 300;
    display: flex; flex-direction: column; gap: clamp(1rem, 3vh, 2rem);
    padding: clamp(1.25rem, 4vw, 3rem);
    background: rgba(6, 4, 2, 0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    opacity: 0; visibility: hidden; transition: opacity 0.4s ease, visibility 0s linear 0.4s;
  }
  .fleet__lb[aria-hidden='false'] { opacity: 1; visibility: visible; transition: opacity 0.4s ease; }
  .fleet__lb-x {
    position: absolute; inset: clamp(1rem, 3vw, 2rem) clamp(1rem, 3vw, 2rem) auto auto;
    inline-size: 48px; block-size: 48px; border-radius: 999px; z-index: 2;
    background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.2); color: #fff;
    display: grid; place-items: center; cursor: pointer; transition: background 0.3s ease;
  }
  .fleet__lb-x:hover { background: rgba(255, 255, 255, 0.18); }
  .fleet__lb-x svg { inline-size: 22px; block-size: 22px; }
  .fleet__lb-inner { flex: 1; min-block-size: 0; display: flex; align-items: center; gap: clamp(0.5rem, 2vw, 1.5rem); }
  .fleet__lb-stage { flex: 1; min-inline-size: 0; block-size: 100%; margin: 0; display: grid; place-items: center; }
  .fleet__lb-stage img {
    max-inline-size: 100%; max-block-size: 100%; inline-size: auto; block-size: auto;
    border-radius: 14px; object-fit: contain; box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8);
    animation: lb-in 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes lb-in { from { opacity: 0; transform: scale(0.98); } to { opacity: 1; transform: none; } }
  .fleet__lb-nav {
    flex: none; inline-size: 52px; block-size: 52px; border-radius: 999px;
    background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.2); color: #fff;
    display: grid; place-items: center; cursor: pointer; transition: background 0.3s ease, transform 0.25s ease;
  }
  .fleet__lb-nav:hover { background: rgba(255, 255, 255, 0.18); transform: scale(1.05); }
  .fleet__lb-nav svg { inline-size: 22px; block-size: 22px; }
  .fleet__lb-foot { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .fleet__lb-meta { display: flex; align-items: baseline; gap: 16px; color: #fff; }
  .fleet__lb-name { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.1rem, 2vw, 1.5rem); }
  .fleet__lb-count { font-family: var(--font-oswald); font-size: 15px; color: rgba(255, 255, 255, 0.6); }
  .fleet__lb-view {
    display: inline-flex; align-items: center; gap: 10px; padding: 13px 26px; border-radius: 999px;
    background: linear-gradient(90deg, #c46a2d, #e9b79a); color: #1a0e04; font-weight: 500; font-size: 15px;
    text-decoration: none; transition: filter 0.3s ease, transform 0.25s ease;
  }
  .fleet__lb-view:hover { filter: brightness(1.05); transform: translateY(-2px); }
  .fleet__lb-view svg { inline-size: 17px; block-size: 17px; }
  /* Below this width the flex bar gets cramped — switch to a clean stacked grid. */
  @media (max-width: 1024px) {
    .fleet__frame { border-inline: 0; }
    .fleet__frame::before { display: none; }
    .fleet__tabs { top: clamp(4.5rem, 11vw, 6rem); }
    /* Smaller arrows tucked inside the frame (were half-off the edges). */
    .fleet__arrow { inline-size: 42px; block-size: 42px; }
    .fleet__arrow svg { inline-size: 17px; block-size: 17px; }
    .fleet__arrow--prev { left: 12px; transform: translate(0, -50%); }
    .fleet__arrow--next { right: 12px; transform: translate(0, -50%); }
    /* Grid: name/tier/button on its own row, then thumbnail + specs side by side. */
    .fleet__bar {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas: "meta meta" "thumb specs";
      column-gap: 1.4rem; row-gap: clamp(2rem, 5vw, 3rem);
      align-items: center; block-size: auto;
      border-block: 0; padding-block: 0;
      inset-block-end: clamp(2rem, 8vh, 5rem);
    }
    .fleet__meta { grid-area: meta; padding-inline-start: 0; }
    .fleet__name { white-space: nowrap; }
    .fleet__specs { grid-area: specs; align-self: center; gap: 0; }
    /* Explicit box so the thumbnail doesn't collapse to a strip. */
    .fleet__thumb { grid-area: thumb; inline-size: 168px; block-size: 108px; align-self: center; border-radius: 0; }
    .fleet__play { inline-size: 44px; block-size: 44px; }
    .fleet__play svg { inline-size: 18px; block-size: 18px; }
    .fleet__specs > div { padding-inline: clamp(0.85rem, 3.5vw, 1.4rem); }
    .fleet__specs > div:first-child { padding-inline-start: 0; }
    .fleet__specs > div:first-child::before { display: none; }
    .fleet__specs dd { font-size: 0.68rem; }
  }

  @media (max-width: 640px) {
    .fleet__name { white-space: normal; }
    .fleet__lb-nav { inline-size: 42px; block-size: 42px; }
    .fleet__lb-view { padding: 11px 20px; font-size: 14px; }
  }
</style>

<script>
  // Fahrzeuge showcase — tabs + arrows switch the active vehicle.
  const fleet = document.querySelector('[data-fleet]');
  if (fleet) {
    const slides = [...fleet.querySelectorAll('.fleet__img')];
    const thumbs = [...fleet.querySelectorAll('.fleet__thumb-img')];
    const tabs = [...fleet.querySelectorAll('.fleet__tab')];
    // Scope target elements to the info bar — the tabs also carry these
    // data-* attributes (as the source), so an unscoped query would hit them.
    const bar = fleet.querySelector('.fleet__bar');
    const nameEl = bar.querySelector('[data-name]');
    const tierEl = bar.querySelector('[data-tier]');
    const paxEl = bar.querySelector('[data-pax]');
    const bagsEl = bar.querySelector('[data-bags]');
    const viewEl = bar.querySelector<HTMLAnchorElement>('[data-view]');
    const viewBase = (fleet as HTMLElement).dataset.viewBase || '/fahrzeuge/';
    const n = tabs.length;
    let current = 0;

    const setActive = (i) => {
      current = ((i % n) + n) % n;
      slides.forEach((s, idx) => s.classList.toggle('is-active', idx === current));
      thumbs.forEach((s, idx) => s.classList.toggle('is-active', idx === current));
      tabs.forEach((t, idx) => {
        const on = idx === current;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', String(on));
      });
      const t = tabs[current];
      if (nameEl) nameEl.textContent = t.dataset.name;
      if (tierEl) tierEl.textContent = t.dataset.tier;
      if (paxEl) paxEl.textContent = 'Max. ' + t.dataset.pax;
      if (bagsEl) bagsEl.textContent = 'Max. ' + t.dataset.bags;
      if (viewEl && t.dataset.slug) viewEl.href = viewBase + t.dataset.slug;
    };

    tabs.forEach((t, i) => t.addEventListener('click', () => setActive(i)));
    fleet.querySelector('[data-prev]')?.addEventListener('click', () => setActive(current - 1));
    fleet.querySelector('[data-next]')?.addEventListener('click', () => setActive(current + 1));

    // Lightbox gallery — opens on the play button with the active vehicle's images.
    const galleries = JSON.parse(document.querySelector('[data-fleet-galleries]')?.textContent || '[]');
    const lb = document.querySelector<HTMLElement>('[data-lb]');
    if (lb) {
      const lbImg = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
      const lbName = lb.querySelector('[data-lb-name]')!;
      const lbCount = lb.querySelector('[data-lb-count]')!;
      const lbView = lb.querySelector<HTMLAnchorElement>('[data-lb-view]')!;
      let g: string[] = [], gi = 0;
      const renderLb = () => {
        if (!g.length) return;
        gi = ((gi % g.length) + g.length) % g.length;
        lbImg.src = g[gi];
        lbCount.textContent = gi + 1 + ' / ' + g.length;
      };
      const openLb = (idx: number) => {
        const v = galleries[idx];
        if (!v) return;
        g = v.gallery || []; gi = 0;
        lbName.textContent = v.name;
        lbImg.alt = v.name;
        lbView.href = viewBase + v.slug;
        renderLb();
        lb.setAttribute('aria-hidden', 'false');
        document.body.classList.add('is-nav-open');
      };
      const closeLb = () => { lb.setAttribute('aria-hidden', 'true'); document.body.classList.remove('is-nav-open'); };
      fleet.querySelector('[data-play]')?.addEventListener('click', () => openLb(current));
      lb.querySelector('[data-lb-prev]')?.addEventListener('click', () => { gi -= 1; renderLb(); });
      lb.querySelector('[data-lb-next]')?.addEventListener('click', () => { gi += 1; renderLb(); });
      lb.querySelector('[data-lb-close]')?.addEventListener('click', closeLb);
      lb.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });
      document.addEventListener('keydown', (e) => {
        if (lb.getAttribute('aria-hidden') !== 'false') return;
        if (e.key === 'Escape') closeLb();
        else if (e.key === 'ArrowLeft') { gi -= 1; renderLb(); }
        else if (e.key === 'ArrowRight') { gi += 1; renderLb(); }
      });
    }
  }

</script>
