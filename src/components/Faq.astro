---
import { CONTACT } from '../lib/site';
import { getLang, t, hrefFor, pick } from '../lib/i18n';
interface Props {
  faqs: { q: string; a: string }[];
  num?: string;
  heading?: string;
  ctaHref?: string;
}
const lang = getLang(Astro.url);
const fq = t(lang).faq;
const { faqs, num = '04', heading = pick(lang, 'Häufige Fragen zum Transfer.', 'Frequently asked questions.'), ctaHref = hrefFor('/kontakt', lang) } = Astro.props;
const phoneHref = `tel:${CONTACT.phonePrimary.tel}`;

// FAQPage-Schema aus denselben Daten, die der Akkordeon-Block rendert.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
<section class="faq" id="faq" aria-label={fq.aria}>
  <div class="container-x faq__grid">
    <div class="faq__intro" data-reveal>
      <div class="faq__eyebrow">
        <span class="faq__eyebrow-line" aria-hidden="true"></span>
        <span>faq</span>
      </div>
      <h2 class="faq__title">{heading}</h2>
      <div class="faq__actions">
        <a class="faq__cta" href={ctaHref}>{fq.cta} <span aria-hidden="true">→</span></a>
        <a class="faq__phone" href={phoneHref}>{CONTACT.phonePrimary.display}</a>
      </div>
    </div>

    <div class="faq__list" data-reveal style="--reveal-delay:0.08s">
      {faqs.map((f, i) => (
        <div class:list={['faq__item', i === 0 && 'is-open']} data-faq>
          <button class="faq__q" type="button" aria-expanded={i === 0 ? 'true' : 'false'} data-faq-btn>
            <span class="faq__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="faq__question">{f.q}</span>
            <span class="faq__toggle" aria-hidden="true">
              <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 1.5v11M1.5 7h11"/></svg>
            </span>
          </button>
          <div class="faq__a" data-faq-panel>
            <div class="faq__a-inner"><p>{f.a}</p></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Figma 151:2240 / 151:2918 */
  .faq { background: #0d0703; color: #fff; padding-block: var(--section-py); margin-block-start: -1px; }
  .faq__grid { display: flex; gap: clamp(2.5rem, 4vw, 51px); align-items: flex-start; }
  .faq__intro { flex: 1 1 0; min-inline-size: 0; display: flex; flex-direction: column; gap: clamp(2rem, 3vw, 51px); }
  .faq__eyebrow { display: flex; align-items: center; gap: 15px; }
  .faq__eyebrow span:not(.faq__eyebrow-line) {
    font-family: var(--font-display); font-weight: 600; font-size: 24px;
    letter-spacing: -1px; text-transform: uppercase; color: #c46a2d;
  }
  .faq__eyebrow-line { inline-size: 60px; block-size: 1.429px; background: #c46a2d; opacity: 0.6; flex: none; }
  .faq__title {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(2.6rem, 5.2vw, 4.7rem); line-height: 0.98; letter-spacing: -0.034em;
    color: #fff; max-inline-size: 12ch;
  }
  .faq__actions { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; }
  .faq__cta {
    display: inline-flex; align-items: center; gap: 12px; padding: 16px 36px;
    border-radius: 999px; background: linear-gradient(100.08deg, #c46a2d 0%, #eac1a9 100%);
    box-shadow: 0 12px 32px -12px rgba(196, 106, 45, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.25);
    color: #1a0e04; font-weight: 600; font-size: 16px; letter-spacing: 0.155px; text-decoration: none;
    transition: filter 0.3s ease, transform 0.25s ease;
  }
  .faq__cta:hover { filter: brightness(1.04); transform: translateY(-2px); }
  .faq__phone {
    display: inline-flex; align-items: center; gap: 10px; padding: 16px 26px;
    border-radius: 999px; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.14);
    color: #fff; font-weight: 500; font-size: 16px; letter-spacing: 0.155px; text-decoration: none;
    transition: background 0.3s ease;
  }
  .faq__phone:hover { background: rgba(255, 255, 255, 0.08); }

  .faq__list { flex: 1 1 0; min-inline-size: 0; max-inline-size: 700px; border-block-start: 1px solid rgba(255, 255, 255, 0.14); }
  .faq__item { border-block-end: 1px solid rgba(255, 255, 255, 0.14); }
  .faq__q {
    display: grid; grid-template-columns: 56px minmax(0, 1fr) 40px; gap: 16px; align-items: center;
    inline-size: 100%; background: none; border: 0; cursor: pointer; padding-block: 26px; text-align: left; color: #fff;
  }
  .faq__num { font-family: var(--font-display); font-weight: 600; font-size: 14px; color: #c46a2d; align-self: center; }
  .faq__question { font-family: var(--font-display); font-weight: 600; font-size: 21px; letter-spacing: -0.315px; line-height: 1.4; color: #fff; }
  .faq__toggle {
    inline-size: 40px; block-size: 40px; border-radius: 20px; flex: none;
    border: 1px solid rgba(255, 255, 255, 0.14); display: grid; place-items: center; color: #c46a2d;
    transition: background 0.35s ease, border-color 0.35s ease, color 0.35s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .faq__toggle svg { inline-size: 14px; block-size: 14px; }
  .faq__item.is-open .faq__toggle { background: #c46a2d; border-color: #c46a2d; color: #fff; transform: rotate(45deg); }
  .faq__a { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
  .faq__item.is-open .faq__a { grid-template-rows: 1fr; }
  .faq__a-inner { overflow: hidden; }
  .faq__a-inner p { margin: 0; padding: 0 44px 30px 72px; max-inline-size: 646px; font-size: 16px; line-height: 1.8; color: rgba(255, 255, 255, 0.72); }

  /* Tablet: stack the intro (eyebrow, heading, buttons) over a full-width list. */
  @media (max-width: 1024px) {
    .faq__grid { flex-direction: column; gap: clamp(2rem, 4vw, 2.75rem); }
    .faq__intro { gap: clamp(1.25rem, 2.5vw, 1.75rem); }
    .faq__title { font-size: clamp(2rem, 4.4vw, 3rem); max-inline-size: 22ch; }
    .faq__list { max-inline-size: none; }
  }
  @media (max-width: 640px) {
    .faq__eyebrow { gap: 10px; }
    .faq__eyebrow span:not(.faq__eyebrow-line) { font-size: 1.05rem; letter-spacing: -0.5px; }
    .faq__eyebrow-line { inline-size: 42px; }
    .faq__title { font-size: 2rem; }
    /* Match hero button size (page-wide consistency). */
    .faq__cta, .faq__phone { padding: 0.85rem 1.4rem; font-size: 0.9rem; line-height: 1; }
  }
  @media (max-width: 560px) {
    .faq__q { grid-template-columns: 30px minmax(0, 1fr) 36px; gap: 10px; }
    .faq__question { font-size: 18px; }
    .faq__a-inner p { padding: 0 0 26px 40px; }
  }
</style>

<script>
  // Single-open accordion, first item expanded by default.
  const faqItems = [...document.querySelectorAll<HTMLElement>('[data-faq]')];
  faqItems.forEach((item) => {
    const btn = item.querySelector<HTMLButtonElement>('[data-faq-btn]');
    btn?.addEventListener('click', () => {
      const willOpen = !item.classList.contains('is-open');
      faqItems.forEach((other) => {
        other.classList.toggle('is-open', other === item && willOpen);
        other.querySelector('[data-faq-btn]')?.setAttribute('aria-expanded', String(other === item && willOpen));
      });
    });
  });
</script>
