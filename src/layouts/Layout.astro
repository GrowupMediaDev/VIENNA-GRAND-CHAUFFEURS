---
import '../styles/global.css';
import { getLang, htmlLang, pick } from '../lib/i18n';
import { localizePath } from '../lib/routes';
import { OG_IMAGE } from '../lib/site';
import ContactRail from '../components/ContactRail.astro';

interface Props {
  title?: string;
  description?: string;
  /** Overrides the self-referencing canonical, e.g. to point a page at the homepage. */
  canonical?: string;
  /** Keeps the page out of the index: no canonical, no hreflang, robots noindex. */
  noindex?: boolean;
  /**
   * Share image, site-root path. Must be one of the 1200x630 crops under
   * /images/og/ (see scripts/make-og-images.mjs) — og:image:width/height below
   * are stated as fact, so an arbitrary image would make them a lie.
   */
  image?: string;
  /** Describes the share image itself, not the page. */
  imageAlt?: string;
}

const {
  title = 'Vienna Grand Chauffeurs — Chauffeurservice der Extraklasse',
  description = 'Premium Chauffeurservice in Wien: erfahrene, diskrete Chauffeure, gepflegte Mercedes-Benz Oberklasse und transparente Fixpreise. Flughafentransfer, Business- und Langstreckenfahrten.',
  canonical: canonicalOverride,
  noindex = false,
  image = OG_IMAGE.src,
  imageAlt,
} = Astro.props;

const lang = getLang(Astro.url);
const canonical = noindex ? null : new URL(canonicalOverride ?? Astro.url.pathname, Astro.site).href;

// Facebook and LinkedIn drop a relative og:image without a word of complaint,
// so this has to be absolute.
const ogImage = new URL(image, Astro.site).href;
const ogImageAlt = imageAlt ?? pick(lang,
  'Vienna Grand Chauffeurs — Mercedes-Benz Limousine mit Chauffeur in Wien',
  'Vienna Grand Chauffeurs — Mercedes-Benz limousine with chauffeur in Vienna');

// hreflang: DE lives at the root, EN under /en/ with its own segments and
// slugs, so the counterpart is resolved through the route mapping. x-default
// points at the German version. Pages that canonicalise elsewhere are not the
// canonical of their language pair, so they stay out of the annotation.
const dePath = localizePath(Astro.url.pathname, 'de');
const enPath = localizePath(Astro.url.pathname, 'en');
const alternates = canonicalOverride || noindex
  ? []
  : [
      { hreflang: 'de-AT', href: new URL(dePath, Astro.site).href },
      { hreflang: 'en', href: new URL(enPath, Astro.site).href },
      { hreflang: 'x-default', href: new URL(dePath, Astro.site).href },
    ];

// Cookie-consent banner: legal links resolved for THIS page's language, so the
// panel points a DE visitor at /datenschutz/ and an EN visitor at /en/datenschutz/.
const consentPrivacyHref = localizePath('/datenschutz/', lang);
const consentImprintHref = localizePath('/impressum/', lang);
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <!-- Consent Mode v2 default — MUST run before the GTM container and the
         direct gtag.js below, so every Google tag reads a denied-by-default
         signal on its very first ping. The banner (/cookie-banner/banner.js)
         later flips this to granted after consent. Advanced mode: a visitor who
         rejects still produces anonymous, cookieless, modelled signals rather
         than a hard request block. The existing GTM + gtag.js loads are left
         exactly as they were — only gated by this preceding default. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        analytics_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500
      });
    </script>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-PQGDF9SF');</script>
    <!-- End Google Tag Manager -->
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-320BN5MD26"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-320BN5MD26');
    </script>
    <!-- End Google tag (gtag.js) -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vienna Grand Chauffeurs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'de_AT'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <slot name="head" />
    <noscript><style>[data-reveal]{opacity:1 !important;transform:none !important}.pxn{display:none !important}</style></noscript>

    <!--
      Cookie-consent banner (UI + Consent Mode v2 update). Config is set here,
      the engine at /cookie-banner/banner.js reads it. The engine NEVER loads or
      alters a Google tag — the GTM container and gtag.js above stay untouched;
      it only renders the decision panel and calls gtag('consent','update',...).
      Service list below reflects the site's actually-active services (verified
      live 14.09.2026): Google Analytics 4 (G-320BN5MD26), Google Ads incl.
      Enhanced Conversions (AW-18353636941) via GTM, Cloudflare (bot/e-mail
      protection) and — inside the booking tool only — Google Maps Places.
      Fonts are self-hosted, so no Google Fonts transfer is claimed.
      Legal wording localised to Austria (DSGVO + § 165 TKG 2021); not reviewed
      by a lawyer.
    -->
    <script is:inline define:vars={{ consentPrivacyHref, consentImprintHref }}>
      window.__vgcConsentConfig = {
        companyName: 'Vienna Grand Chauffeurs',
        markUrl: '/images/logo-footer.svg',
        consentStorageKey: 'vgc_cookie_consent_v1',
        consentTtlDays: 180,
        bannerVersion: '1.0.0',
        colors: {
          barTop: '#c0692c',
          barBottom: '#a4521f',
          panelTop: '#9a4c1c',
          panelBottom: '#7d3d15',
          cream: '#f7f2ec',
          creamMuted: 'rgba(247,242,236,0.82)',
          espresso: '#1a120b',
          hairline: 'rgba(247,242,236,0.20)',
          inkOnCream: '#3a1e0c'
        },
        language: { default: 'de', available: ['de', 'en'], siteLocales: ['de', 'en'] },
        legalLinks: { privacy: consentPrivacyHref, imprint: consentImprintHref },
        text: {
          de: {
            title: 'Privatsphäre-Einstellungen',
            intro: 'Wir verwenden Cookies, um diese Website bereitzustellen, ihre Nutzung anonym zu messen und Ihnen relevante Werbung zu zeigen. Ihre Einwilligung ist freiwillig und jederzeit über „Cookie-Einstellungen“ im Footer widerrufbar.',
            categories: {
              necessary: {
                label: 'Notwendig',
                description: 'Unbedingt erforderlich für den technischen Betrieb und nicht abwählbar. Dazu zählen das Speichern Ihrer Cookie-Auswahl (bis zu 180 Tage), der Spam- und Missbrauchsschutz sowie die E-Mail-Verschleierung über Cloudflare und, nur im Online-Buchungstool, Google Maps (Places) für die Adresseingabe. Die Schriftarten dieser Seite liegen auf unserem eigenen Server (kein Google-Fonts-Abruf). Es werden keine Nutzerprofile für Werbe- oder Analysezwecke gebildet. Rechtsgrundlage: berechtigtes Interesse an einer funktionsfähigen Website (Art. 6 Abs. 1 lit. f DSGVO) bzw. § 165 Abs. 3 TKG 2021 für zwingend erforderliche Speicherungen.'
              },
              statistics: {
                label: 'Statistik',
                description: 'Hilft uns zu verstehen, wie Besucher die Website nutzen (aufgerufene Seiten, Verweildauer, Klick- und Scrollverhalten), um unser Angebot zu verbessern. Eingesetzt wird Google Analytics 4 (Google Ireland Limited, Dublin; Verarbeitung teils durch Google LLC, USA), Kennung G-320BN5MD26. Verarbeitet werden u. a. gekürzte IP-Adresse, Geräte- und Browserdaten, Interaktionsdaten und eine Cookie-Kennung (_ga). Bei Ablehnung liefert Google Analytics nur anonyme, modellierte Messwerte ohne Cookies. Rechtsgrundlage: Ihre Einwilligung (Art. 6 Abs. 1 lit. a DSGVO, § 165 Abs. 3 TKG 2021); USA-Übermittlung nach Art. 49 Abs. 1 lit. a DSGVO.'
              },
              marketing: {
                label: 'Marketing',
                description: 'Misst die Wirksamkeit unserer Werbung und ermöglicht relevante Anzeigen: Google Ads Conversion-Tracking und erweiterte Conversions (Enhanced Conversions), bereitgestellt über Google Tag Manager (Google Ireland Limited, Dublin; Verarbeitung teils durch Google LLC, USA), Conversion-Kennung AW-18353636941. Bei erweiterten Conversions werden Name, E-Mail und Telefonnummer aus abgesendeten Formularen bereits in Ihrem Browser verschlüsselt (gehasht) und nur zum Abgleich mit einer vorherigen Werbeinteraktion genutzt. Verarbeitet werden Klick-/Cookie-Kennung (_gcl_au), gehashte Kontaktdaten (nur bei Formularabsendung), IP-Adresse und Interaktionsdaten. Bei Ablehnung erhält Google Ads nur anonyme, cookielose Signale. Rechtsgrundlage: Ihre Einwilligung (Art. 6 Abs. 1 lit. a DSGVO, § 165 Abs. 3 TKG 2021); USA-Übermittlung nach Art. 49 Abs. 1 lit. a DSGVO.'
              }
            },
            buttons: { acceptAll: 'Alle akzeptieren', reject: 'Ablehnen', customize: 'Einstellungen', save: 'Auswahl speichern', back: 'Zurück' },
            footer: { privacy: 'Datenschutz', imprint: 'Impressum' }
          },
          en: {
            title: 'Privacy Settings',
            intro: 'We use cookies to provide this website, measure its use anonymously and show you relevant advertising. Consent is voluntary and can be withdrawn at any time via “Cookie settings” in the footer.',
            categories: {
              necessary: {
                label: 'Necessary',
                description: 'Strictly required for the technical operation of the site and cannot be switched off. This includes storing your cookie choice (up to 180 days), spam and abuse protection and e-mail obfuscation via Cloudflare, and — inside the online booking tool only — Google Maps (Places) for address entry. This site’s fonts are served from our own server (no Google Fonts request). No profiles are built for advertising or analytics. Legal basis: legitimate interest in a functioning website (Art. 6(1)(f) GDPR) and, for strictly necessary storage, Section 165(3) of the Austrian Telecommunications Act 2021.'
              },
              statistics: {
                label: 'Statistics',
                description: 'Helps us understand how visitors use the website (pages viewed, time on page, click and scroll behaviour) so we can improve it. We use Google Analytics 4 (Google Ireland Limited, Dublin; processing partly by Google LLC, USA), ID G-320BN5MD26. Data processed includes a truncated IP address, device and browser data, interaction data and a cookie ID (_ga). If declined, Google Analytics receives only anonymous, modelled measurements without cookies. Legal basis: your consent (Art. 6(1)(a) GDPR, Section 165(3) TKG 2021); US transfer under Art. 49(1)(a) GDPR.'
              },
              marketing: {
                label: 'Marketing',
                description: 'Measures the effectiveness of our advertising and enables relevant ads: Google Ads conversion tracking and Enhanced Conversions, delivered via Google Tag Manager (Google Ireland Limited, Dublin; processing partly by Google LLC, USA), conversion ID AW-18353636941. With Enhanced Conversions your name, e-mail and phone number from submitted forms are hashed in your browser before transmission and used only to match a prior ad interaction. Data processed: click/cookie ID (_gcl_au), hashed contact data (only on form submission), IP address and interaction data. If declined, Google Ads receives only anonymous, cookieless signals. Legal basis: your consent (Art. 6(1)(a) GDPR, Section 165(3) TKG 2021); US transfer under Art. 49(1)(a) GDPR.'
              }
            },
            buttons: { acceptAll: 'Accept all', reject: 'Reject', customize: 'Settings', save: 'Save selection', back: 'Back' },
            footer: { privacy: 'Privacy', imprint: 'Imprint' }
          }
        }
      };
    </script>
    <script is:inline src="/cookie-banner/banner.js"></script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PQGDF9SF"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <!-- Preloader (first visit) + page-transition curtain (on navigation). -->
    <div class="pxn" data-pxn aria-hidden="true">
      <div class="pxn__inner">
        <img class="pxn__logo" src="/images/logo-stacked-white.png" alt="" width="852" height="750" />
        <span class="pxn__bar" aria-hidden="true"><i></i></span>
      </div>
    </div>
    <style is:global>
      .pxn {
        position: fixed; inset: 0; z-index: 9999;
        background: #0d0703; color: #fff;
        display: grid; place-items: center;
        transform: translateY(0);
        transition: transform 0.72s cubic-bezier(0.76, 0, 0.24, 1);
        will-change: transform;
      }
      .pxn.is-revealed { transform: translateY(-100%); }
      .pxn.is-covering { transition-duration: 0.46s; }
      .pxn__inner { display: flex; flex-direction: column; align-items: center; gap: 26px; }
      .pxn__logo {
        inline-size: clamp(84px, 11vw, 120px); block-size: auto;
        opacity: 0; transform: translateY(10px) scale(0.96);
        animation: pxn-logo 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
      }
      .pxn__bar { position: relative; inline-size: 150px; block-size: 2px; background: rgba(255, 255, 255, 0.13); border-radius: 2px; overflow: hidden; }
      .pxn__bar i { position: absolute; inset-block: 0; inset-inline-start: 0; inline-size: 0; background: linear-gradient(90deg, #c46a2d, #e9b79a); animation: pxn-bar 1.05s ease-out 0.15s forwards; }
      @keyframes pxn-logo { to { opacity: 1; transform: none; } }
      @keyframes pxn-bar { to { inline-size: 100%; } }
      @media (prefers-reduced-motion: reduce) { .pxn { display: none; } }
    </style>
    <slot />
    <ContactRail />
    <script>
      // Scroll-reveal, shared across all pages.
      const els = document.querySelectorAll('[data-reveal]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver((entries, obs) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); obs.unobserve(e.target); } });
        }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
        els.forEach((el) => io.observe(el));
      }
    </script>
    <script>
      // Preloader + curtain page transition.
      const pxn = document.querySelector('[data-pxn]');
      const softMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (pxn && !softMotion) {
        const first = !sessionStorage.getItem('vgc-in');
        sessionStorage.setItem('vgc-in', '1');
        let done = false;
        const reveal = () => { if (!done) { done = true; pxn.classList.add('is-revealed'); } };

        // Reveal after content is ready — min dwell on first visit, snappy after.
        const minDwell = first ? 1100 : 300;
        const cap = first ? 2600 : 1300;
        const t0 = Date.now();
        const finish = () => {
          const el = Date.now() - t0;
          if (el >= minDwell) reveal(); else setTimeout(reveal, minDwell - el);
        };
        if (document.readyState === 'complete') finish();
        else window.addEventListener('load', finish);
        setTimeout(reveal, cap);

        // Cover the screen before an internal navigation, then go.
        document.addEventListener('click', (e) => {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const a = e.target.closest && e.target.closest('a');
          if (!a) return;
          const href = a.getAttribute('href');
          if (!href || a.target === '_blank' || a.hasAttribute('download')) return;
          if (href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:') || /^https?:\/\//.test(href)) return;
          if (href === location.pathname || href === location.pathname + location.search) return;
          e.preventDefault();
          pxn.classList.add('is-covering');
          pxn.classList.remove('is-revealed');
          setTimeout(() => { location.href = href; }, 470);
        });

        // Returning via the back/forward cache: don't leave the curtain down.
        window.addEventListener('pageshow', (e) => { if (e.persisted) { done = true; pxn.classList.add('is-revealed'); } });
      }
    </script>
  </body>
</html>
