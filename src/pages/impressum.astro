---
import LegalLayout from '../layouts/LegalLayout.astro';
import { CONTACT } from '../lib/site';
---
<LegalLayout
  title="Impressum"
  metaTitle="Impressum — Vienna Grand Chauffeurs"
  description="Impressum und Offenlegung von Vienna Grand Chauffeurs — VT-Limousinen Service GmbH, Wien."
  eyebrow="Rechtliches"
>
  <p class="legal__note">
    <strong>Hinweis:</strong> Straße/PLZ sowie E-Mail und Telefon sind noch Platzhalter und werden mit
    den offiziellen Kontaktdaten der VT-Limousinen Service GmbH ergänzt.
  </p>

  <h2>Angaben gemäß § 5 TMG</h2>
  <p>
    <strong>VT-Limousinen Service GmbH</strong><br />
    [Straße und Hausnummer]<br />
    [PLZ] Wien, Österreich
  </p>

  <h2>Kontakt</h2>
  <p>
    E-Mail: <a href={CONTACT.email.mailto}>{CONTACT.email.display}</a><br />
    Telefon: <a href={`tel:${CONTACT.phone.tel}`}>{CONTACT.phone.display}</a>
  </p>

  <h2>Unternehmensdaten</h2>
  <p>
    Firmenbuchnummer: FN 421497 z<br />
    UID-Nummer: ATU 69478479<br />
    Firmenbuchgericht: Handelsgericht Wien
  </p>

  <h2>Bankverbindung</h2>
  <p>
    Bank Austria · BLZ 12000<br />
    Konto-Nr.: 10011423299<br />
    IBAN: AT34 1200 0100 1142 3299<br />
    SWIFT/BIC: BKAUATWW
  </p>

  <h2>Design &amp; Development</h2>
  <p>GrowUp Media</p>

  <h2>Verantwortlich für den Inhalt nach § 55 Abs. 2 RStV</h2>
  <p>
    VT-Limousinen Service GmbH<br />
    [Straße und Hausnummer], [PLZ] Wien
  </p>

  <h2>Haftungsausschluss</h2>
  <p>
    Trotz sorgfältiger inhaltlicher Kontrolle übernehmen wir keine Haftung für die Inhalte externer
    Links. Für den Inhalt der verlinkten Seiten sind ausschließlich deren Betreiber verantwortlich.
  </p>

  <h2>Urheberrecht</h2>
  <p>
    Die durch den Seitenbetreiber erstellten Inhalte und Werke auf diesen Seiten unterliegen dem
    Urheberrecht. Die Vervielfältigung, Bearbeitung, Verbreitung und jede Art der Verwertung außerhalb
    der Grenzen des Urheberrechts bedürfen der schriftlichen Zustimmung des jeweiligen Autors bzw.
    Erstellers.
  </p>

  <h2>Datenschutz</h2>
  <p>
    Informationen zum Umgang mit personenbezogenen Daten finden Sie in unserer
    <a href="/datenschutz">Datenschutzerklärung</a>.
  </p>
</LegalLayout>
