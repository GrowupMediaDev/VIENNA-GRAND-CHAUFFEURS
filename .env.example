# ── Contact form (Cloudflare Pages Function + Resend + Turnstile) ──
# Public Turnstile site key — inlined into the page at BUILD time (Astro import.meta.env.PUBLIC_*).
# Safe to expose; set it as a build/runtime env var in the Cloudflare Pages project.
PUBLIC_TURNSTILE_SITE_KEY=

# Resend API key — SECRET. Set in Cloudflare Pages → Settings → Environment variables (Type: Secret).
# Never commit the real value.
RESEND_API_KEY=

# Cloudflare Turnstile secret key — SECRET. Set in Cloudflare Pages (Type: Secret).
TURNSTILE_SECRET_KEY=
